##
星艦的航行工具：遞迴、巢狀函式、閉包及高階函式。
所有自訂的變數、函式及參數名稱皆使用繁體中文。
##
變數 費氏數 = 函式(序號) {
    如果 (序號 <= 1) {
        回傳 序號;
    }
    回傳 費氏數(序號 - 1) + 費氏數(序號 - 2);
};

# 回傳的函式記住能量；每次呼叫都會修改同一個外層變數。
變數 建立能量槽 = 函式(初始能量) {
    變數 剩餘能量 = 初始能量;
    回傳 函式(消耗) {
        剩餘能量 -= 消耗;
        回傳 剩餘能量;
    };
};

變數 建立航線 = 函式(長度上限) {
    變數 航線 = [];
    迴圈 (變數 序號 = 0; 序號 < 長度上限; ++序號) {
        航線 = 加入(航線, 費氏數(序號));
    }
    回傳 航線;
};

# 函式也是值，可以當作引數傳入另一個函式。
變數 轉換航線 = 函式(航線, 轉換) {
    變數 結果 = [];
    迴圈 (變數 索引 = 0; 索引 < 長度(航線); 索引 += 1) {
        結果 = 加入(結果, 轉換(航線[索引]));
    }
    回傳 結果;
};

變數 能量評級 = 函式(能量) {
    如果 (能量 >= 15) {
        回傳 "充足";
    } 否則如果 ((能量 > 5) && (能量 <= 14)) {
        回傳 "穩定";
    } 否則 {
        回傳 "返航";
    }
};

# 以無引數的模組呼叫取得函式，再由主程式傳入本地資料。
變數 取得航線轉換 = 函式() { 回傳 轉換航線; };
變數 取得能量評級 = 函式() { 回傳 能量評級; };
