變數 工具 = 匯入(目前工作目錄 + "/tools.aqua");
變數 數學 = import("GLM");
變數 創作 = 匯入("Processing");
變數 向量 = 創作.建立向量(3, 4);
向量.normalize();
向量.相乘(10);
變數 中文呼叫 = 工具.計數();
變數 英文呼叫 = 工具.count();
變數 成功 = 中文呼叫 == 1 && 英文呼叫 == 2
    && 工具.加法(20, 22) == 工具.add(20, 22)
    && 工具.問候() == "你好" && 工具.englishOnly() == "hello"
    && 數學.內積([1, 2, 3], [4, 5, 6]) == 數學.Dot([1, 2, 3], [4, 5, 6])
    && 向量.長度() == 10;
如果 (成功) { 印出("BILINGUAL_LIBRARY_OK"); }
成功;
