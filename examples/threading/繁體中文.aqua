# 可直接使用「執行緒」，也可以 匯入("執行緒")。
變數 工作 = 函式(資料, 轉換) {
    變數 總和 = 0;
    迴圈 (變數 索引 = 0; 索引 < 陣列.長度(資料); 索引++) {
        總和 += 轉換(資料[索引]);
    }
    回傳 總和;
};
變數 平方 = 函式(數值) { 回傳 數值 * 數值; };
變數 第一個 = 執行緒.啟動(工作, [[1, 2, 3], 平方]);
變數 第二個 = 執行緒.啟動(工作, [[4, 5, 6], 平方]);
執行緒.等待(第一個);
執行緒.等待(第二個);
變數 答案 = 執行緒.結果(第一個) + 執行緒.結果(第二個);
執行緒.關閉(第一個);
執行緒.關閉(第二個);
印出(答案); # 91
答案;
