# Shared desktop / browser / Android behavioral verification.
變數 驗證 = 函式(條件, 名稱) {
    如果 (!條件) { 印出("THREADING_FAILED", 名稱); 多執行緒驗證失敗; }
};
變數 倍數 = 2;
變數 資料 = [1];
變數 轉換 = 函式(數值) { 回傳 數值 * 倍數; };
變數 工作 = 執行緒.啟動(函式(函式參數, 陣列參數) {
    陣列參數[0] = 9;
    回傳 函式參數(21);
}, [轉換, 資料]);
倍數 = 10;
驗證(執行緒.等待(工作, 5000), "等待完成");
驗證(執行緒.是否完成(工作), "是否完成");
驗證(執行緒.結果(工作) == 42, "函式參數與捕獲快照");
驗證(資料[0] == 1, "資料隔離");
驗證(執行緒.關閉(工作), "關閉");
驗證(Thread.Close(工作), "重複關閉與英文別名");
變數 圖形工作 = Thread.Start(函式() {
    變數 a = [0]; a[0] = a;
    回傳 [a, 1.25f, "繁體中文"];
});
變數 圖形 = Thread.Result(圖形工作);
驗證(圖形[0] == 圖形[0][0], "循環參照");
驗證(圖形[1] == 1.25f && 圖形[2] == "繁體中文", "結果型別");
Thread.Close(圖形工作);
變數 等待工作 = 執行緒.啟動(函式() { 執行緒.休眠(60000); 回傳 1; });
驗證(!執行緒.等待(等待工作, 0), "立即檢查");
驗證(!執行緒.等待(等待工作, 1), "逾時保留工作");
執行緒.休眠(50);
驗證(執行緒.取消(等待工作), "要求取消");
驗證(執行緒.關閉(等待工作, 5000), "喚醒並安全關閉");
變數 迴圈工作 = Thread.Start(函式() { 迴圈 (變數 i = 0; 真; i++) {} });
Thread.Sleep(50);
驗證(Thread.Close(迴圈工作, 5000), "純迴圈可停止");
驗證(!執行緒.是否要求取消(), "主程式取消旗標");
印出("THREADING_OK");
42;
