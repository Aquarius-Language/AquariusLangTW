# Built-in core arrays: reserve capacity, mutate and copy in bulk.
var values = Array.Make(0, 0, 8);
Array.Append(values, 10);
Array.AppendArray(values, [20, 30, 40]);
print("values / length / capacity", values, Array.Len(values), Array.Cap(values));
var alias = values;
var backup = Array.Clone(values);
Array.Delete(values, 1, 3);
Array.Reverse(values);
print("alias / backup", alias, backup);
var middle = Array.Slice(backup, 1, 3);
Array.Fill(middle, 7);
var destination = Array.Make(4, 0);
var copied = Array.Copy(destination, middle, 1);
print("copied / destination / original backup", copied, destination, backup);
Array.Grow(values, 100);
print("contains 10 / index of 40", Array.Contains(values, 10), Array.Index(values, 40));
# Existing push preserves the input array.
var snapshot = push(values, 99);
Array.Append(values, 50);
print("in-place append / old snapshot", values, snapshot);
