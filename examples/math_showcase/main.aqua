# 數學展示 / Math showcase: number literals, the portable 數學 / Math module, exact %, bitwise operators, seeded
# random numbers and number text. Every line prints the same on Windows, Linux, Android and the web.

# 數字字面值：不加後綴的小數是雙精度；科學記號、十六進位、二進位與底線分隔。
印出("字面值", 1.5, 型別(1.5), 1e-9, 2.5e3f, 型別(2.5e3f), 0xFF, 0b1010, 1_000_000, 2d, 型別(2d));

# 常數與基本函式；整數維持整數，單精度維持單精度。
印出("常數", 數學.圓周率, Math.E, 數學.二倍圓周率, Math.Infinity, Math.NaN);
印出("型別保持", 數學.絕對值(-7), 型別(數學.絕對值(-7)), Math.Abs(-2.5f), 型別(Math.Abs(-2.5f)), Math.Min(3, 1.5d), Math.Clamp(15, 0, 10));

# 四捨五入：一半遠離零（2.5 → 3，-2.5 → -3）；整數版本會飽和。
印出("四捨五入", 數學.四捨五入(2.5d), Math.Round(-2.5d), Math.Round(0.49999999999999994d), 數學.四捨五入取整數(-0.5d), Math.FloorInt(-1.5d), Math.RoundInt(1e10));

# IEEE 754：沒有定義域錯誤。
印出("IEEE", Math.Log(0), Math.Sqrt(-1), Math.Pow(0, -1), Math.Exp(1000), Math.IsNaN(Math.Sqrt(-1)), Math.IsFinite(1e308 * 10));

# 三角與指數函式（musl libm，每個平台位元相同）。
印出("超越函式", 數學.正弦(1), Math.Cos(1), Math.Atan2(1, 1), 數學.次方(2, 0.5), Math.Cbrt(27), Math.Hypot(3, 4), Math.Sin(1e22));

# 浮點餘數是精確的 IEEE 餘數（C fmod）。
印出("餘數", 100000000000000000.0d % 3, -7.5 % 2, 5.0 % Math.Infinity, 1.0d / (-(0.0d) % 3), 數學.浮點餘數(1e300, 7));

# 位元運算只用於整數。
變數 旗標 = 0b0001;
旗標 |= 1 << 4;
旗標 &= ~1;
旗標 ^= 0x0F;
印出("位元", 旗標, 6 & 3, 6 | 3, 6 ^ 3, -16 >> 2, -16 >>> 28, 1 << 33);

# FNV-1a 雜湊：型別完整的函式在原生層執行，位元運算直接編成 Wasm 指令。
變數 雜湊碼 = 函式(文字: 字串): 整數 {
    變數 h: 整數 = 0x811C9DC5;
    迴圈 (變數 i: 整數 = 0; i < 長度(文字); i++) {
        h = (h ^ 字串.字元碼(文字, i)) * 16777619;
    }
    回傳 h;
};
印出("FNV-1a", 雜湊碼("星泉"), 雜湊碼("AquariusLang"));

# 數值積分：∫₀^π sin(x) dx = 2（辛普森法，原生層呼叫 數學.正弦）。
變數 積分 = 函式(n: 整數): 雙精度 {
    變數 h: 雙精度 = Math.PI / n;
    變數 總和: 雙精度 = Math.Sin(0.0) + Math.Sin(Math.PI);
    迴圈 (變數 i: 整數 = 1; i < n; i++) {
        如果 (i % 2 == 1) { 總和 += 4 * Math.Sin(i * h); } 否則 { 總和 += 2 * Math.Sin(i * h); }
    }
    回傳 總和 * h / 3;
};
印出("辛普森", 積分(1000), 數學.絕對值(積分(1000) - 2) < 1e-11);

# 有種子的亂數（PCG32）：同一種子在每個平台得到同一串數字。
數學.亂數種子(2026);
變數 骰子 = [];
迴圈 (變數 i = 0; i < 8; i++) { 骰子 = 加入(骰子, Math.RandomInt(1, 7)); }
印出("亂數", 骰子, Math.Random());

# 數字文字：印出 與 字串.轉文字 完全相同；解析數字 精確讀回。
變數 數值 = [0.1 + 0.2, 100000000000000000.0d, 0.00001, -(0.0d), 1000000000.0f, 1.0d / 3];
印出("文字", 數值, 字串.轉文字(數值));
變數 讀回 = 真;
迴圈 (變數 i = 0; i < 長度(數值); i++) {
    如果 (字串.解析數字(字串.轉文字(數值[i])) != 數值[i]) { 讀回 = 假; }
}
印出("解析", 字串.解析數字(" 42 "), 型別(字串.解析數字("42")), 字串.解析數字("1E-05"), 字串.解析數字("2147483648"), 字串.解析數字("0x10"), 讀回);
