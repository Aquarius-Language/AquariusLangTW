# 即時攝影機展示。關閉視窗即可結束；工作階段會在結束後釋放。
# 擷取最新影格；繪圖較慢時自動略過舊影格，避免延遲持續增加。
變數 攝影機 = 匯入("攝影機");
變數 繪圖 = 匯入("Processing");
變數 視窗 = 匯入("Window");
變數 工作階段 = 攝影機.開啟("", 640, 480, 30);
變數 設定 = 函式() {
    繪圖.尺寸(800, 600, 繪圖.P2D, "攝影機即時展示");
    繪圖.影格率(30);
    繪圖.文字字型(繪圖.建立字型("sans-serif", 20));
    繪圖.註冊事件("error", 函式() {
        印出("攝影機展示中斷，請確認權限或裝置連線。");
        工作階段.釋放();
        繪圖.結束();
    });
};
變數 更新 = 函式() {
    變數 影格 = 工作階段.擷取影格();
    變數 圖片 = 視窗.轉為Processing圖片(影格.影像);
    繪圖.背景(18, 25, 38);
    繪圖.圖片(圖片, 80, 40, 640, 480);
    繪圖.填色(235, 241, 250);
    繪圖.文字大小(20);
    繪圖.文字("攝影機即時展示・關閉視窗以結束", 80, 558);
};
繪圖.執行(設定, 更新);
工作階段.釋放();
印出("攝影機展示已結束，裝置已關閉。");
