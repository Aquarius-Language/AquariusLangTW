# 本程式會啟用預設攝影機，擷取兩張影格後立即關閉。
變數 攝影機 = 匯入("攝影機");
變數 工作階段 = 攝影機.開啟("", 320, 240, 30);
變數 第一張 = 工作階段.擷取影格();
變數 第二張 = 工作階段.擷取影格();
變數 像素 = 第一張.取得像素();
變數 通過 = 第一張.寬度 == 320 && 第一張.高度 == 240 && 長度(像素) == 320 * 240 * 4;
通過 = 通過 && 第二張.序號 > 第一張.序號 && 第二張.時間戳記 >= 第一張.時間戳記;
迴圈 (變數 索引 = 3; 索引 < 長度(像素); 索引 += 4) {
    如果 (像素[索引] != 255) { 通過 = 假; }
}
工作階段.釋放();
工作階段.釋放();
通過 = 通過 && !工作階段.是否開啟();
如果 (通過) { 印出("攝影機影格驗證全部通過"); }
否則 { 印出("攝影機影格驗證失敗"); }
通過;
