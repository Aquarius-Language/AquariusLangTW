# 列出裝置不會主動請求攝影機權限。瀏覽器可能隱藏名稱或識別碼。
變數 攝影機 = 0;
如果 (是Android()) { 攝影機 = 匯入("相機"); }
否則如果 (是網頁()) { 攝影機 = 匯入("網路攝影機"); }
否則 { 攝影機 = 匯入("網路攝影機"); }
如果 (攝影機.是否支援()) {
    變數 裝置 = 攝影機.列出裝置();
    印出("攝影機數量：", 長度(裝置));
    迴圈 (變數 索引 = 0; 索引 < 長度(裝置); 索引++) {
        印出("裝置名稱：", 裝置[索引].名稱);
        印出("裝置識別碼：", 裝置[索引].識別碼);
    }
} 否則 {
    印出("此環境尚未提供攝影機支援，請參閱範例說明。");
}
