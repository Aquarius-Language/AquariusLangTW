# Mixed syntax 混合語法: 繁體中文 and English keywords and type names in one file.
# 中文與英文的型別名稱完全相同：整數 = int、雙精度 = double、字串 = string、陣列 = array.

# 1. Scalars 純量
var 次數: int = 3;
變數 temperature: 雙精度 = 21.5d;
var 名稱: 字串 = "Aquarius 星泉";
變數 enabled: bool = 真;
print(名稱, 次數, temperature, enabled, typeOf(temperature));

# Widening and narrowing 放寬與縮小
var 溫度整數: 整數 = int(temperature);
變數 scale: float = 次數;
印出("narrowed / widened", 溫度整數, scale, 型別(scale));

# 2. Typed functions 型別函式
var 面積 = 函式(寬: double, 高: 雙精度): double { 回傳 寬 * 高; };
變數 classify = function(n: 整數): string {
    如果 (n < 0) { return "負數 negative"; }
    else 如果 (n == 0) { 回傳 "零 zero"; }
    否則 { return "正數 positive"; }
};
print("面積 area", 面積(2.5d, 4));
印出(classify(-5), "|", classify(0), "|", classify(8));

# 3. Typed arrays 型別陣列
var 溫度們: 雙精度[] = [18.5d, 21.0d, 24.5d, 19.0d];
變數 flags: 布林[] = [真, false, true];
var 標籤: array = ["室內 indoor", "室外 outdoor"];
var 最高 = function(values: 雙精度[]): double {
    變數 best: 雙精度 = values[0];
    for (變數 i: int = 1; i < len(values); i++) {
        if (values[i] > best) { best = values[i]; }
    }
    回傳 best;
};
印出("temperatures", 溫度們, "最高 max", 最高(溫度們));
print("flags", flags, "標籤", 標籤, 長度(標籤));

# 4. Structs 結構: 中文與英文的 struct 關鍵字都可以
struct 感測器 { 名稱: string; 讀數: 雙精度[]; 單位: 字串 }
結構 Station { name: 字串; sensor: 感測器; online: bool }

var 室內 = 感測器(名稱: "indoor", 讀數: 溫度們, 單位: "°C");
變數 station = Station("Taipei 台北", 室內, 真);
print(station.name, station.sensor.名稱, station.online);

var 平均讀數 = function(s: 感測器): 雙精度 {
    變數 sum: double = 0;
    迴圈 (var i: 整數 = 0; i < 長度(s.讀數); i++) { sum += s.讀數[i]; }
    return sum / len(s.讀數);
};
印出("平均 average", 平均讀數(station.sensor), station.sensor.單位);

station.online = 假;
# Structs and arrays are references 參考值: 讀數 shares the sensor's array.
var 讀數: 雙精度[] = station.sensor.讀數;
讀數[0] = 讀數[0] + 1.5d;
print("updated 更新", station.online, 室內.讀數, typeOf(station));

# 5. Checks 檢查: 註解中的這行在編譯時就會被拒絕
#     var 錯誤: int = "text";   -> Type mismatch: 錯誤 expects 整數 int, got 字串 string
