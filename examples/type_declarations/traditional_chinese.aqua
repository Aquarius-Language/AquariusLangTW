# 型別宣告：以繁體中文語法使用選用的「名稱: 型別」標註。
# 每個標註都是選用的；有標註與沒標註的程式碼可以自由混用。

# 1. 純量型別：整數、浮點數、雙精度、布林、字串。
變數 數量: 整數 = 3;
變數 比例: 浮點數 = 1.5f;
變數 精確值: 雙精度 = 2.25d;
變數 就緒: 布林 = 真;
變數 標題: 字串 = "庫存";
印出(標題, 數量, 比例, 精確值, 就緒);
印出("型別", 型別(數量), 型別(比例), 型別(精確值), 型別(就緒), 型別(標題));

# 整數可自動放寬為浮點數與雙精度；縮小需要明確轉換。
變數 放寬: 雙精度 = 數量;
變數 截斷: 整數 = 整數(精確值 * 3);
印出("放寬 / 截斷", 放寬, 截斷);

# 複合指派保留變數的型別：整數仍然是整數。
變數 合計: 整數 = 10;
合計 += 2.9d;
合計 *= 2;
印出("合計仍是整數", 合計, 型別(合計));

# 2. 型別函式：參數型別，以及參數列後面的回傳型別。
變數 平方 = 函式(n: 整數): 整數 { 回傳 n * n; };
變數 平均 = 函式(甲: 雙精度, 乙: 雙精度): 雙精度 { 回傳 (甲 + 乙) / 2; };
變數 問候 = 函式(名字: 字串, 大聲: 布林): 字串 {
    如果 (大聲) { 回傳 "哈囉，" + 名字 + "！"; }
    回傳 "你好，" + 名字;
};
印出("平方 / 平均", 平方(7), 平均(3, 4));
印出(問候("星泉", 真), "|", 問候("世界", 假));

# 3. 型別陣列：整數[]、雙精度[]、布林[]；陣列可存任何值（字串、陣列……）。
變數 分數: 整數[] = [90, 72, 85, 64];
變數 價格: 雙精度[] = [19.99d, 5.5d, 12.0d];
變數 水果: 陣列 = ["蘋果", "香蕉", "櫻桃"];
變數 混合: 陣列 = [1, "二", [3, 4], 真];
印出("分數", 分數, "價格", 價格);
印出("水果", 水果, "混合", 混合);

變數 總和 = 函式(值們: 整數[]): 整數 {
    變數 結果: 整數 = 0;
    迴圈 (變數 i: 整數 = 0; i < 長度(值們); i++) { 結果 += 值們[i]; }
    回傳 結果;
};
變數 最長 = 函式(詞們: 陣列): 字串 {
    變數 最佳: 字串 = "";
    迴圈 (變數 i: 整數 = 0; i < 長度(詞們); i++) {
        如果 (長度(詞們[i]) > 長度(最佳)) { 最佳 = 詞們[i]; }
    }
    回傳 最佳;
};
印出("分數總和", 總和(分數), "最長的名稱", 最長(["梨", "奇異果", "芒果"]));

# 4. 結構：欄位可標註型別的具名紀錄。
結構 商品 { 名稱: 字串; 價格: 雙精度; 數量: 整數; 標籤 }
變數 筆 = 商品(名稱: "筆", 價格: 1.25d, 數量: 4);
變數 書 = 商品("書", 12.5d, 1, ["紙本", "閱讀"]);
印出(筆);
印出("書", 書.名稱, 書.標籤, 型別(書));

筆.數量 += 6;
筆.價格 *= 2;
印出("更新後的筆", 筆.數量, 筆.價格);

變數 成本 = 函式(項目: 商品): 雙精度 { 回傳 項目.價格 * 項目.數量; };
印出("成本", 成本(筆), 成本(書));

# 結構的欄位可以是結構型別，包括自己。
結構 節點 { 值: 整數; 下一個: 節點 }
變數 串列 = 節點(1, 節點(2, 節點(3)));
# 建立時省略的欄位為 null；以 型別() 判斷串列的結尾。
變數 串列總和 = 函式(目前: 節點): 整數 {
    如果 (型別(目前.下一個) == "null") { 回傳 目前.值; }
    回傳 目前.值 + 串列總和(目前.下一個);
};
印出("串列總和", 串列總和(串列));

# 5. 標註會被檢查。可確定的錯誤在編譯時就被拒絕：
#     變數 錯誤: 整數 = "文字";   -> 型別不符：錯誤 需要 整數 int，卻是 字串 string
# 來自未標註程式碼的值則在執行時檢查。
變數 加一 = 函式(n: 整數): 整數 { 回傳 n + 1; };
變數 未標註 = 41;
印出("執行時檢查", 加一(未標註));
# 移除下一行開頭的「#」即可看到執行時錯誤：型別不符 / Type mismatch: n expects int, got STRING
# 未標註 = "不是數字"; 印出(加一(未標註));
