# Documents use portable resources; packaged assets retain their existing loader.
變數 files = 匯入("Files");
變數 data = 匯入("Serialization");
變數 images = 匯入("Images");
變數 editing = 匯入("TextEdit");
變數 document = {"title":"繁體中文 😀", "values":[1,2,3]};
變數 encoded = data.Binary(document, 1);
變數 decoded = data.ParseBinary(encoded);
變數 archive = data.Archive({"metadata.aqd":encoded, "resources/data.bin":[1,2,3]});
變數 resources = data.ReadArchive(archive);
變數 image = images.Create(2, 1, [255,0,0,255,0,255,0,128]);
變數 png = images.Encode(image, "Png", {});
變數 temporary = files.Temporary(假);
files.SaveBytes(temporary, png, 真);
變數 loaded = images.Load(temporary, 0);
變數 stream = files.Open(temporary, "Read");
變數 signature = stream.Read(8);
stream.Seek(0, "Begin");
stream.Close();
temporary.Dispose();
變數 editor = editing.Create("é👨‍👩‍👧‍👦繁");
editor.Select(3, 3);
editor.Backspace();
editor.Composition("😀字", 2, "Utf16");
editor.Commit("字");
變數 state = editor.State();
變數 content = decoded.value;
印出(content["title"], loaded.width, loaded.height, signature[0], state.text);
真;
