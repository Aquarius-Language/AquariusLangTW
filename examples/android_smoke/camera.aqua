# Optional device smoke: the harness grants CAMERA to this disposable test app.
變數 相機 = 匯入("相機");
變數 裝置 = 相機.列出裝置();
印出("ANDROID_CAMERA_ENUMERATED", 長度(裝置));
如果 (長度(裝置) == 0) { 印出("ANDROID_CAMERA_FAILED: no device"); }
迴圈 (變數 i=0; i<長度(裝置) && i<2; i++) {
    變數 工作 = 相機.開啟(裝置[i].識別碼, 64, 48, 15);
    變數 第一 = 工作.擷取影格();
    變數 像素 = 第一.取得像素();
    變數 原值 = 像素[0];
    變數 第二 = 工作.擷取影格();
    如果 (長度(像素) != 第一.寬度*第一.高度*4 || 像素[3] != 255 || 像素[長度(像素)-1] != 255 || 像素[0] != 原值 || 第二.序號 <= 第一.序號 || 第二.時間戳記 < 第一.時間戳記) { 印出("ANDROID_CAMERA_FAILED: frame contract"); }
    印出("ANDROID_CAMERA_FRAME", 第一.方向, 第一.寬度, 第一.高度, 第二.序號);
    工作.釋放(); 工作.釋放();
    如果 (工作.是否開啟()) { 印出("ANDROID_CAMERA_FAILED: disposed session"); }
}
變數 重開 = 相機.開啟("", 64, 48, 15); 重開.擷取影格(); 重開.釋放();
印出("ANDROID_CAMERA_OK");
