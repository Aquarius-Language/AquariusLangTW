# 非同步函式、等待與承諾。預期輸出見 README.md。
變數 字串 = 匯入("字串");

變數 下載 = 非同步 函式(名稱, 毫秒) {
    等待 承諾.延遲(毫秒);
    回傳 名稱 + "完成";
};

# 三個工作同時進行，全部完成後依序取得結果。
變數 結果 = 等待 承諾.全部([下載("甲", 30), 下載("乙", 10), 下載("丙", 20)]);
印出(結果);

# 最先完成者勝出。
印出(等待 承諾.競速([下載("慢", 40), 下載("快", 5)]));
等待 承諾.延遲(40);

# 錯誤會沿著 等待 傳遞；捕捉 把錯誤轉成值。
變數 檢查 = 非同步函式(數值) {
    如果 (數值 < 0) { 回傳 承諾.拒絕("不能是負數"); }
    回傳 數值 * 2;
};
印出(等待 檢查(21));
印出(等待 檢查(-1).捕捉(函式(原因) { 回傳 "錯誤：" + 原因; }));

# 然後 串接，最終 一定會執行。
變數 紀錄 = [];
變數 值 = 等待 承諾.解決(5).然後(函式(n) { 回傳 n * 10; }).最終(函式() { 匯入("陣列").追加(紀錄, "最終"); });
印出(值, 紀錄);

# 逾時：時間到仍未完成就拒絕。
印出(等待 承諾.逾時(承諾.延遲(500), 20).捕捉(函式(原因) { 回傳 原因; }));

# 遞迴的非同步函式。
變數 倒數 = 非同步 函式(n) {
    如果 (n == 0) { 回傳 "發射"; }
    等待 承諾.延遲(1);
    回傳 字串.轉文字(n) + " " + 等待 倒數(n - 1);
};
印出(等待 倒數(3));
