# 無視窗的整合檢查可在三個平台執行。
變數 網路 = 匯入("網路");
變數 用戶端 = 網路.建立用戶端({"逾時":5000, "認證":"include"});
變數 第一筆 = 用戶端.請求("POST", "http://127.0.0.1:8787/api/回聲", {"JSON":{"訊息":"繁體中文往返測試", "序號":1}});
變數 第二筆 = 用戶端.請求("POST", "http://127.0.0.1:8787/api/回聲", {"JSON":{"訊息":"第二筆", "序號":2}});
變數 資料 = 第二筆.解析JSON();
變數 錯誤回應 = 用戶端.取得("http://127.0.0.1:8787/api/狀態/驗證");
變數 成功 = 第一筆.成功 && 第二筆.成功 && 資料["訊息"]=="第二筆" && 資料["序號"]==2 && 資料["工作階段次數"]>=2 && 錯誤回應.狀態碼==422 && !錯誤回應.成功;
印出("網路驗證完成", 成功, "工作階段次數", 資料["工作階段次數"]);
用戶端.關閉();
成功;
