變數 繪圖 = 匯入("繪圖");
變數 網路 = 匯入("網路");
變數 文字工具 = 匯入("序列化");
變數 用戶端 = 網路.建立用戶端({"逾時":3000, "認證":"include"});
變數 空 = [][0];
變數 序號 = 0;
變數 成功數 = 0;
變數 失敗數 = 0;
變數 工作階段次數 = 0;
變數 上次傳送 = -2000;
變數 延遲 = 0;
變數 狀態 = "等待連線";
變數 傳送內容 = "";
變數 接收內容 = "";
變數 歷史 = [];
變數 延遲歷史 = [];
變數 開始時間 = 目前時間();
變數 進行中 = 空;
變數 起點 = 0;
變數 傳送 = 函式() {
    序號 = 序號 + 1;
    傳送內容 = "來自星泉的第 " + 文字工具.JSON序列化(序號) + " 筆訊息";
    起點 = 目前時間();
    進行中 = 用戶端.開始請求("POST", "http://127.0.0.1:8787/api/回聲", {"JSON":{"訊息":傳送內容, "序號":序號}});
    上次傳送 = 目前時間();
};
變數 接收 = 函式() {
    變數 回應 = 進行中.輪詢();
    如果 (回應 == 空) { 回傳 空; }
    進行中 = 空;
    延遲 = 目前時間() - 起點;
    如果 (回應.成功) {
        變數 資料 = 回應.解析JSON();
        接收內容 = 資料["訊息"];
        工作階段次數 = 資料["工作階段次數"];
        成功數 = 成功數 + 1;
        狀態 = "連線正常 · HTTP " + 文字工具.JSON序列化(回應.狀態碼);
        印出("網路往返成功", 序號, "工作階段", 工作階段次數);
    } 否則 {
        失敗數 = 失敗數 + 1;
        如果 (回應.錯誤 != 空) { 狀態 = 回應.錯誤.訊息; }
        否則 { 狀態 = "伺服器回應錯誤"; }
        接收內容 = "請確認後端已啟動，將於下一次自動重試。";
    }
    歷史 = 加入(歷史, "#" + 文字工具.JSON序列化(序號) + "  " + 接收內容);
    延遲歷史 = 加入(延遲歷史, 延遲);
    如果 (長度(歷史)>5) { 歷史 = 其餘(歷史); }
    如果 (長度(延遲歷史)>30) { 延遲歷史 = 其餘(延遲歷史); }
    上次傳送 = 目前時間();
};
變數 設定 = 函式() {
    繪圖.尺寸(520, 760);
    繪圖.文字字型("sans-serif", 18);
    繪圖.影格率(30);
};
變數 繪製 = 函式() {
    如果 (進行中 != 空) { 接收(); }
    變數 寬 = 繪圖.寬度;
    繪圖.背景(12, 18, 30);
    繪圖.停用描邊();
    繪圖.填色(63, 213, 180); 繪圖.矩形(24, 28, 6, 28, 3);
    繪圖.填色(240); 繪圖.文字大小(26); 繪圖.文字("星泉網路實驗室", 44, 52);
    繪圖.填色(142, 158, 182); 繪圖.文字大小(14); 繪圖.文字("每秒傳送 JSON · 即時顯示 HTTP 往返", 24, 82);
    繪圖.填色(24, 36, 54); 繪圖.矩形(24, 108, 寬-48, 104, 12);
    繪圖.填色(63, 213, 180); 繪圖.文字大小(16); 繪圖.文字(狀態, 42, 140);
    繪圖.填色(230); 繪圖.文字("成功 " + 文字工具.JSON序列化(成功數) + "    失敗 " + 文字工具.JSON序列化(失敗數), 42, 172);
    繪圖.填色(142, 158, 182); 繪圖.文字("工作階段 " + 文字工具.JSON序列化(工作階段次數), 42, 196);
    繪圖.填色(24, 36, 54); 繪圖.矩形(24, 228, 寬-48, 132, 12);
    繪圖.填色(101, 167, 255); 繪圖.文字("傳送 →", 42, 258);
    繪圖.填色(235); 繪圖.文字(傳送內容, 42, 284);
    繪圖.填色(63, 213, 180); 繪圖.文字("接收 ←", 42, 318);
    繪圖.填色(235); 繪圖.文字(接收內容, 42, 344);
    繪圖.填色(24, 36, 54); 繪圖.矩形(24, 376, 寬-48, 124, 12);
    繪圖.填色(235); 繪圖.文字("往返延遲（毫秒）", 42, 406);
    迴圈 (變數 索引=0; 索引<長度(延遲歷史); 索引++) {
        變數 柱高 = 繪圖.最小值(56, 延遲歷史[索引]);
        繪圖.填色(63, 213, 180); 繪圖.矩形(42+索引*(寬-84)/30, 478-柱高, (寬-100)/30, 柱高+2, 2);
    }
    繪圖.填色(142, 158, 182); 繪圖.文字大小(14); 繪圖.文字("最近五筆回應", 24, 534);
    迴圈 (變數 索引=0; 索引<長度(歷史); 索引++) {
        繪圖.填色(210); 繪圖.文字(歷史[索引], 24, 566+索引*29);
    }
    繪圖.填色(100, 118, 142); 繪圖.文字("桌面 · 網頁 · Android 共用同一份星泉程式", 24, 738);
    如果 (進行中 == 空 && 目前時間()-上次傳送>=1000) { 傳送(); }
};
繪圖.執行(設定, 繪製);
用戶端.關閉();
真;
