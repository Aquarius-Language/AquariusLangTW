# 進階測試另需啟動測試用 TCP／UDP 回聲服務。
變數 網路 = 匯入("網路");
變數 原生成功 = 真;
如果 (網路.支援("tcp")) {
    變數 主機 = "127.0.0.1";
    如果 (是Android()) { 主機 = "10.0.2.2"; }
    變數 位址 = 網路.解析主機("localhost");
    變數 串流 = 網路.連接傳輸控制(主機, 8871, {"逾時":3000});
    串流.寫入([0, 255, 42]);
    變數 資料 = 串流.讀取(3);
    原生成功 = 長度(位址)>0 && 長度(資料)==3 && 資料[0]==0 && 資料[1]==255 && 資料[2]==42;
    串流.關閉();
    變數 資料報 = 網路.開啟資料報("0.0.0.0", 0, {"逾時":3000});
    資料報.傳送(主機, 8872, [42, 255, 0]);
    變數 封包 = 資料報.接收(16);
    變數 內容 = 封包.資料;
    原生成功 = 原生成功 && 長度(內容)==3 && 內容[0]==42 && 內容[1]==255;
    資料報.關閉();
}
變數 通訊端 = 網路.連接網頁通訊端("ws://127.0.0.1:8787/api/通訊端");
通訊端.傳送文字("繁體中文通訊端往返");
變數 訊息 = 通訊端.接收();
變數 成功 = 原生成功 && 訊息.是文字 && 訊息.文字=="繁體中文通訊端往返";
通訊端.關閉();
印出("網路協定驗證完成", 成功);
成功;
