# 所有路由都在星泉執行緒依序處理，工作階段資料只留在記憶體。
變數 網路 = 匯入("網路");
變數 伺服器 = 網路.監聽("http://127.0.0.1:8787");
變數 空 = [][0];
變數 總請求數 = 0;
伺服器.使用中介(函式(請求, 回應) {
    總請求數 = 總請求數 + 1;
    回應.設定標頭("Cache-Control", "no-store");
});
伺服器.處理("GET", "/api/健康", 函式(請求, 回應) {
    回應.回傳JSON({"服務":"星泉網路實驗室", "正常":真, "總請求數":總請求數});
});
伺服器.處理("POST", "/api/回聲", 函式(請求, 回應) {
    變數 資料 = 請求.解析JSON();
    變數 工作階段 = 請求.工作階段();
    變數 次數 = 工作階段.取得("次數");
    如果 (次數 == 空) { 次數 = 0; }
    次數 = 次數 + 1;
    工作階段.設定("次數", 次數);
    回應.回傳JSON({"訊息":資料["訊息"], "序號":資料["序號"], "工作階段次數":次數, "總請求數":總請求數, "日期":目前日期()});
});
伺服器.處理("GET", "/api/狀態/{代碼}", 函式(請求, 回應) {
    回應.狀態(422);
    回應.回傳JSON({"錯誤":"這是用來展示錯誤處理的回應", "代碼":請求.路由參數("代碼")});
});
伺服器.處理("GET", "/api/通訊端", 函式(請求, 回應) {
    變數 通訊端 = 回應.升級網頁通訊端();
    變數 訊息 = 通訊端.接收();
    如果 (訊息.是文字) { 通訊端.傳送文字(訊息.文字); }
    否則 { 通訊端.傳送位元組(訊息.資料); }
    通訊端.關閉();
});
# 建置腳本將網頁輸出放在專案根目錄的 public 資料夾。
伺服器.靜態檔案("/", "public");
印出("星泉網路實驗室已啟動：", 伺服器.位址);
伺服器.服務();
