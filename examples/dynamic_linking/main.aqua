變數 動態 = 匯入("動態函式庫");
變數 dynamic = 動態;
變數 函式庫目錄 = 目前工作目錄 + "/libraries/";
印出("Dynamic linking / 動態連結", dynamic.Platform, "ABI", 動態.介面版本);
變數 函式庫 = 動態.載入({
    "windows": 函式庫目錄 + "windows/showcase.dll",
    "linux": 函式庫目錄 + "linux/libshowcase.so",
    "android": "libshowcase.so",
    "web": 函式庫目錄 + "portable/showcase.wasm"
});
變數 library = 函式庫;
印出(library.Call("greeting", ""));
印出("繁體中文 UTF-8:", 函式庫.呼叫("echo", "你好，星泉！"));
印出("English UTF-8:", library.Call("echo", "Hello, Aquarius!"));
變數 總和 = library.Invoke("sum", [10, 20, 12]);
印出("10 + 20 + 12 =", 總和[0]);
印出("Symbol / 符號:", 函式庫.具有符號("echo"), library.HasSymbol("missing"));
函式庫.釋放(); library.Dispose();

# Load the same portable library a second time on every platform.
變數 可攜 = dynamic.Load({"wasm": 函式庫目錄 + "portable/showcase.wasm"});
印出("WebAssembly:", 可攜.呼叫("echo", "同一個 Wasm / identical Wasm"));
可攜.釋放();
如果 (是網頁()) {
    變數 js = dynamic.Load(函式庫目錄 + "web/showcase.mjs");
    印出("JavaScript:", js.Call("echo", "JS & WebAssembly / 網頁雙格式"));
    js.Dispose();
}
印出("DYNAMIC_LINKING_OK / 動態連結成功");
