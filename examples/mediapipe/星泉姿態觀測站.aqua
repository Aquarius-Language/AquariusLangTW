變數 介面 = 匯入("中文介面.aqua");
變數 畫 = 介面.繪圖;
變數 模型 = 匯入("姿態模型.aqua");
變數 引擎 = 匯入("推論引擎");
變數 攝影機 = 0;
如果 (是Android()) { 攝影機 = 匯入("相機"); }
否則如果 (是網頁()) { 攝影機 = 匯入("網路攝影機"); }
否則 { 攝影機 = 匯入("網路攝影機"); }
變數 拍攝 = 0;
變數 運作中 = 假;
變數 圖片 = 0;
變數 有圖片 = 假;
變數 圖形加速 = 真;
變數 狀態 = "選擇推論方式，開始觀察人體姿態。";
變數 影格耗時 = 0.0d;
變數 影格率 = 0.0d;
變數 上次影格 = 0.0d;
變數 影像寬 = 512.0d;
變數 影像高 = 384.0d;
變數 影像左 = 40.0d;
變數 影像上 = 250.0d;
變數 比例 = 1.0d;
變數 直式 = 假;
變數 左邊 = 0.0d;
變數 上邊 = 0.0d;
變數 連線 = [[11, 12], [11, 13], [13, 15], [12, 14], [14, 16], [11, 23], [12, 24], [23, 24], [23, 25], [25, 27], [24, 26], [26, 28], [27, 29], [29, 31], [28, 30], [30, 32], [15, 17], [15, 19], [16, 18], [16, 20]];
變數 停止 = 函式() {
    如果 (運作中) { 拍攝.釋放(); }
    運作中 = 假; 模型.釋放(); 狀態 = "已停止。可重新選擇推論方式。";
};
變數 啟動 = 函式(使用加速) {
    停止(); 圖形加速 = 使用加速;
    # 圖形處理器：自動選擇此平台最快的 GPU 後端（CUDA、Core ML、WebGPU…），失敗時改用下一個。
    變數 後端 = 引擎.中央處理器; 如果 (使用加速) { 後端 = 引擎.圖形處理器; }
    如果 (!引擎.是否支援(後端)) { 狀態 = "此環境無法使用圖形加速，請選擇中央處理器。"; 回傳 假; }
    模型.載入(後端);
    拍攝 = 攝影機.開啟("", 640, 480, 30); 運作中 = 真; 上次影格 = 0;
    狀態 = "正在尋找人物；請讓主要身體部位清楚入鏡。"; 回傳 真;
};
變數 處理點擊 = 函式() {
    變數 橫 = (介面.滑鼠橫座標() - 左邊) / 比例;
    變數 縱 = (介面.滑鼠縱座標() - 上邊) / 比例;
    如果 (直式 && 縱 >= 760) { 橫 += 560; 縱 -= 570; }
    如果 (橫 >= 600 && 橫 <= 996) {
        如果 (縱 >= 226 && 縱 <= 280) { 啟動(真); }
        如果 (縱 >= 298 && 縱 <= 352) { 啟動(假); }
        如果 (縱 >= 370 && 縱 <= 424) { 停止(); }
    }
};
變數 處理錯誤 = 函式() { 停止(); 狀態 = "操作失敗。請確認攝影機權限、模型與加速功能。"; };
變數 文字 = 函式(內容, 橫, 縱, 大小, 紅, 綠, 藍) { 畫.停用描邊(); 畫.填色(紅, 綠, 藍); 畫.文字大小(大小); 畫.文字(內容, 橫, 縱); };
變數 按鈕 = 函式(內容, 縱, 啟用) {
    畫.停用描邊(); 畫.填色(29, 49, 65); 如果 (啟用) { 畫.填色(30, 121, 106); }
    畫.矩形(600, 縱, 396, 54, 12); 文字(內容, 620, 縱 + 35, 18, 225, 244, 240);
};
變數 設定 = 函式() {
    介面.開啟視窗(); 畫.影格率(30); 畫.文字字型(畫.建立字型("sans-serif", 18));
    介面.註冊點擊(處理點擊); 介面.註冊錯誤(處理錯誤);
};
變數 繪製 = 函式() {
    如果 (運作中) {
        變數 開始 = 目前時間();
        變數 影格 = 拍攝.擷取影格(); 圖片 = 介面.轉為繪圖圖片(影格.影像); 有圖片 = 真;
        模型.分析影像(影格.影像, 影格.時間戳記);
        變數 縮放 = 畫.最小值(512.0d / 影格.寬度, 512.0d / 影格.高度);
        影像寬 = 影格.寬度 * 縮放; 影像高 = 影格.高度 * 縮放;
        影像左 = 40 + (512 - 影像寬) / 2; 影像上 = 186 + (512 - 影像高) / 2;
        變數 完成 = 目前時間(); 影格耗時 = 完成 - 開始;
        如果 (上次影格 > 0) { 影格率 = 1000.0d / 畫.最大值(1.0d, 完成 - 上次影格); }
        上次影格 = 完成;
        狀態 = "正在尋找人物；移動或調整光線以便辨識。";
        如果 (模型.有人物) { 狀態 = "已偵測人物，正在以 " + 模型.後端名稱 + " 追蹤姿態。"; }
    }
    直式=介面.寬度()<760; 變數 版寬=1040.0d; 變數 版高=760.0d;
    如果 (直式) { 版寬=592; 版高=1320; }
    比例=畫.最小值(介面.寬度()/版寬,介面.高度()/版高);
    左邊=(介面.寬度()-版寬*比例)/2; 上邊=(介面.高度()-版高*比例)/2;
    畫.背景(11, 24, 34); 畫.推入矩陣(); 畫.平移(左邊, 上邊); 畫.縮放(比例);
    文字("星泉 · 人體姿態實驗", 40, 48, 16, 92, 216, 183);
    文字("姿態觀測站", 38, 108, 44, 231, 245, 242);
    文字("三十三個關鍵點，跨平台即時觀測。", 40, 146, 18, 149, 179, 188);
    畫.停用描邊(); 畫.填色(20, 40, 53); 畫.矩形(40, 186, 512, 512, 14);
    如果 (有圖片) { 畫.圖片(圖片, 影像左, 影像上, 影像寬, 影像高); }
    如果 (運作中 && 模型.有人物) {
        變數 點 = 模型.關鍵點;
        畫.描邊(87, 228, 189); 畫.描邊粗細(3);
        迴圈 (變數 項 = 0; 項 < 長度(連線); 項++) {
            變數 邊 = 連線[項]; 變數 甲 = 邊[0]; 變數 乙 = 邊[1];
            如果 (模型.可見程度(甲) >= 0.75d && 模型.可見程度(乙) >= 0.75d) {
                畫.線段(影像左 + 點[甲 * 5] * 影像寬, 影像上 + 點[甲 * 5 + 1] * 影像高, 影像左 + 點[乙 * 5] * 影像寬, 影像上 + 點[乙 * 5 + 1] * 影像高);
            }
        }
        畫.停用描邊(); 畫.填色(249, 204, 99);
        迴圈 (變數 項 = 0; 項 < 33; 項++) {
            如果 (模型.可見程度(項) >= 0.75d) { 畫.橢圓(影像左 + 點[項 * 5] * 影像寬, 影像上 + 點[項 * 5 + 1] * 影像高, 8, 8); }
        }
    }
    如果 (直式) { 畫.推入矩陣(); 畫.平移(-560,570); }
    文字("推論方式", 600, 202, 20, 222, 240, 235);
    按鈕("使用圖形加速", 226, 運作中 && 圖形加速);
    按鈕("使用中央處理器", 298, 運作中 && !圖形加速);
    按鈕("停止攝影機與推論", 370, 假);
    文字("模型信心", 600, 470, 15, 149, 179, 188);
    文字(畫.四捨五入(模型.信心 * 100), 600, 516, 32, 231, 245, 242);
    文字("％", 678, 516, 24, 149, 179, 188);
    文字("完整影格耗時／模型耗時", 600, 555, 15, 149, 179, 188);
    文字(畫.四捨五入(影格耗時), 600, 594, 28, 231, 245, 242);
    文字("／", 664, 594, 20, 149, 179, 188);
    文字(畫.四捨五入(模型.模型耗時), 697, 594, 28, 231, 245, 242);
    文字("毫秒", 760, 594, 18, 149, 179, 188);
    文字("實際影格率", 600, 627, 15, 149, 179, 188);
    文字(畫.四捨五入(影格率), 600, 658, 24, 231, 245, 242);
    文字("幀／秒", 664, 658, 16, 149, 179, 188);
    文字("影像僅在你的裝置內處理。", 600, 678, 16, 149, 179, 188);
    如果 (直式) { 畫.彈出矩陣(); }
    文字(狀態, 40, 738, 16, 205, 230, 226); 畫.彈出矩陣();
};
畫.執行(設定, 繪製);
停止();
