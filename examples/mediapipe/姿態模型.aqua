# 人物偵測、旋轉裁切與追蹤共用核心 Wasm；影像整批傳送，避免逐像素陣列往返。
變數 姿態 = 匯入("姿態追蹤");
變數 追蹤器 = 0;
變數 已載入 = 假;
變數 有人物 = 假;
變數 關鍵點 = [];
變數 信心 = 0.0d;
變數 耗時 = 0.0d;
變數 模型耗時 = 0.0d;
變數 釋放 = 函式() {
    如果 (已載入) { 追蹤器.釋放(); }
    已載入 = 假; 有人物 = 假; 追蹤器 = 0; 關鍵點 = []; 信心 = 0.0d;
};
變數 載入 = 函式(後端) {
    釋放();
    追蹤器 = 姿態.建立姿態追蹤器(目前工作目錄 + "/模型/人物偵測.onnx", 目前工作目錄 + "/模型/姿態.onnx", 後端);
    已載入 = 真;
};
變數 分析影像 = 函式(影像, 時間) {
    變數 結果 = 追蹤器.分析(影像, 時間);
    有人物 = 結果.有人物; 關鍵點 = 結果.關鍵點; 信心 = 結果.信心;
    耗時 = 結果.總耗時; 模型耗時 = 結果.模型耗時;
    回傳 (!有人物 && 長度(關鍵點) == 0) || (有人物 && 長度(關鍵點) == 165);
};
變數 可見程度 = 函式(項) {
    如果 (!有人物) { 回傳 0.0d; }
    變數 橫 = 關鍵點[項 * 5]; 變數 縱 = 關鍵點[項 * 5 + 1];
    如果 (橫 < 0 || 橫 > 1 || 縱 < 0 || 縱 > 1) { 回傳 0.0d; }
    變數 可見 = 關鍵點[項 * 5 + 3]; 變數 存在 = 關鍵點[項 * 5 + 4];
    如果 (可見 < 存在) { 回傳 可見; }
    回傳 存在;
};
