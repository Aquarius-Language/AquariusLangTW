# 平台繪圖協定集中於此；專案函式、變數及使用者介面均採繁體中文。
變數 繪圖 = 匯入("Processing");
變數 視窗 = 匯入("Window");
變數 影像工具 = 匯入("Images");
變數 建立空白影像 = 函式() { 回傳 影像工具.建立(1, 1, [0, 0, 0, 255]); };
變數 開啟視窗 = 函式() { 繪圖.尺寸(1040, 760, "P2D", "星泉姿態觀測站"); };
變數 寬度 = 函式() { 回傳 繪圖.width; };
變數 高度 = 函式() { 回傳 繪圖.height; };
變數 滑鼠橫座標 = 函式() { 回傳 繪圖.mouseX; };
變數 滑鼠縱座標 = 函式() { 回傳 繪圖.mouseY; };
變數 註冊點擊 = 函式(處理) { 繪圖.註冊事件("mousePressed", 處理); };
變數 註冊錯誤 = 函式(處理) { 繪圖.註冊事件("error", 處理); };
變數 轉為繪圖圖片 = 函式(影像) { 回傳 視窗.轉為Processing圖片(影像); };
