<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>AquariusLang.Compiler</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="application/portable.mjs" LogicalName="AquariusLang.Hosting.application-core.mjs" />
    <EmbeddedResource Include="hosting/*.mjs" Exclude="hosting/vendor-earcut*;hosting/application-core.mjs;hosting/audio-core.mjs;hosting/physics-core.mjs" LogicalName="AquariusLang.Hosting.%(Filename)%(Extension)" />
    <EmbeddedResource Include="hosting/*.wasm;hosting/*.txt" Exclude="hosting/vendor-earcut*" LogicalName="AquariusLang.Hosting.%(Filename)%(Extension)" />
    <EmbeddedResource Include="mediapipe/pose.wasm" LogicalName="AquariusLang.External.mediapipe.pose.wasm" />
    <EmbeddedResource Include="graphics/*.aqua" LogicalName="AquariusLang.Graphics.%(Filename)%(Extension)" />
    <EmbeddedResource Include="wasm/runtime/runtime.wasm" LogicalName="AquariusLang.Wasm.runtime.wasm" />
    <EmbeddedResource Include="external/onnx/ort.webgpu.min.mjs;external/onnx/ort-wasm-simd-threaded.asyncify.mjs;external/onnx/ort-wasm-simd-threaded.asyncify.wasm;external/onnx/LICENSE.txt;external/onnx/ThirdPartyNotices.txt" LogicalName="AquariusLang.External.onnx.%(Filename)%(Extension)" />
    <EmbeddedResource Include="audio/audio.wasm;audio/audio-core.mjs;audio/AUDIO-THIRD-PARTY-NOTICES.txt" LogicalName="AquariusLang.External.audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="graphics/geometry.wasm" LogicalName="AquariusLang.External.geometry.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../native/vendor/miniaudio/LICENSE" LogicalName="AquariusLang.External.audio.MINIAUDIO-LICENSE.txt" />
  </ItemGroup>
</Project>
