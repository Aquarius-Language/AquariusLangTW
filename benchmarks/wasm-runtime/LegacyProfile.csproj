<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);LEGACY</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/legacy/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="AquariusLangVM"><HintPath>$(AquariusLegacyRelease)/AquariusLangVM.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="CheckLegacyRelease" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AquariusLegacyRelease)/AquariusLangVM.dll')" Text="Set AquariusLegacyRelease to the preserved VM release directory." />
  </Target>
</Project>
