<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aqua</AssemblyName>
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">../AquariusDesktop/application.manifest</ApplicationManifest>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AquariusBottle/AquariusBottle.csproj" />
    <ProjectReference Include="../AquariusBuild/AquariusBuild.csproj" />
    <ProjectReference Include="../AquariusAndroid/AquariusAndroid.csproj" />
    <ProjectReference Include="../AquariusPackaging/AquariusPackaging.csproj" />
    <ProjectReference Include="../AquariusDesktop/AquariusDesktop.csproj" />
    <ProjectReference Include="../AquariusWebCompiler/AquariusWebCompiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../AquariusCore/linking/aquarius_library.h" Link="include/aquarius_library.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../build-targets/**/*" Exclude="../build-targets/.aquarius-*/**/*" Link="build-targets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
