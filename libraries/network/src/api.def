FUNCTION(stream_operation, operation_cancel, "Cancel", "取消", "")
FUNCTION(stream_operation, operation_poll, "Poll", "輪詢", "")
FUNCTION(stream_operation, operation_wait, "Wait", "等待", "")
FUNCTION(stream_operation, operation_close, "Close", "關閉", "")

