/* The Network|網路 module as AquariusCore/network/NetworkCatalog.cs described it: every class, function and field
   with its English and Traditional Chinese name and its argument signature (aqua.h). network.c expands this table to
   register everything and network.h to number classes and fields.

     CLASS(id, "Type name", release)                     a class of objects; release frees its payload
     NATIVE_CLASS(id, "Type name", release)              a class only targets with sockets create
     FUNCTION(class, c_function, "English", "中文", "signature")
     NATIVE(class, c_function, "English", "中文", "signature", "feature")
                                                         implemented where sockets exist (src/native); other targets
                                                         register a function failing "Unsupported / 不支援"
     FIELD(class, field, "English", "中文")              a value fixed when the object is made
     FUNCTION_ASYNC / NATIVE_ASYNC(...)                  as FUNCTION / NATIVE, plus a variant giving a promise at once
                                                         (aqua_define_async): "EnglishAsync" / "非同步中文"

   C functions take (aqua_call *call, const char *name), name being "Network.Class.Function" for error messages. */

/* Expansions that need no promise variant see the waiting function only. */
#if !defined(FUNCTION_ASYNC)
#define FUNCTION_ASYNC FUNCTION
#define NATIVE_ASYNC NATIVE
#define NETWORK_ASYNC_DEFAULT
#endif

CLASS(module, "Network|網路", release_nothing)
FUNCTION(module, net_try, "Try", "嘗試", "f")
FUNCTION(module, net_supports, "Supports", "支援", "s")
FUNCTION(module, net_capabilities, "Capabilities", "能力", "")
FUNCTION(module, net_create_client, "CreateClient", "建立用戶端", "|h")
FUNCTION_ASYNC(module, net_request, "Request", "請求", "ss|h")
FUNCTION_ASYNC(module, net_get, "Get", "取得", "s|h")
FUNCTION_ASYNC(module, net_post, "Post", "提交", "sv|h")
FUNCTION(module, net_start_request, "StartRequest", "開始請求", "ss|h")
FUNCTION(module, net_start_stream, "StartStream", "開始串流", "ss|h")
NATIVE_ASYNC(module, net_resolve_host, "Resolve", "解析主機", "s", "dns")
NATIVE_ASYNC(module, net_connect_tcp, "ConnectTCP", "連接傳輸控制", "si|h", "tcp")
NATIVE_ASYNC(module, net_connect_tls, "ConnectTLS", "連接安全傳輸", "si|h", "tls")
NATIVE(module, net_listen_tcp, "ListenTCP", "監聽傳輸控制", "si|h", "tcp-listen")
NATIVE(module, net_open_udp, "OpenUDP", "開啟資料報", "si|h", "udp")
FUNCTION_ASYNC(module, net_connect_websocket, "ConnectWebSocket", "連接網頁通訊端", "s|h")
NATIVE(module, net_listen, "Listen", "監聽", "s|h", "http-server")
FUNCTION(module, net_encode_query, "EncodeQuery", "編碼查詢", "h")
FUNCTION(module, net_parse_url, "ParseURL", "解析網址", "s")
FUNCTION(module, net_status, "StatusText", "狀態說明", "i")
FUNCTION(module, net_random_bytes, "RandomBytes", "隨機位元組", "i")
FUNCTION(module, net_page_origin, "PageOrigin", "頁面來源", "")
FUNCTION(module, net_text_to_bytes, "TextToBytes", "文字轉位元組", "s")
FUNCTION(module, net_bytes_to_text, "BytesToText", "位元組轉文字", "a")
NATIVE_ASYNC(module, net_listen_and_serve, "ListenAndServe", "監聽並服務", "s|hh", "http-server")

