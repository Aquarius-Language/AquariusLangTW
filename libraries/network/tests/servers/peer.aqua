# The peer server of web_client.aqua (native): run it, then the client on any target, browsers included.
變數 網路 = 匯入("網路");
變數 字串 = 匯入("字串");
變數 伺服器 = 網路.監聽("http://127.0.0.1:18790");
伺服器.跨來源(["*"]);
伺服器.處理("GET", "/hello/{名稱}", 函式(請求, 回應) { 回應.文字("你好，" + 請求.路由參數("名稱")); });
伺服器.處理("POST", "/echo", 函式(請求, 回應) { 回應.回傳JSON({"收到":請求.解析JSON(), "方法":請求.方法}); });
伺服器.處理("GET", "/status", 函式(請求, 回應) { 回應.狀態(422); 回應.回傳JSON({"錯誤":"示範"}); });
伺服器.處理("GET", "/bytes", 函式(請求, 回應) { 回應.寫入位元組([0, 255, 1, 2]); });
伺服器.處理("GET", "/events", 函式(請求, 回應) {
    回應.事件("message", "星泉", "1");
    回應.事件("done", "完成");
});
伺服器.處理("GET", "/slow", 函式(請求, 回應) {
    網路.監聽傳輸控制("127.0.0.1", 0).接受(1500);
    回應.文字("late");
});
伺服器.處理("GET", "/socket", 函式(請求, 回應) {
    變數 通訊端 = 回應.升級網頁通訊端();
    變數 訊息 = 通訊端.接收();
    迴圈 (變數 i = 0; i < 10 && !訊息.已關閉; i++) {
        如果 (訊息.是文字) { 通訊端.傳送文字("回聲：" + 訊息.文字); } 否則 { 通訊端.傳送位元組(訊息.資料); }
        訊息 = 通訊端.接收();
    }
});
伺服器.處理("GET", "/stop", 函式(請求, 回應) { 回應.文字("stopping"); 伺服器.關閉(); });
印出("peer ready", 伺服器.位址);
伺服器.服務();
