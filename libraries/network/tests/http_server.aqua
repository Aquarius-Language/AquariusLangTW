伺服器.處理("GET", "/events", 函式(請求, 回應) {
    回應.事件("message", "第一" + 換行 + "第二", "1");
    回應.事件("done", "完成");
});
變數 用戶端 = 網路.建立用戶端({"逾時":5000});
變數 請 = 函式(方法, 路徑, 選項) {
    變數 操作 = 用戶端.開始請求(方法, 位址 + 路徑, 選項);
    伺服器.處理下一筆(5000);
    回傳 操作.等待();
};
變數 回應 = 請("GET", "/hello/星泉", {});
印出("路由", 回應.狀態碼, 回應.本文, 回應.取得標頭("x-test"), 回應.成功, 回應.錯誤);
回應 = 請("GET", "/files/a/b.txt", 空);
印出("萬用", 回應.本文);
回應 = 請("GET", "/blocked", 空);
印出("中介", 回應.狀態碼, 回應.本文);
回應 = 請("POST", "/echo", {"JSON":{"訊息":"繁體", "陣列":[1, 2.5d, 真, 空]}});
印出("JSON", 回應.狀態碼, 回應.解析JSON());
回應 = 請("POST", "/form", {"表單":{"a":"1 2", "名":"星泉"}});
印出("表單", 回應.解析JSON());
回應 = 請("GET", "/query?a=1&b=%E6%98%9F+%E6%B3%89", 空);
印出("查詢", 字串.取代(回應.本文, 位址, ""));
回應 = 請("GET", "/set", 空);
印出("設定Cookie", 回應.標頭["Set-Cookie"]);
印出("Cookie", 請("GET", "/cookie", 空).本文);
用戶端.清除Cookie();
印出("清除後", 請("GET", "/cookie", 空).本文);
印出("工作階段", 請("GET", "/session", 空).解析JSON()["次數"], 請("GET", "/session", 空).解析JSON()["次數"]);
回應 = 請("GET", "/fail", 空);
印出("失敗", 回應.狀態碼, 回應.本文);
印出("仍正常", 請("GET", "/hello/仍然", 空).本文);
回應 = 請("GET", "/nothing", 空);
印出("找不到", 回應.狀態碼, 回應.本文);
回應 = 請("POST", "/hello/x", 空);
印出("方法", 回應.狀態碼, 回應.取得標頭("Allow"), 回應.本文);
變數 導向 = 用戶端.開始請求("GET", 位址 + "/redirect");
伺服器.處理下一筆(5000);
伺服器.處理下一筆(5000);
回應 = 導向.等待();
印出("重新導向", 回應.狀態碼, 回應.本文, 字串.取代(回應.網址, 位址, ""));
回應 = 請("GET", "/redirect", {"跟隨重新導向":假});
印出("手動導向", 回應.狀態碼, 回應.取得標頭("location"), 回應.成功);
回應 = 請("GET", "/status", 空);
印出("HTTP錯誤", 回應.狀態碼, 回應.成功, 回應.錯誤.種類, 回應.錯誤.訊息, 回應.錯誤.可重試, 回應.解析JSON()["錯誤"]);
回應 = 請("GET", "/large", {"本文上限":2});
印出("上限", 回應.狀態碼, 回應.錯誤.種類, 回應.錯誤.訊息);
回應 = 用戶端.請求("GET", 位址 + "/late", {"逾時":300});
印出("逾時", 回應.狀態碼, 回應.錯誤.種類, 回應.錯誤.訊息, 回應.錯誤.可重試);
印出("排隊的請求", 伺服器.處理下一筆(1000));
變數 取消 = 用戶端.開始請求("GET", 位址 + "/late");
印出("輪詢", 取消.輪詢(), 取消.已完成());
取消.取消();
回應 = 取消.等待();
印出("取消", 回應.錯誤.種類, 回應.錯誤.訊息, 取消.已完成());
取消.關閉();
取消.關閉();
伺服器.處理下一筆(1000);
回應 = 請("GET", "/hello/x", {"標頭":{"Origin":"https://untrusted.example"}});
印出("來源", 回應.狀態碼, 回應.本文);
伺服器.跨來源(["https://trusted.example"]);
回應 = 請("GET", "/hello/x", {"標頭":{"Origin":"https://trusted.example"}});
印出("跨來源", 回應.狀態碼, 回應.取得標頭("Access-Control-Allow-Origin"), 回應.取得標頭("Access-Control-Allow-Credentials"), 回應.取得標頭("Vary"));
回應 = 請("OPTIONS", "/echo", {"標頭":{"Origin":"https://trusted.example", "Access-Control-Request-Headers":"content-type"}});
印出("預檢", 回應.狀態碼, 回應.取得標頭("Access-Control-Allow-Methods"), 回應.取得標頭("Access-Control-Allow-Headers"));
伺服器.靜態檔案("/", "public");
回應 = 請("GET", "/", 空);
印出("靜態", 回應.狀態碼, 字串.修剪(回應.本文), 回應.取得標頭("content-type"), 長度(回應.取得標頭("etag")));
回應 = 請("GET", "/", {"標頭":{"If-None-Match":回應.取得標頭("etag")}});
印出("未修改", 回應.狀態碼, 回應.本文);
印出("子目錄", 請("GET", "/sub/style.css", 空).取得標頭("content-type"));
印出("穿越", 請("GET", "/%2e%2e/http_server.aqua", 空).狀態碼, 請("GET", "/sub/..%2fhttp_server.aqua", 空).狀態碼);
回應 = 請("GET", "/gzip", 空);
印出("gzip", 回應.狀態碼, 長度(回應.取得位元組()), 回應.取得標頭("content-encoding"), 字串.包含(回應.本文, "第199行 value"));
回應 = 請("GET", "/deflate", 空);
印出("deflate", 長度(回應.取得位元組()), 字串.包含(回應.本文, "第0行 value 0"));
變數 串流 = 用戶端.開始串流("GET", 位址 + "/events");
印出("串流前", 串流.狀態碼(), 串流.讀取行());
伺服器.處理下一筆(5000);
回應 = 串流.等待();
印出("串流", 串流.狀態碼(), 串流.讀取行(), 回應.取得標頭("content-type"), 回應.取得標頭("cache-control"));
印出("串流本文", 字串.取代(回應.本文, 換行, "|"));
伺服器.關閉();
印出("關閉後", 網路.嘗試(函式() { 回傳 伺服器.處理下一筆(0); }).錯誤.訊息);
用戶端.關閉();
印出("用戶端關閉後", 用戶端.取得(位址 + "/hello/x").錯誤.種類);
