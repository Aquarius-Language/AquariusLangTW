# needs: sockets (Windows, Linux, Android); run from libraries/network/tests (serves public/)
# HTTP server and client round trips on loopback: routes, middleware, JSON, forms, queries, cookies, sessions,
# redirects, errors, limits, timeouts, cancellation, CORS, static files, compressed bodies and Server-Sent Events.
變數 網路 = 匯入("網路");
變數 字串 = 匯入("字串");
變數 空 = [][0];
變數 換行 = 字串.從字元碼(10);
變數 伺服器 = 網路.監聽("http://127.0.0.1:0");
變數 位址 = 伺服器.位址;
伺服器.使用中介(函式(請求, 回應) { 回應.設定標頭("X-Test", "middleware"); });
伺服器.使用中介(函式(請求, 回應) {
    如果 (請求.路徑 == "/blocked") { 回應.狀態(401); 回應.文字("blocked"); 回傳 假; }
});
伺服器.處理("GET", "/hello/{名稱}", 函式(請求, 回應) { 回應.文字("你好，" + 請求.路由參數("名稱")); });
伺服器.處理("GET", "/files/*", 函式(請求, 回應) { 回應.文字(請求.路由參數("*")); });
伺服器.處理("POST", "/echo", 函式(請求, 回應) {
    回應.回傳JSON({"收到":請求.解析JSON(), "方法":請求.方法, "類型":請求.取得標頭("content-type")});
});
伺服器.處理("POST", "/form", 函式(請求, 回應) { 回應.回傳JSON(請求.表單()); });
伺服器.處理("GET", "/query", 函式(請求, 回應) { 回應.文字(請求.查詢("b") + "|" + 請求.查詢("沒有") + "|" + 請求.網址); });
伺服器.處理("GET", "/set", 函式(請求, 回應) { 回應.設定Cookie("token", "值 1"); 回應.文字("set"); });
伺服器.處理("GET", "/cookie", 函式(請求, 回應) { 回應.文字("[" + 請求.取得Cookie("token") + "]"); });
伺服器.處理("GET", "/session", 函式(請求, 回應) {
    變數 工作階段 = 請求.工作階段();
    變數 次數 = 工作階段.取得("次數");
    如果 (次數 == 空) { 次數 = 0; }
    工作階段.設定("次數", 次數 + 1);
    回應.回傳JSON({"次數":次數 + 1});
});
伺服器.處理("GET", "/fail", 函式(請求, 回應) { 回傳 網路.解析網址("壞"); });
伺服器.處理("GET", "/redirect", 函式(請求, 回應) { 回應.重新導向("/hello/導向"); });
伺服器.處理("GET", "/status", 函式(請求, 回應) { 回應.狀態(422); 回應.回傳JSON({"錯誤":"示範"}); });
伺服器.處理("GET", "/large", 函式(請求, 回應) { 回應.寫入位元組([1, 2, 3, 4, 5, 6, 7, 8]); });
伺服器.處理("GET", "/late", 函式(請求, 回應) { 回應.文字("late"); });
