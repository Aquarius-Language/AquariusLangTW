# needs: sockets (Windows, Linux, Android)
# Raw TCP streams (binary, text, end of stream, closed resources), listeners, UDP datagrams and DNS on loopback.
變數 網路 = 匯入("網路");
變數 監聽 = 網路.監聽傳輸控制("127.0.0.1", 0, {"逾時":3000});
印出("監聽", 匯入("字串").開頭是(監聽.本機位址, "127.0.0.1:"), 監聽.接受(0));
變數 埠 = 網路.解析網址("tcp://" + 監聽.本機位址).連接埠;
變數 用戶 = 網路.連接傳輸控制("127.0.0.1", 埠, {"逾時":3000});
變數 服務 = 監聽.接受(2000);
印出("位址", 用戶.遠端位址 == 監聽.本機位址, 服務.本機位址 == 監聽.本機位址, 服務.遠端位址 == 用戶.本機位址);
用戶.寫入([0, 255, 1, 42]);
印出("位元組", 服務.讀取(4));
服務.寫入文字("星泉");
印出("文字", 用戶.讀取文字(64));
用戶.結束寫入();
印出("結束", 服務.讀取(4));
用戶.關閉();
用戶.關閉();
印出("已關閉", 網路.嘗試(函式() { 回傳 用戶.讀取(1); }).錯誤.訊息);
印出("讀取大小", 網路.嘗試(函式() { 回傳 服務.讀取(0); }).錯誤.訊息);
印出("寫入型別", 網路.嘗試(函式() { 回傳 服務.寫入([300]); }).錯誤.訊息);
印出("對方關閉後", 服務.讀取(1));
服務.關閉();
印出("接受逾時", 監聽.接受(100), 網路.嘗試(函式() { 回傳 監聽.接受(-1); }).錯誤.訊息);
監聽.關閉();
印出("監聽關閉", 網路.嘗試(函式() { 回傳 監聽.接受(0); }).錯誤.訊息);
印出("連接埠", 網路.嘗試(函式() { 回傳 網路.連接傳輸控制("127.0.0.1", 0); }).錯誤.訊息);
印出("拒絕", 匯入("字串").開頭是(網路.嘗試(函式() { 回傳 網路.連接傳輸控制("127.0.0.1", 埠, {"逾時":10000}); }).錯誤.訊息,
    "Network.ConnectTCP: Network: Connection refused / 連線遭拒。 (127.0.0.1:"));
印出("IP", 網路.嘗試(函式() { 回傳 網路.監聽傳輸控制("not-an-ip", 0); }).錯誤.訊息);
變數 甲 = 網路.開啟資料報("127.0.0.1", 0);
變數 乙 = 網路.開啟資料報("127.0.0.1", 0, {"逾時":2000});
變數 乙埠 = 網路.解析網址("udp://" + 乙.本機位址).連接埠;
甲.傳送("127.0.0.1", 乙埠, [1, 0, 255]);
變數 封包 = 乙.接收(16);
印出("資料報", 封包.資料, 封包.位址, 封包.連接埠 == 網路.解析網址("udp://" + 甲.本機位址).連接埠);
甲.傳送("localhost", 乙埠, "星泉");
封包 = 乙.接收();
印出("文字資料報", 封包.文字);
甲.傳送("127.0.0.1", 乙埠, {"json":真});
印出("JSON資料報", 乙.接收().文字);
甲.傳送("127.0.0.1", 乙埠, "1234567890");
印出("過大", 網路.嘗試(函式() { 回傳 乙.接收(2); }).錯誤.訊息);
印出("傳送上限", 網路.嘗試(函式() { 回傳 甲.傳送("127.0.0.1", 乙埠, 匯入("陣列").建立(65508, 0)); }).錯誤.訊息);
甲.設定廣播(真);
印出("多點傳送", 網路.嘗試(函式() { 甲.加入多點傳送("239.255.0.1"); 甲.離開多點傳送("239.255.0.1"); 回傳 真; }).成功);
甲.關閉();
乙.關閉();
印出("資料報關閉", 網路.嘗試(函式() { 回傳 甲.接收(); }).錯誤.訊息);
變數 位址們 = 網路.解析主機("localhost");
印出("DNS", 長度(位址們) > 0, 網路.解析主機("127.0.0.1"));
印出("DNS失敗", 網路.嘗試(函式() { 回傳 網路.解析主機("does-not-exist.invalid"); }).錯誤.訊息);
