# needs: the peer server (servers/peer.aqua serving http://127.0.0.1:18790); runs on every target, the web included
# HTTP, streams and WebSocket against a server in another process: the same output natively and in a browser.
變數 網路 = 匯入("網路");
變數 位址 = "http://127.0.0.1:18790";
變數 回應 = 網路.取得(位址 + "/hello/星泉");
印出("取得", 回應.狀態碼, 回應.本文, 回應.成功, 回應.錯誤);
回應 = 網路.請求("POST", 位址 + "/echo", {"JSON":{"訊息":"繁體", "數字":[1, 2.5d]}});
印出("JSON", 回應.狀態碼, 回應.解析JSON(), 回應.取得標頭("content-type"));
回應 = 網路.提交(位址 + "/echo", {"雜湊":"本文"});
印出("提交", 回應.解析JSON()["收到"]);
回應 = 網路.取得(位址 + "/status");
印出("錯誤", 回應.狀態碼, 回應.成功, 回應.錯誤.種類, 回應.錯誤.訊息, 回應.錯誤.可重試);
印出("位元組", 網路.取得(位址 + "/bytes").取得位元組());
回應 = 網路.取得(位址 + "/slow", {"逾時":300});
印出("逾時", 回應.狀態碼, 回應.錯誤.種類, 回應.錯誤.訊息);
變數 操作 = 網路.開始請求("GET", 位址 + "/hello/操作");
印出("操作", 操作.等待().本文, 操作.已完成());
變數 取消 = 網路.開始請求("GET", 位址 + "/slow");
取消.取消();
印出("取消", 取消.等待().錯誤.種類);
變數 串流 = 網路.開始串流("GET", 位址 + "/events");
回應 = 串流.等待();
印出("串流", 串流.狀態碼(), 串流.讀取行(), 回應.成功);
變數 通訊端 = 網路.連接網頁通訊端("ws://127.0.0.1:18790/socket", {"逾時":5000});
通訊端.傳送文字("你好");
變數 訊息 = 通訊端.接收();
印出("文字", 訊息.文字, 訊息.是文字, 訊息.已關閉);
通訊端.傳送位元組([0, 255, 7]);
訊息 = 通訊端.接收();
印出("位元組", 訊息.資料, 訊息.是文字);
通訊端.關閉();
印出("關閉後", 網路.嘗試(函式() { 回傳 通訊端.傳送文字("x"); }).錯誤.訊息);
印出("錯誤網址", 網路.嘗試(函式() { 回傳 網路.連接網頁通訊端("http://127.0.0.1:18790/socket"); }).錯誤.訊息);
變數 協定通訊端 = 等待 網路.非同步連接網頁通訊端("ws://127.0.0.1:18790/protocol", {"逾時":5000, "子協定":["v2", "chat"]});
變數 協定訊息 = 協定通訊端.接收().文字;
協定通訊端.關閉();
印出("子協定", 協定通訊端.子協定, 協定訊息);
