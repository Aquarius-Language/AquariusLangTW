# needs: sockets (Windows, Linux, Android)
# WebSocket client and server upgrade on loopback: text, binary, fragments of the protocol handled by the engine,
# closing handshake, closed sockets, message limits and failed handshakes. Serve runs handlers concurrently, so a
# handler may be the client of another route.
變數 網路 = 匯入("網路");
變數 字串 = 匯入("字串");
變數 伺服器 = 網路.監聽("http://127.0.0.1:0");
變數 位址 = 伺服器.位址;
變數 通訊端位址 = 字串.取代(位址, "http:", "ws:");
變數 伺服器看到的關閉 = [][0];
伺服器.處理("GET", "/socket", 函式(請求, 回應) {
    變數 通訊端 = 回應.升級網頁通訊端();
    變數 訊息 = 通訊端.接收();
    印出("伺服器收到", 訊息.文字, 訊息.是文字, 訊息.已關閉);
    通訊端.傳送位元組([0, 255]);
    訊息 = 通訊端.接收();
    印出("伺服器收到", 訊息.資料, 訊息.是文字);
    通訊端.傳送文字("再見");
    變數 關閉 = 通訊端.接收();
    伺服器看到的關閉 = [關閉.已關閉, 關閉.資料, 關閉.文字 == ""];
});
伺服器.處理("GET", "/big", 函式(請求, 回應) {
    變數 通訊端 = 回應.升級網頁通訊端();
    通訊端.傳送文字("0123456789");
    通訊端.接收();
});
伺服器.處理("GET", "/run", 函式(請求, 回應) {
    印出("非升級", 網路.嘗試(函式() { 回傳 回應.升級網頁通訊端(); }).錯誤.訊息);
    變數 用戶 = 網路.連接網頁通訊端(通訊端位址 + "/socket", {"標頭":{"X-Client":"aquarius"}});
    用戶.傳送文字("你好");
    變數 回覆 = 用戶.接收();
    印出("用戶收到", 回覆.資料, 回覆.是文字);
    用戶.傳送位元組([1, 2, 3]);
    印出("用戶收到", 用戶.接收().文字);
    用戶.關閉(1000, "完成");
    用戶.關閉();
    印出("用戶關閉後", 網路.嘗試(函式() { 回傳 用戶.接收(); }).錯誤.訊息);
    變數 小 = 網路.連接網頁通訊端(通訊端位址 + "/big", {"本文上限":4});
    印出("傳送上限", 網路.嘗試(函式() { 回傳 小.傳送文字("12345"); }).錯誤.訊息);
    印出("接收上限", 網路.嘗試(函式() { 回傳 小.接收(); }).錯誤.訊息);
    小.關閉();
    印出("握手失敗", 網路.嘗試(函式() { 回傳 網路.連接網頁通訊端(通訊端位址 + "/nothing"); }).錯誤.訊息);
    變數 另一 = 網路.連接網頁通訊端(通訊端位址 + "/big");
    印出("關閉代碼", 網路.嘗試(函式() { 回傳 另一.關閉(1005); }).錯誤.訊息);
    另一.關閉();
    回應.文字("完成");
    伺服器.關閉();
});
變數 操作 = 網路.開始請求("GET", 位址 + "/run", {"逾時":20000});
伺服器.服務();
印出("服務結束", 操作.等待().本文);
印出("伺服器收到關閉", 伺服器看到的關閉);
