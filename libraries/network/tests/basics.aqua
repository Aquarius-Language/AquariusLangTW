# Module, aliases, capabilities, URLs, query encoding, option validation and Try: the same on every target.
變數 網路 = 匯入("網路");
變數 net = 匯入("Network");
變數 原生 = !是網頁();
印出("模組", 網路.平台 == net.Platform, 網路.契約版本, 網路.Get == 網路.取得, 網路.請求 == net.Request);
印出("支援", 網路.支援("http"), 網路.支援("超文字傳輸"), 網路.支援("HTTP"), 網路.支援("Cookie"), 網路.支援("串流傳輸"), 網路.支援("網頁通訊端"), 網路.支援("nothing"));
印出("原生能力", 網路.支援("tcp") == 原生, 網路.支援("傳輸層安全") == 原生, 網路.支援("udp") == 原生, 網路.支援("dns") == 原生,
    網路.支援("tcp-listen") == 原生, 網路.支援("網頁伺服器") == 原生, 網路.支援("Cookie管理") == 原生);
變數 能力 = 網路.能力();
印出("能力", 長度(能力), 能力["http"], 能力["超文字傳輸"], 能力["串流傳輸"], 能力["udp"] == 原生);
變數 網址 = 網路.解析網址("https://Example.com:8443/路徑/./a/../b?a=b c#片段");
印出("網址", 網址.協定, 網址.主機, 網址.連接埠, 網址.路徑, 網址.查詢字串, 網址.片段);
網址 = 網路.解析網址("http://[::1]/");
印出("IPv6", 網址.Scheme, 網址.Host, 網址.Port, 網址.Path, 網址.Query == "", 網址.Fragment == "");
網址 = 網路.解析網址("wss://user:secret@example.com");
印出("預設連接埠", 網址.協定, 網址.主機, 網址.連接埠, 網址.路徑);
印出("其他協定", 網路.解析網址("mailto:someone@example.com").連接埠, 網路.解析網址("ftp://example.com/a").連接埠);
印出("無效網址", 網路.嘗試(函式() { 回傳 網路.解析網址("沒有協定"); }).錯誤.訊息);
印出("查詢", 網路.編碼查詢({"訊息":"星泉 空白", "a&b":"1=2", "符號":"-._~!*'()"}));
印出("查詢錯誤", 網路.嘗試(函式() { 回傳 網路.編碼查詢({"數字":1}); }).錯誤.訊息);
變數 成功 = 網路.嘗試(函式() { 回傳 42; });
印出("嘗試", 成功.成功, 成功.值, 成功.錯誤, 網路.嘗試(函式() { 印出("沒有回傳值"); }).值);
變數 失敗 = 網路.嘗試(函式() { 回傳 網路.取得("http://localhost/", {"逾時":0}); });
印出("失敗", 失敗.Success, 失敗.Value, 失敗.Error.Kind, 失敗.Error.Retryable);
印出(失敗.錯誤.訊息);
變數 選項錯誤 = 函式(選項) { 回傳 網路.嘗試(函式() { 回傳 網路.開始請求("GET", "http://localhost/", 選項); }).錯誤.訊息; };
印出(選項錯誤({"本文上限":0}));
印出(選項錯誤({"重新導向上限":21}));
印出(選項錯誤({"逾時":1.5d}));
印出(選項錯誤({"標頭":{"X-Test":"a
Injected: yes"}}));
印出(選項錯誤({"標頭":{"Bad:Name":"x"}}));
印出(選項錯誤({"標頭":{"X-Number":1}}));
印出(選項錯誤({"認證":"bad"}));
印出(選項錯誤({"跟隨重新導向":"yes"}));
印出(選項錯誤({"本文":"12345", "本文上限":4}));
印出(選項錯誤({"本文":[0, 256]}));
變數 回應 = 網路.取得("file:///secret");
印出("非HTTP", 回應.成功, 回應.狀態碼, 回應.錯誤.種類, 回應.錯誤.訊息, 回應.網址, 回應.本文 == "", 長度(回應.標頭));
印出("無效網址回應", 網路.請求("GET", "壞網址").錯誤.訊息);
印出("WebSocket網址", 網路.嘗試(函式() { 回傳 網路.連接網頁通訊端("http://localhost/"); }).錯誤.訊息);
變數 用戶端 = 網路.建立用戶端({"逾時":1000, "標頭":{"X-Client":"1"}});
用戶端.關閉();
用戶端.關閉();
印出("已關閉用戶端", 用戶端.取得("http://localhost/").錯誤.種類, 用戶端.取得("http://localhost/").錯誤.訊息);
如果 (原生) {
    印出("網頁限定", 真);
} 否則 {
    印出("網頁限定", 網路.嘗試(函式() { 回傳 網路.連接傳輸控制("localhost", 80); }).錯誤.訊息 == "Network.ConnectTCP: Unsupported: Unsupported / 不支援：web / tcp");
}
# Promise variants (aqua_define_async) and status texts exist on every target.
印出("非同步", 網路.GetAsync == 網路.非同步取得, 型別(net.RequestAsync), 網路.狀態說明(404), net.StatusText(201));
變數 失敗 = 等待 網路.非同步取得("http://127.0.0.1:1/", {"逾時":3000});
印出("非同步回應", 失敗.狀態碼, 失敗.成功);
變數 拒絕 = 等待 承諾.全部結算([net.ConnectWebSocketAsync("http://example.com")]);
印出("非同步拒絕", 拒絕[0]["status"]);
