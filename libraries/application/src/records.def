RECORD_FIELD(schema) RECORD_FIELD(value) RECORD_FIELD(ok) RECORD_FIELD(error)
RECORD_FIELD(text) RECORD_FIELD(selection) RECORD_FIELD(composition)
RECORD_FIELD(image) RECORD_FIELD(multiple)
