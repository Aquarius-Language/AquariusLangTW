FUNCTION(files, ReadBytes, "讀取位元組", "o")
FUNCTION(files, ReadText, "讀取文字", "os")
FUNCTION(files, SaveBytes, "儲存位元組", "oa|b")
FUNCTION(files, SaveText, "儲存文字", "oss|b")
FUNCTION(files, Enumerate, "列舉", "o")
FUNCTION(files, CreateDirectory, "建立目錄", "o")
FUNCTION(files, Delete, "刪除", "o|b")
FUNCTION(files, Copy, "複製", "oo|b")
FUNCTION(files, Move, "移動", "oo|b")
FUNCTION(files, Temporary, "暫存", "b")
FUNCTION(files, Open, "開啟", "os")
FUNCTION(files, ReadAssetBytes, "讀取資產位元組", "s")
FUNCTION(files, ReadAssetText, "讀取資產文字", "ss")

