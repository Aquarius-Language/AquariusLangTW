/* Every module, class and member the application library registers: names, Traditional Chinese aliases and argument
 * signatures of the old ApplicationCatalog. library.c expands the table into wrappers and registrations; each
 * FUNCTION(owner, Name, ...) is implemented by `void app_<owner>_<Name>(aqua_call *call)` in the owner's source file.
 *   MODULE(owner, "Names")                         a module, imported by any of its names
 *   CLASS(owner, "type")                           a class of native objects (stream, editor, ...)
 *   FUNCTION(owner, Name, "別名", "signature")     signature kinds as in aqua.h ("" none, "o|b" optional ...)
 *   PROPERTY(owner, name, getter)                  a field read on every access */

MODULE(files, "Files")
FUNCTION(files, Capabilities, "功能支援", "")
FUNCTION(files, Resolve, "解析資源", "s")
