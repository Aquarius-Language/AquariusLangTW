# (web only) persistent:/ resources in IndexedDB, download:/ saves, and Storage keys as settings/ records.
var files = import("Files");
var storage = import("Storage");
var root = files.Resolve("persistent:/notes");
print(root.id, root.name, root.kind, root.persistentIdentity, files.Stat(root).exists);
files.CreateDirectory(root);
var note = files.Resolve("persistent:/notes/first.txt");
print(files.SaveText(note, "繁體 😀", "utf-8", true), files.ReadText(note, "utf-8"));
var stat = files.Stat(note);
print(stat.exists, stat.kind, stat.length, typeOf(stat.modified), files.Stat(root).kind);
files.SaveBytes(files.Resolve("persistent:/notes/sub/deep.bin"), [1, 2]);
files.CreateDirectory(files.Resolve("persistent:/notes/sub"));
var list = files.Enumerate(root);
print(len(list), list[0].name, list[0].kind, list[1].name, list[1].kind);
files.Copy(root, files.Resolve("persistent:/copy"));
print(files.ReadBytes(files.Resolve("persistent:/copy/sub/deep.bin")), files.ReadText(files.Resolve("persistent:/copy/first.txt"), "utf-8"));
files.Move(files.Resolve("persistent:/copy"), files.Resolve("persistent:/moved"));
print(files.Stat(files.Resolve("persistent:/copy")).exists, files.Stat(files.Resolve("persistent:/moved/sub/deep.bin")).length);
var stream = files.Open(note, "Append");
stream.Write([33]);
stream.Close();
print(files.ReadText(note, "utf-8"));
storage.Write("key.one", [5, 6]);
var settings = files.Enumerate(storage.SettingsDirectory());
print(settings[0].name, files.ReadBytes(settings[0]));
var download = files.Resolve("download:/report.txt");
print(download.persistentIdentity, files.SaveText(download, "saved", "utf-8"), files.ReadText(download, "utf-8"));
files.Delete(files.Resolve("persistent:/moved"), true);
print(files.Stat(files.Resolve("persistent:/moved")).exists);
files.Delete(root);
