/* Keyboard shortcuts of the platforms' own applications, as COMMAND(name, key, modifiers, where).
 * key: a GLFW key code. modifiers: PRIMARY (Control, or Command on Apple targets), CONTROL (the Control key itself),
 * SHIFT, ALT; the modifiers must match exactly (Caps Lock and Num Lock are ignored). where: ALL, APPLE (macOS, iOS) or
 * OTHERS (every other target). The first entry of a command on a platform is the one ShortcutLabel shows. */
COMMAND("copy",          'C',       PRIMARY,         ALL)
COMMAND("copy",          KEY_INSERT, CONTROL,        OTHERS)
COMMAND("cut",           'X',       PRIMARY,         ALL)
COMMAND("cut",           KEY_DELETE, SHIFT,          OTHERS)
COMMAND("paste",         'V',       PRIMARY,         ALL)
COMMAND("paste",         KEY_INSERT, SHIFT,          OTHERS)
COMMAND("undo",          'Z',       PRIMARY,         ALL)
COMMAND("redo",          'Z',       PRIMARY | SHIFT, ALL)
COMMAND("redo",          'Y',       PRIMARY,         OTHERS)
COMMAND("selectAll",     'A',       PRIMARY,         ALL)
COMMAND("find",          'F',       PRIMARY,         ALL)
COMMAND("findNext",      KEY_F3,    0,               OTHERS)
COMMAND("findNext",      'G',       PRIMARY,         APPLE)
COMMAND("findPrevious",  KEY_F3,    SHIFT,           OTHERS)
COMMAND("findPrevious",  'G',       PRIMARY | SHIFT, APPLE)
COMMAND("new",           'N',       PRIMARY,         ALL)
COMMAND("open",          'O',       PRIMARY,         ALL)
COMMAND("save",          'S',       PRIMARY,         ALL)
COMMAND("saveAs",        'S',       PRIMARY | SHIFT, ALL)
COMMAND("print",         'P',       PRIMARY,         ALL)
COMMAND("close",         'W',       PRIMARY,         ALL)
COMMAND("close",         KEY_F4,    CONTROL,         OTHERS)
COMMAND("quit",          'Q',       PRIMARY,         APPLE)
COMMAND("preferences",   ',',       PRIMARY,         ALL)
COMMAND("refresh",       KEY_F5,    0,               OTHERS)
COMMAND("refresh",       'R',       PRIMARY,         ALL)
COMMAND("zoomIn",        '=',       PRIMARY,         ALL)
COMMAND("zoomIn",        '=',       PRIMARY | SHIFT, ALL)
COMMAND("zoomIn",        KEY_KP_ADD, PRIMARY,        ALL)
COMMAND("zoomOut",       '-',       PRIMARY,         ALL)
COMMAND("zoomOut",       KEY_KP_SUBTRACT, PRIMARY,   ALL)
COMMAND("zoomReset",     '0',       PRIMARY,         ALL)
COMMAND("fullscreen",    KEY_F11,   0,               OTHERS)
COMMAND("fullscreen",    'F',       PRIMARY | CONTROL, APPLE)
COMMAND("help",          KEY_F1,    0,               OTHERS)
COMMAND("rename",        KEY_F2,    0,               OTHERS)
COMMAND("delete",        KEY_DELETE, 0,              ALL)
COMMAND("delete",        KEY_BACKSPACE, PRIMARY,     APPLE)
COMMAND("cancel",        KEY_ESCAPE, 0,              ALL)
COMMAND("activate",      KEY_ENTER, 0,               ALL)
COMMAND("activate",      KEY_KP_ENTER, 0,            ALL)
COMMAND("focusNext",     KEY_TAB,   0,               ALL)
COMMAND("focusPrevious", KEY_TAB,   SHIFT,           ALL)
COMMAND("nextTab",       KEY_TAB,   CONTROL,         ALL)
COMMAND("previousTab",   KEY_TAB,   CONTROL | SHIFT, ALL)
COMMAND("contextMenu",   KEY_MENU,  0,               OTHERS)
COMMAND("contextMenu",   KEY_F10,   SHIFT,           OTHERS)
COMMAND("back",          KEY_LEFT,  ALT,             OTHERS)
COMMAND("back",          '[',       PRIMARY,         APPLE)
COMMAND("forward",       KEY_RIGHT, ALT,             OTHERS)
COMMAND("forward",       ']',       PRIMARY,         APPLE)
