};

# The text as shown: a composition in progress sits at the caret; a password shows one bullet per character unit.
# Returns [text, caret position in it, composition start, composition end].
var Display = function(ed) {
    var text = ed.text;
    var caret = ed.caret;
    var from = caret;
    var to = caret;
    if (ed.composition != null) {
        text = String.Slice(text, 0, caret) + ed.composition + String.Slice(text, caret, len(text));
        to = caret + len(ed.composition);
        caret = caret + ed.compositionCursor;
    }
    if (ed.obscure) { text = String.Repeat("•", len(text)); }
    return [text, caret, from, to];
};
