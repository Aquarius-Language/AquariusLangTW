    restyle(e, {"flexDirection": if (row) { "row"; } else { "column"; }, "flexGrow": 1, "alignSelf": "stretch", "minWidth": 0, "minHeight": 0},
        selectorsOf("SplitView", null, w.class), w.style);
    var shown = if (w.collapsed == true) { "none"; } else { "flex"; };
    var size = splitSize(e);
    var first = {"flexShrink": 0, "display": shown};
    first[splitAxis(w)] = size;
    var line = {"flexShrink": 0, "display": shown};
    line[splitAxis(w)] = w.thickness;
    reconcile(e, [
        Box(child: Expanded(child: w.first), style: first, key: "first"),
        Box(class: "SplitLine", style: line, key: "line"),
        Box(child: Expanded(child: w.second), style: {"flexGrow": 1, "flexShrink": 1, "flexBasis": 0, "minWidth": 0, "minHeight": 0}, key: "second"),
        SplitHandle(row: row, at: size + w.thickness / 2.0d, hidden: w.collapsed == true, grip: w.grip, key: "grip"),
    ]);
    # The line lights up while the strip is hovered or dragged.
    var grip = e.children[3];
    var lit = Hash.Get(grip.data, "hover", false) == true || Hash.Get(grip.data, "drag", null) != null;
    var bar = e.children[1];
    if (Hash.Get(bar.data, "selected", false) != lit) { bar.data["selected"] = lit; update(bar, bar.widget); }
}, "layout": function(e) {
    # A view that changed size keeps its first pane within the limits at once (no frame with the old size).
    var w = e.widget;
