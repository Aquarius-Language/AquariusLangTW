        var e = path[i];
        if (e == owner) { return true; }
        if ((e.type == "DropdownMenu" || e.type == "MenuPopup") && e.widget.owner == owner) { return true; }
    }
    return false;
};

kinds["Dropdown"] = {"update": function(e, w) {
