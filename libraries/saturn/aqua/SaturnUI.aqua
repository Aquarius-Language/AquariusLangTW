}};
kinds["Image"] = {"update": function(e, w) {
    restyle(e, {"width": w.width, "height": w.height, "image": w.image, "objectFit": w.fit, "borderRadius": w.radius,
        "overflow": "hidden"}, selectorsOf("Image", null, w.class), w.style);
}};
kinds["Icon"] = {"update": function(e, w) {
    var size = w.size;
    restyle(e, {"width": size, "height": size, "flexShrink": 0}, ["Icon"], null);
