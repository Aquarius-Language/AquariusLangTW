            var previous = words[len(words) - 1];
            if (!String.EndsWith(previous.text, NBSP)) { previous.text = previous.text + NBSP; }
        }
        var parts = String.Split(span.text, " ");
        for (var k = 0; k < len(parts); k++) {
            if (len(parts[k]) == 0) { continue; }
            # The space after a word is a no-break space, so it keeps its width at the end of the word's box.
            var last = k == len(parts) - 1 && !String.EndsWith(span.text, " ");
            Array.Append(words, Text(text: if (last) { parts[k]; } else { parts[k] + NBSP; }, style: span.style, key: String.From(i) + ":" + String.From(k)));
        }
    }
    restyle(e, {"flexDirection": "row", "flexWrap": "wrap", "alignItems": "baseline"}, selectorsOf("RichText", null, w.class), w.style);
