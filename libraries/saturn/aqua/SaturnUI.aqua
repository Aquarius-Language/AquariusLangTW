# Overlays: dropdown menus, dialogs and tooltips live above the tree, in the surface's overlay layer.

# Popups: an open Dropdown or MenuBar is the surface's popup, and it is modal the way native menus are: a press
# outside it closes it and goes no further (nor does its release), the pointer hovers only inside it, the wheel
# scrolls nothing below it and keys go to it (Escape closes). Its kind gives "close"(e) and optionally "popupMove"(e,
# path), "popupRelease"(e, path, event) and "popupKey"(e, key).
var closePopup = function(s) {
    var e = s.popup;
    if (e == null) { return null; }
    s.popup = null;
