# Menus. A popup menu (MenuPopup) belongs to an owner element: a MenuBar (under its open title) or a text field (its
# context menu, at the pointer). The owner keeps the items shown ("menuItems") and the highlighted one ("active", -1 for
# none; the pointer and the arrow keys move the same highlight).
var menuItemAt = function(owner, path) {
    for (var i = 0; i < len(path); i++) {
        var parent = path[i].parent;
        if (parent != null && parent.type == "MenuPopup" && parent.widget.owner == owner) { return path[i].data["item"]; }
    }
    return null;
};
var menuItemUsable = function(item) { return typeOf(item) == "MenuItem" && item.disabled != true; };
var chooseMenuItem = function(owner, item) {
    closePopup(owner.surface);
    if (item.onSelect != null) { item.onSelect(); }
};
# Pointer moves over a popup menu highlight the item under the pointer.
var menuHover = function(owner, path) {
    var item = menuItemAt(owner, path);
    if (item == null) { return null; }
    var items = owner.data["menuItems"];
    owner.data["active"] = if (menuItemUsable(items[item])) { item; } else { -1; };
};
# A release over a usable item chooses it; so does a click on one (a release where its press was, even if a rebuild
# between them moved the hit test).
var menuRelease = function(owner, path, event) {
    var item = menuItemAt(owner, path);
    var press = Hash.Get(owner.data, "pressItem", null);
    owner.data["pressItem"] = null;
    if (item == null && press != null && event != null) {
        if (Processing_abs(event["x"] - press[1]) + Processing_abs(event["y"] - press[2]) < 6) { item = press[0]; }
    }
    if (item == null) { return null; }
    var items = owner.data["menuItems"];
    if (menuItemUsable(items[item])) { chooseMenuItem(owner, items[item]); }
};
# Up and Down move the highlight over the usable items (around the ends); Enter and Space choose.
var menuKey = function(owner, key) {
    var items = owner.data["menuItems"];
    var active = Hash.Get(owner.data, "active", -1);
    if (key == 264 || key == 265) {
        var step = if (key == 264) { 1; } else { -1; };
        var n = len(items);
        var at = active;
        if (at < 0 && step < 0) { at = n; }
        for (var k = 1; k <= n; k++) {
            var i = ((at + step * k) % n + n) % n;
            if (menuItemUsable(items[i])) { owner.data["active"] = i; break; }
        }
        return true;
    }
    if (key == 257 || key == 335 || key == 32) {
        if (active >= 0 && active < len(items) && menuItemUsable(items[active])) { chooseMenuItem(owner, items[active]); }
        return true;
    }
    return false;
};

# Menu bars: the bar keeps which menu is open ("open", -1 for none).
var menuTitleAt = function(bar, path) {
    for (var i = 0; i < len(path); i++) { if (path[i].parent == bar && path[i].type == "Box") { return path[i].data["menu"]; } }
    return null;
};
var openMenu = function(bar, index) {
    bar.data["open"] = index;
    bar.data["active"] = -1;
    openPopup(bar);
};
# The next menu (step 1 or -1) that is not disabled, around the ends.
var nextMenu = function(menus, from, step) {
    var n = len(menus);
    for (var k = 1; k <= n; k++) {
        var i = ((from + step * k) % n + n) % n;
        if (menus[i].disabled != true) { return i; }
    }
    return from;
};
kinds["MenuBar"] = {"update": function(e, w) {
    restyle(e, {}, selectorsOf("MenuBar", null, w.class), w.style);
    var menus = w.menus;
    var open = Hash.Get(e.data, "open", -1);
    if (open >= len(menus)) { open = -1; e.data["open"] = -1; }
    var children = [];
    for (var i = 0; i < len(menus); i++) { Array.Append(children, Box(class: "MenuBarTitle", key: "menu" + String.From(i), child: Text(text: menus[i].label))); }
    if (open >= 0) {
        e.data["menuItems"] = menus[open].items;
        Array.Append(children, MenuPopup(owner: e, items: menus[open].items, key: "popup"));
    }
    reconcile(e, children);
    for (var i = 0; i < len(menus); i++) {
        var title = e.children[i];
        title.data["menu"] = i;
        title.data["selected"] = i == open;
        title.data["disabled"] = menus[i].disabled == true;
        update(title, title.widget);
    }
}, "press": function(e, event, path) {
    var i = menuTitleAt(e, path);
    if (i == null) { return false; }
    if (Hash.Get(e.data, "open", -1) == i) { closePopup(e.surface); }
    elif (e.widget.menus[i].disabled != true) { openMenu(e, i); }
    return true;
}, "popupMove": function(e, path) {
    # Moving over another title opens its menu; moving over an item highlights it.
    var i = menuTitleAt(e, path);
    if (i != null && i != Hash.Get(e.data, "open", -1) && e.widget.menus[i].disabled != true) { openMenu(e, i); }
    menuHover(e, path);
}, "popupRelease": function(e, path, event) { menuRelease(e, path, event); },
"popupKey": function(e, key) {
    var menus = e.widget.menus;
    if (key == 263) { openMenu(e, nextMenu(menus, e.data["open"], -1)); }         # Left
    elif (key == 262) { openMenu(e, nextMenu(menus, e.data["open"], 1)); }        # Right
    else { menuKey(e, key); }
}, "close": function(e) { e.data["open"] = -1; e.data["active"] = -1; }};

# A popup menu: under its anchor (data "anchor", the open title) or at a point (`at`, a context menu).
kinds["MenuPopup"] = {"overlay": true, "update": function(e, w) {
    var owner = w.owner;
    restyle(e, {"zIndex": 40}, ["MenuPopup"], null);
    if (w.at != null) { e.data["point"] = w.at; e.data["anchor"] = null; }
    else { e.data["anchor"] = owner.children[owner.data["open"]]; e.data["anchorGap"] = 2; }
    var active = Hash.Get(owner.data, "active", -1);
    var items = w.items;
    var rows = [];
    for (var i = 0; i < len(items); i++) {
        var item = items[i];
        if (typeOf(item) == "MenuItem") {
            Array.Append(rows, Box(class: "MenuRow", key: "item" + String.From(i), children: [
                Box(class: "MenuCheck", key: "check", child: if (item.checked == true) { Icon(name: "check", size: 14); } else { null; }),
                Text(text: item.label, class: "MenuLabel", key: "label"),
                if (item.shortcut != null) { Text(text: item.shortcut, class: "MenuShortcut", key: "shortcut"); } else { null; }]));
        } else {
            Array.Append(rows, Box(class: "MenuSeparator", key: "separator" + String.From(i)));
        }
    }
    reconcile(e, rows);
    for (var i = 0; i < len(e.children); i++) {
        var row = e.children[i];
        row.data["item"] = i;
        row.data["selected"] = i == active;
        row.data["disabled"] = typeOf(items[i]) == "MenuItem" && items[i].disabled == true;
        update(row, row.widget);
    }
}};

# Text fields. The editing rules are the Interaction library's TextEditing (the platforms' keys, words, clusters, undo,
# clipboard, composition, pointer selection), so every rule lives in one place; this draws it. The caret and the
# selection come from the text node's own layout (Saturn's TextCaret and TextIndexAt measure with the font the field
# really uses), a single-line field scrolls sideways to keep the caret in view, the caret blinks at the platform's rate
# (solid while typing) and a right click opens Cut, Copy, Paste and Select all.
var TextEditing = null;
var editorOf = function(e) {
    var w = e.widget;
    if (TextEditing == null) { TextEditing = import("TextEditing"); }
    if (e.state == null) {
        e.state = TextEditing.Create(pick(w.value, ""), {"multiline": w.multiline == true});
        e.data["scrollX"] = 0;
        e.data["activity"] = 0;
        e.data["value"] = pick(w.value, "");
    }
    return e.state;
};
# The widget's settings onto the editor. The text follows `value` only when the application changed it: a widget built
# before the application took the latest edits (events arrive faster than frames) never undoes them.
var syncEditor = function(e, w) {
    var ed = editorOf(e);
    ed.multiline = w.multiline == true;
    ed.maxLength = w.maxLength;
    ed.readOnly = w.readOnly == true || w.onChanged == null || w.disabled == true;
    ed.obscure = w.obscure == true;
    var value = pick(w.value, "");
    var reported = Hash.Get(e.data, "reported", []);
    if (len(reported) > 0 && value == reported[len(reported) - 1]) { e.data["reported"] = []; }
    elif (!Array.Contains(reported, value) && value != e.data["value"]) {
        e.data["reported"] = [];
        TextEditing.SetText(ed, value);
    }
    e.data["value"] = value;
    return ed;
};
# The text node of a field (its first child) and the editor's view of it, in that node's coordinates.
var fieldText = function(e) { return e.children[0]; };
var fieldLayout = function(e) {
    var ed = e.state;
    var node = fieldText(e).node;
    var composing = if (ed.composition == null) { 0; } else { len(ed.composition); };
    var shown = function(i) { if (composing > 0 && i > ed.caret) { return i + composing; } return i; };
    return {
        "caretAt": function(i) { return node.TextCaret(shown(i)); },
        "indexAt": function(x, y) {
            var d = node.TextIndexAt(x, y);
            if (composing > 0 && d > ed.caret) { return Processing_max(ed.caret, d - composing); }
            return d;
        },
        "page": e.node.GetComputedHeight()};
};
# An event's point in the text node's coordinates (the node scrolls by scrollX).
var fieldPoint = function(e, ev) {
    var box = fieldText(e).node.GetAbsoluteLayout();
    var copy = Hash.Clone(ev);
    copy["x"] = ev["x"] - box["x"] + Hash.Get(e.data, "scrollX", 0);
    copy["y"] = ev["y"] - box["y"];
    return copy;
};
# After an edit: tell the application, submit on Enter, keep the caret solid.
var fieldEdited = function(e) {
    var ed = e.state;
    var w = e.widget;
    e.data["activity"] = e.surface.time;
    # The field shows the edit at once (its text node), whatever the rebuild waits for.
    if (len(e.children) > 0 && len(ed.text) > 0) { fieldText(e).node.SetText(TextEditing.Display(ed)[0]); }
    if (ed.changed) {
        ed.changed = false;
        # Values reported but not yet seen back: a widget built before the application took them is not a change.
        var reported = Hash.Get(e.data, "reported", []);
        Array.Append(reported, ed.text);
        if (len(reported) > 64) { Array.Delete(reported, 0, 1); }
        e.data["reported"] = reported;
        if (w.onChanged != null) { w.onChanged(ed.text); }
    }
    if (ed.submitted) { ed.submitted = false; if (w.onSubmit != null) { w.onSubmit(ed.text); } }
    e.surface.dirty = true;
};
var fieldMenu = function(e, x, y) {
    var ed = e.state;
    if (Interaction == null) { Interaction = import("Interaction"); }
    var act = function(action) { return function() { TextEditing.Do(ed, action, false, fieldLayout(e)); fieldEdited(e); }; };
    var selected = TextEditing.HasSelection(ed);
    e.data["menuItems"] = [
        MenuItem(label: "Undo", shortcut: Interaction.ShortcutLabel("undo"), onSelect: act("undo"), disabled: ed.readOnly || len(ed.undo) == 0),
        MenuItem(label: "Redo", shortcut: Interaction.ShortcutLabel("redo"), onSelect: act("redo"), disabled: ed.readOnly || len(ed.redo) == 0),
        MenuSeparator(),
        MenuItem(label: "Cut", shortcut: Interaction.ShortcutLabel("cut"), onSelect: act("cut"), disabled: !selected || ed.readOnly || ed.obscure),
        MenuItem(label: "Copy", shortcut: Interaction.ShortcutLabel("copy"), onSelect: act("copy"), disabled: !selected || ed.obscure),
        MenuItem(label: "Paste", shortcut: Interaction.ShortcutLabel("paste"), onSelect: act("paste"), disabled: ed.readOnly),
        MenuItem(label: "Delete", onSelect: act("deleteForward"), disabled: !selected || ed.readOnly),
        MenuSeparator(),
        MenuItem(label: "Select all", shortcut: Interaction.ShortcutLabel("selectAll"), onSelect: act("selectAll"), disabled: len(ed.text) == 0)];
    e.data["menuAt"] = [x, y];
    e.data["menuOpen"] = true;
    e.data["active"] = -1;
    openPopup(e);
};
var Interaction = null;

kinds["TextField"] = {"update": function(e, w) {
    e.data["disabled"] = w.disabled == true;
    e.data["focused"] = e.surface.focus == e;
    restyle(e, {"width": w.width}, selectorsOf("TextField", if (w.multiline == true) { "multiline"; } else { null; }, w.class), w.style);
    var ed = syncEditor(e, w);
    # autofocus: the field takes the keyboard when it appears (a dialog's first field), its text selected to type over.
    if (w.autofocus == true && Hash.Get(e.data, "autofocused", false) != true && w.disabled != true) {
        e.data["autofocused"] = true;
        e.surface.focus = e;
        e.data["focused"] = true;
        TextEditing.SelectAll(ed);
    }
    var display = TextEditing.Display(ed);
    var empty = len(display[0]) == 0;
    var wrap = if (w.multiline == true) { "normal"; } else { "nowrap"; };
    # The text node sizes to its text (a single line may be wider than the field: it scrolls); a placeholder shows
    # while the field is empty.
    var text = Text(text: if (empty) { pick(w.placeholder, ""); } else { display[0]; }, key: "text",
        class: if (empty) { "Placeholder"; } else { null; },
        style: {"whiteSpace": wrap, "alignSelf": if (w.multiline == true) { "stretch"; } else { "flex-start"; }, "flexShrink": 0});
    var children = [text];
    if (Hash.Get(e.data, "menuOpen", false) == true) {
        Array.Append(children, MenuPopup(owner: e, items: e.data["menuItems"], at: e.data["menuAt"], key: "menu"));
    }
    reconcile(e, children);
    e.node.SetPainter(safePainter(e, function(p, width, height) {
        var s = e.surface;
        if (s.focus != e || e.state == null || len(e.children) == 0) { return null; }
        var editor = e.state;
        var node = fieldText(e).node;
        var ox = node.GetComputedLeft() - Hash.Get(e.data, "scrollX", 0);
        var oy = node.GetComputedTop();
        var shown = TextEditing.Display(editor);
        var lay = fieldLayout(e);
        if (TextEditing.HasSelection(editor) && editor.composition == null) {
            # The selection, line by line.
            var from = lay["caretAt"](TextEditing.SelectionStart(editor));
            var to = lay["caretAt"](TextEditing.SelectionEnd(editor));
            var lines = node.GetTextLines();
            var color = s.theme.primarySoft;
            for (var line = from["line"]; line <= to["line"]; line++) {
                var x0 = if (line == from["line"]) { from["x"]; } else { lines[line]["x"]; };
                var x1 = if (line == to["line"]) { to["x"]; } else { lines[line]["x"] + lines[line]["width"] + 4; };
                var y = if (line == from["line"]) { from["y"]; } else { from["y"] + (line - from["line"]) * from["height"]; };
                if (x1 > x0) { p.Rect(ox + x0, oy + y, x1 - x0, from["height"], color); }
            }
        }
        if (editor.composition != null) {
            # The composition in progress, underlined.
            var a = node.TextCaret(shown[2]);
            var b = node.TextCaret(shown[3]);
            p.Rect(ox + a["x"], oy + a["y"] + a["height"] - 2, b["x"] - a["x"], 1.5d, s.textColor(e));
        }
        # The caret: solid for a moment after each change, then blinking at the platform's rate (0: never blinks).
        var blink = Hash.Get(conventionsOf(s), "caretBlinkTime", 530);
        var idle = s.time - Hash.Get(e.data, "activity", 0);
        var visible = blink <= 0 || idle < blink || int(idle / blink) % 2 == 1;
        if (visible) {
            var caret = node.TextCaret(shown[1]);
            var thickness = if (editor.overwrite) { 6; } else { 1.5d; };
            p.Rect(ox + caret["x"], oy + caret["y"] + 2, thickness, caret["height"] - 4, s.textColor(e));
        }
    }));
}, "focusable": true,
# A press places the caret (Shift extends, a double press selects a word, a triple press all), and the field holds the
# pointer so dragging selects. A right press opens the context menu.
"press": function(e, event, path) {
    var s = e.surface;
    if (e.widget.disabled == true) { return true; }
    if (menuItemAt(e, path) != null) { return false; }
    if (s.focus != e) { s.focus = e; }
    var ed = editorOf(e);
    TextEditing.Handle(ed, fieldPoint(e, event), fieldLayout(e));
    e.data["activity"] = s.time;
    if (pick(event["button"], 0) == 0) { s.captured = e; }
    if (pick(event["button"], 0) == 1) { fieldMenu(e, event["x"], event["y"]); }
    s.dirty = true;
    return true;
},
"drag": function(e, event, local) {
    if (e.state == null || event["x"] == null) { return null; }
    TextEditing.Handle(e.state, fieldPoint(e, event), fieldLayout(e));
    e.data["activity"] = e.surface.time;
},
"text": function(e, text) {
    if (TextEditing.Handle(editorOf(e), {"type": "text", "text": text}, fieldLayout(e))) { fieldEdited(e); }
},
"composition": function(e, event) {
    var used = TextEditing.Handle(editorOf(e), event, fieldLayout(e));
    fieldEdited(e);
    return used;
},
"key": function(e, event) {
    var used = TextEditing.Handle(editorOf(e), event, fieldLayout(e));
    if (used) { fieldEdited(e); }
    return used;
},
# After layout: scroll a single-line field so the caret stays in view.
"layout": function(e) {
    if (e.state == null || len(e.children) == 0 || e.widget.multiline == true) { return null; }
    var node = fieldText(e).node;
    var inner = e.node.GetComputedWidth() - node.GetComputedLeft() * 2;
    var shown = TextEditing.Display(e.state);
    var caret = node.TextCaret(shown[1])["x"];
    var full = node.TextCaret(len(shown[0]))["x"];
    var scroll = Hash.Get(e.data, "scrollX", 0);
    if (caret - scroll > inner - 2) { scroll = caret - inner + 2; }
    if (caret - scroll < 0) { scroll = caret; }
    scroll = clamp(scroll, 0, Processing_max(0, full - inner + 2));
    e.data["scrollX"] = scroll;
    node.SetStyle({"translateX": -scroll});
},
# The context menu (popup protocol).
"popupMove": function(e, path) { menuHover(e, path); },
"popupRelease": function(e, path, event) { menuRelease(e, path, event); },
"popupKey": function(e, key) { menuKey(e, key); },
"close": function(e) { e.data["menuOpen"] = false; e.data["active"] = -1; }};

kinds["Dialog"] = {"overlay": true, "update": function(e, w) {
    if (w.open != true) { restyle(e, {"display": "none"}, [], null); reconcile(e, []); return null; }
    restyle(e, {"zIndex": 20}, ["Scrim"], null);
    var body = [];
    if (w.title != null) { Array.Append(body, Text(text: w.title, class: "DialogTitle", key: "title")); }
    if (w.content != null) { Array.Append(body, w.content); }
    if (w.actions != null) { Array.Append(body, Row(children: w.actions, class: "DialogActions", key: "actions")); }
    reconcile(e, [Column(children: body, class: "DialogCard", style: {"width": w.width}, crossAxis: "stretch", key: "card")]);
}, "tap": function(e, event) {
    # A tap on the scrim (outside the card) dismisses.
    var path = e.surface.pathAt(event["x"], event["y"]);
    if (path[len(path) - 1] == e && e.widget.onDismiss != null) { e.widget.onDismiss(); }
}};
kinds["Tooltip"] = {"update": function(e, w) {
    restyle(e, {"display": "contents"}, [], null);
    var children = [w.child];
    var s = e.surface;
    if (s.tooltip == e && s.time - s.tooltipAt > 450) {
        Array.Append(children, TooltipBubble(text: w.message, owner: e, key: "bubble"));
    }
    reconcile(e, children);
}};
kinds["TooltipBubble"] = {"overlay": true, "update": function(e, w) {
    var target = w.owner.children[0].node.GetAbsoluteLayout();
    restyle(e, {"left": target["x"], "top": target["y"] + target["height"] + 6, "zIndex": 30}, ["TooltipBubble"], null);
    reconcile(e, [Text(text: w.text, key: "text")]);
}};

# ---- Surfaces ------------------------------------------------------------------------------------------------------

# The element of the widget whose handler a kind or field offers for an event, from the deepest hit upward.
var handlerOf = function(path, field) {
    for (var i = len(path) - 1; i >= 0; i -= 1) {
        var e = path[i];
        var kind = kinds[e.type];
        if (kind != null && kind[field] != null) { return e; }
        var t = e.type;
        if ((t == "Box" || t == "Gesture" || t == "Card") && field == "tap" && e.widget.onTap != null) { return e; }
        if (t == "Gesture" && field == "drag" && (e.widget.onDrag != null || e.widget.onDragStart != null)) { return e; }
    }
    return null;
};
var scrollableOf = function(path) {
    for (var i = len(path) - 1; i >= 0; i -= 1) { if (Hash.Get(path[i].data, "scrollable", false) == true) { return path[i]; } }
    return null;
};

# ---- Scrolling -----------------------------------------------------------------------------------------------------
# A scrollable element scrolls along one axis ("axis": "y", or "x" for a horizontal ScrollView); its offset is
# data["scrollY"] or data["scrollX"], and the surface's layout pass stores how far it can go ("limit"). The rules are
# the platforms' own:
# - The wheel and touchpad scroll the innermost view under the pointer that can still move that way; at its end the
#   turn goes to the view around it, so an inner view at its end never swallows the wheel.
# - Touch and pen drags pan the content (a press that turns into a pan is no tap). A mouse's left drag never scrolls
#   on a desktop (it selects, drags, or does nothing); on a mobile form factor a mouse pans like a finger.
# - A press on the scrollbar strip drags the thumb, or pages toward the pointer on the track.
# - The middle button autoscrolls on Windows, Linux and desktop browsers: hold it and move away from where it went
#   down, and the view scrolls toward the pointer, faster the farther it is; a middle click without moving keeps
#   autoscrolling until the next press or Escape. On Apple platforms a middle drag pans the way a finger does.
#   Surface option "middleButton": "autoscroll" | "pan" | "none" overrides that.
var scrollKey = function(e) { if (Hash.Get(e.data, "axis", "y") == "x") { return "scrollX"; } return "scrollY"; };
var along = function(e, x, y) { if (Hash.Get(e.data, "axis", "y") == "x") { return x; } return y; };
var scrollTo = function(e, offset) {
    var limit = Hash.Get(e.data, "limit", null);
    var v = Processing_max(0, offset);
    if (limit != null) { v = Processing_min(v, limit); }
    e.data[scrollKey(e)] = v;
    if (Hash.Get(e.data, "virtual", false) == true) { e.surface.dirty = true; }
};
# Scrolls the innermost scrollable of the path that can move by the wheel's dx, dy; returns it, or null.
var wheelTarget = function(path, dx, dy) {
    for (var i = len(path) - 1; i >= 0; i -= 1) {
        var e = path[i];
        if (Hash.Get(e.data, "scrollable", false) != true) { continue; }
        var d = pick(along(e, dx, dy), 0);
        if (d == 0) { continue; }
        var at = Hash.Get(e.data, scrollKey(e), 0);
        var limit = Hash.Get(e.data, "limit", null);
        if (limit == null || (d < 0 && at > 0) || (d > 0 && at < limit)) { scrollTo(e, at + d); return e; }
    }
    return null;
};
# The innermost scrollable of the path whose content is larger than it.
var overflowingOf = function(path) {
    for (var i = len(path) - 1; i >= 0; i -= 1) {
        var e = path[i];
        if (Hash.Get(e.data, "scrollable", false) == true && Hash.Get(e.data, "limit", 0) > 0.5d) { return e; }
    }
    return null;
};
var BarGrip = 12;
# The scrollbar of a scrollable element in window coordinates: the track (start and length along the axis), the
# thumb (offset into the track and size), or null when the content fits.
var barOf = function(e) {
    var limit = Hash.Get(e.data, "limit", 0);
    if (limit <= 0.5d) { return null; }
    var box = e.node.GetAbsoluteLayout();
    var vertical = Hash.Get(e.data, "axis", "y") == "y";
    var length = if (vertical) { box["height"]; } else { box["width"]; };
    var size = Processing_min(length, Processing_max(24, length * length / (length + limit)));
    return {"box": box, "vertical": vertical, "start": if (vertical) { box["y"]; } else { box["x"]; }, "length": length,
        "size": size, "thumb": (length - size) * Hash.Get(e.data, scrollKey(e), 0) / limit};
};
# Whether (x, y) is on the element's scrollbar strip (the edge where its thumb runs).
var onBar = function(e, x, y) {
    var bar = barOf(e);
    if (bar == null) { return false; }
    var b = bar["box"];
    if (bar["vertical"]) { return x >= b["x"] + b["width"] - BarGrip && x < b["x"] + b["width"] && y >= b["y"] && y < b["y"] + b["height"]; }
    return y >= b["y"] + b["height"] - BarGrip && y < b["y"] + b["height"] && x >= b["x"] && x < b["x"] + b["width"];
};
# The scrollable of the path whose scrollbar strip is under (x, y), innermost first.
var barAt = function(path, x, y) {
    for (var i = len(path) - 1; i >= 0; i -= 1) {
        if (Hash.Get(path[i].data, "scrollable", false) == true && onBar(path[i], x, y)) { return path[i]; }
    }
    return null;
};
# The platform conventions the scrolling rules follow: the surface option "conventions" ({"platform", "formFactor",
# "primaryModifier", "scrollbars"}), else the Interaction library's, read when first needed.
var conventionsOf = function(s) {
    if (s.conventions == null) {
        var given = if (s.options == null) { null; } else { s.options["conventions"]; };
        if (given == null) {
            var c = import("Interaction").Conventions();
            given = {"platform": c.platform, "formFactor": c.formFactor, "primaryModifier": c.primaryModifier, "scrollbars": c.scrollbars};
        }
        s.conventions = given;
    }
    return s.conventions;
};
var middleButtonOf = function(s) {
    if (s.options != null && s.options["middleButton"] != null) { return s.options["middleButton"]; }
    var c = conventionsOf(s);
    if (Hash.Get(c, "formFactor", "desktop") == "mobile") { return "pan"; }
    if (Hash.Get(c, "primaryModifier", "Ctrl") == "Cmd") { return "pan"; }
    return "autoscroll";
};
# Whether a press of this pointer pans scroll views by dragging.
var pans = function(s, ev) {
    var kind = ev["pointerType"];
    if (kind == "touch" || kind == "pen") { return true; }
    return Hash.Get(conventionsOf(s), "formFactor", "desktop") == "mobile";
};
