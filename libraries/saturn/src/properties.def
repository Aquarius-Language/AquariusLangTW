/* Yoga's style properties, one entry per property. Each family generates the node methods named as in Yoga's C API
 * (YGNodeStyleSetWidth -> node.SetWidth), with Chinese aliases built from the 中文 argument; css is the key SetStyle reads:
 *   ENUM_PROPERTY(Name, css, 中文, type)       SetName(value) GetName()             value: a constant or its CSS name
 *   NUMBER_PROPERTY(Name, css, 中文)           SetName(n) GetName()
 *   SIZE_PROPERTY(Name, css, 中文)             SetName(n) SetNamePercent(n) SetNameAuto() SetNameMaxContent()
 *                                         SetNameFitContent() SetNameStretch() GetName() -> Saturn.Value
 *   BOUND_PROPERTY(Name, css, 中文)            as SIZE_PROPERTY without Auto (min and max sizes)
 *   EDGE_PROPERTY(Name, css, 中文)             SetName(edge, n) SetNamePercent(edge, n) SetNameAuto(edge) GetName(edge)
 *   PADDING_PROPERTY(Name, css, 中文)          SetName(edge, n) SetNamePercent(edge, n) GetName(edge)
 *   GRID_LINE_PROPERTY(Name, css, 中文)        SetName(i) SetNameAuto() SetNameSpan(i) GetName()
 *   GRID_TRACKS_PROPERTY(Name, Plural, css, 中文)  SetPluralCount(n) SetName(i, type, n) SetNameMinMax(i, t, n, t, n) */
ENUM_PROPERTY(Direction, "direction", "方向", YGDirection)
ENUM_PROPERTY(FlexDirection, "flexDirection", "主軸方向", YGFlexDirection)
ENUM_PROPERTY(JustifyContent, "justifyContent", "主軸對齊", YGJustify)
ENUM_PROPERTY(JustifyItems, "justifyItems", "項目主軸對齊", YGJustify)
ENUM_PROPERTY(JustifySelf, "justifySelf", "自身主軸對齊", YGJustify)
ENUM_PROPERTY(AlignContent, "alignContent", "行對齊", YGAlign)
ENUM_PROPERTY(AlignItems, "alignItems", "交叉軸對齊", YGAlign)
ENUM_PROPERTY(AlignSelf, "alignSelf", "自身交叉軸對齊", YGAlign)
ENUM_PROPERTY(PositionType, "position", "定位方式", YGPositionType)
ENUM_PROPERTY(FlexWrap, "flexWrap", "換行", YGWrap)
ENUM_PROPERTY(Overflow, "overflow", "溢出", YGOverflow)
ENUM_PROPERTY(Display, "display", "顯示", YGDisplay)
ENUM_PROPERTY(BoxSizing, "boxSizing", "盒模型", YGBoxSizing)
NUMBER_PROPERTY(Flex, "flex", "彈性")
NUMBER_PROPERTY(FlexGrow, "flexGrow", "彈性成長")
NUMBER_PROPERTY(FlexShrink, "flexShrink", "彈性收縮")
NUMBER_PROPERTY(AspectRatio, "aspectRatio", "長寬比")
SIZE_PROPERTY(FlexBasis, "flexBasis", "彈性基準")
SIZE_PROPERTY(Width, "width", "寬度")
SIZE_PROPERTY(Height, "height", "高度")
BOUND_PROPERTY(MinWidth, "minWidth", "最小寬度")
BOUND_PROPERTY(MinHeight, "minHeight", "最小高度")
BOUND_PROPERTY(MaxWidth, "maxWidth", "最大寬度")
BOUND_PROPERTY(MaxHeight, "maxHeight", "最大高度")
EDGE_PROPERTY(Position, "position", "位置")
EDGE_PROPERTY(Margin, "margin", "外距")
PADDING_PROPERTY(Padding, "padding", "內距")
GRID_LINE_PROPERTY(GridColumnStart, "gridColumnStart", "網格欄起點")
GRID_LINE_PROPERTY(GridColumnEnd, "gridColumnEnd", "網格欄終點")
GRID_LINE_PROPERTY(GridRowStart, "gridRowStart", "網格列起點")
GRID_LINE_PROPERTY(GridRowEnd, "gridRowEnd", "網格列終點")
GRID_TRACKS_PROPERTY(GridTemplateColumn, GridTemplateColumns, "gridTemplateColumns", "網格欄軌道")
GRID_TRACKS_PROPERTY(GridTemplateRow, GridTemplateRows, "gridTemplateRows", "網格列軌道")
GRID_TRACKS_PROPERTY(GridAutoColumn, GridAutoColumns, "gridAutoColumns", "網格自動欄")
GRID_TRACKS_PROPERTY(GridAutoRow, GridAutoRows, "gridAutoRows", "網格自動列")
