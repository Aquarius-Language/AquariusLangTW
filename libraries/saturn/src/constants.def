VALUE(YGAlign, AlignSpaceAround, YGAlignSpaceAround, "space-around")
VALUE(YGAlign, AlignSpaceEvenly, YGAlignSpaceEvenly, "space-evenly")
VALUE(YGAlign, AlignStart, YGAlignStart, "start")
VALUE(YGAlign, AlignEnd, YGAlignEnd, "end")
