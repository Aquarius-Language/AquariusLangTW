/* Yoga's enumerations as VALUE(type, constant, value, css). `constant` becomes a module constant (Saturn.AlignCenter,
 * named as in Yoga's C API without the YG prefix); `css` is the name SetStyle and the setters also accept (a string
 * setter argument such as node.SetAlignItems("center")). Several entries may share a value: the first is the
 * canonical name GetXxxName() reports. */
VALUE(YGAlign, AlignAuto, YGAlignAuto, "auto")
VALUE(YGAlign, AlignFlexStart, YGAlignFlexStart, "flex-start")
VALUE(YGAlign, AlignCenter, YGAlignCenter, "center")
VALUE(YGAlign, AlignFlexEnd, YGAlignFlexEnd, "flex-end")
