# A failing widget never takes the surface down: a painter, an Immediate widget or a builder that throws loses only its
# own part (recorded once in Errors()), and the rest of the surface keeps painting and taking input. Event handlers run
# directly (they may wait for asynchronous results), so their failure reaches the caller, and the surface goes on.
var UI = import("SaturnUI");
var Saturn = import("Saturn");
var count = 0;
var broken = true;
var s = UI.Surface(300, 200, UI.Builder(build: c => UI.Column(children: [
    UI.CustomPaint(width: 50, height: 20, key: "bad", paint: (p, w, h) => String.Slice(null, 0, 1)),
    UI.Immediate(width: 50, height: 20, key: "imm", paint: (x, y, w, h) => String.Slice(null, 0, 1), feed: event => null.x),
    UI.Button(label: "Count", key: "ok", onPress: () => { count += 1; }),
    UI.Button(label: "Boom", key: "boom", onPress: () => String.Slice(null, 0, 1)),
    if (broken) UI.Builder(key: "builder", build: c => String.Slice(null, 0, 1)) else UI.Text("built")])),
    {"conventions": {"platform": "windows", "formFactor": "desktop", "primaryModifier": "Ctrl", "scrollbars": "classic"}});
s.Frame(0);
var list = s.Paint();
print("still paints", len(list["commands"]) > 0);
var column = s.tree.children[0].children[0];
var center = function(key) {
    for (var i = 0; i < len(column.children); i++) {
        if (column.children[i].key == key) { var b = column.children[i].node.GetAbsoluteLayout(); return [b["x"] + b["width"] / 2, b["y"] + b["height"] / 2]; }
    }
    return null;
};
var click = function(key) {
    var c = center(key);
    s.Feed({"type": "press", "x": c[0], "y": c[1], "button": 0});
    s.Feed({"type": "release", "x": c[0], "y": c[1], "button": 0});
    s.Frame(s.time + 16);
};
var c = center("boom");
print("a failing handler reaches the caller", Saturn.Contain(() => s.Feed({"type": "press", "x": c[0], "y": c[1], "button": 0}))["Success"],
    Saturn.Contain(() => s.Feed({"type": "release", "x": c[0], "y": c[1], "button": 0}))["Success"]);
s.Frame(s.time + 16);
click("ok");
print("input still works", count);
broken = false;
s.Rebuild();
s.Frame(s.time + 16);
print("recovers when fixed", column.children[len(column.children) - 1].node.GetText());
var errors = s.Errors();
var kinds = [];
for (var i = 0; i < len(errors); i++) { Array.Append(kinds, String.Split(errors[i], ":")[0]); }
print("errors", len(errors) >= 3, Array.Contains(kinds, "CustomPaint painter"), Array.Contains(kinds, "Immediate painter"), Array.Contains(kinds, "Builder build"));
s.Paint();
print("each failure recorded once", len(s.Errors()) == len(errors));
# The guard leaves nothing behind: more calls than the runtime has native resource slots (65,536) run fine.
var total = 0;
for (var i = 0; i < 70000; i++) { total += Saturn.Contain(() => 1)["Value"]; }
print("contained calls leave nothing behind", total);
