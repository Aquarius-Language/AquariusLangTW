# SplitView: a bar between two panes shows the resize cursor and drags the space between them, within its limits (also
# when the view shrinks); onResize hears the size; collapsing hides the first pane and its bar; the column direction
# splits one above the other. CSS cursor names reach Interaction under its own names.
var UI = import("SaturnUI");
var width = 240;
var collapsed = false;
var heard = [];
var root = UI.Builder(build: context => UI.SplitView(size: width, min: 100, max: 400, minSecond: 150, collapsed: collapsed,
    onResize: size => { width = size; Array.Append(heard, size); },
    first: UI.Text("files", key: "files"), second: UI.Text("notebook", key: "notebook")));
var s = UI.Surface(800, 300, root, null);
s.Frame(0);
var split = s.tree.children[0].children[0];
var box = e => e.node.GetAbsoluteLayout();
var pane = i => box(split.children[i]);
print("panes", pane(0)["width"], pane(1)["width"], pane(2)["x"], pane(2)["width"]);

# Hover the bar: the resize cursor and the lit line.
s.Feed({"type": "move", "x": 240, "y": 100});
s.Frame(16);
print("hover", s.Cursor(), split.children[1].data["selected"]);
s.Feed({"type": "move", "x": 500, "y": 100});
s.Frame(32);
print("away", s.Cursor(), split.children[1].data["selected"]);

# Drag the bar 60 pixels right, then far past each limit.
var drag = function(from, to) {
    s.Feed({"type": "move", "x": from, "y": 100});
    s.Feed({"type": "press", "x": from, "y": 100, "button": 0});
    s.Feed({"type": "drag", "x": to, "y": 120});
    s.Frame(s.time + 16);
    var during = s.Cursor();
    s.Feed({"type": "release", "x": to, "y": 120, "button": 0});
    s.Frame(s.time + 16);
    return during;
};
print("drag", drag(240, 300), width, pane(0)["width"], pane(2)["x"]);
drag(300, 790);
print("max", width, pane(0)["width"]);
drag(400, 0);
print("min", width, pane(0)["width"]);

# A narrower view leaves the second pane its minimum.
width = 400;
s.Rebuild();
s.Frame(s.time + 16);
s.Resize(500, 300);
s.Frame(s.time + 16);
print("shrunk", pane(0)["width"], pane(2)["width"], box(split.children[3])["x"]);

# Collapsed: only the second pane, and the first comes back as it was.
collapsed = true;
s.Rebuild();
s.Frame(s.time + 16);
var files = split.children[0].children[0];
print("collapsed", pane(2)["x"], pane(2)["width"], s.pathAt(0, 100)[len(s.pathAt(0, 100)) - 1].type);
collapsed = false;
s.Rebuild();
s.Frame(s.time + 16);
print("restored", split.children[0].children[0] == files, pane(0)["width"]);
print("heard", heard);

# One above the other, without onResize: the view keeps the dragged size itself.
var rows = UI.Surface(300, 400, UI.SplitView(direction: "column", size: 100, first: UI.Text("top"), second: UI.Text("bottom")), null);
rows.Frame(0);
var column = rows.tree.children[0];
rows.Feed({"type": "move", "x": 50, "y": 100});
rows.Frame(16);
var cursor = rows.Cursor();
rows.Feed({"type": "press", "x": 50, "y": 100, "button": 0});
rows.Feed({"type": "drag", "x": 60, "y": 180});
rows.Feed({"type": "release", "x": 60, "y": 180, "button": 0});
rows.Frame(32);
print("column", cursor, box(column.children[0])["height"], box(column.children[2])["y"]);

# CSS cursor names are translated; Interaction's own pass through.
var cursors = UI.Surface(200, 100, UI.Row(children: [
    UI.Box(cursor: "not-allowed", style: {"width": 50, "height": 50}),
    UI.Box(cursor: "resizeVertical", style: {"width": 50, "height": 50}),
    UI.Box(cursor: "default", style: {"width": 50, "height": 50}, child: UI.Box(style: {"width": 10, "height": 10})),
]), null);
cursors.Frame(0);
var names = [];
for (var x = 25; x < 200; x += 50) { cursors.Feed({"type": "move", "x": x, "y": 25}); Array.Append(names, cursors.Cursor()); }
print("cursors", names);
