# 全繁體中文介面：離線裝置、音調、樣本與控制，不需要音訊硬體。
變數 音訊 = 匯入("音訊");
印出("格式", 音訊.取樣率, 音訊.聲道數);
變數 裝置 = 音訊.建立離線裝置();
變數 聲音 = 裝置.建立音調(440, 0.1d);
聲音.設定音量(0.5d); 聲音.設定聲像(-0.5d); 聲音.設定音高(1.5d); 聲音.設定循環(真); 聲音.播放();
變數 樣本 = 裝置.產生樣本(256);
變數 成功 = 長度(樣本) == 512 && 聲音.是否播放中() && 聲音.取得時長() == 0.1d;
印出("播放", 成功, 樣本[200], 樣本[201]);
聲音.暫停(); 印出("暫停", 聲音.是否播放中());
聲音.停止(); 印出("停止", 聲音.取得位置());
聲音.跳至(0.01d); 印出("跳至", 聲音.取得位置());
變數 片段 = 裝置.建立樣本([0.5d, -0.5d, 0.25d, -0.25d]);
片段.播放();
變數 輸出 = 裝置.產生樣本(4);
印出("樣本", 片段.取得時長(), 輸出, 片段.是否播放中());
聲音.釋放(); 聲音.釋放(); 片段.釋放(); 裝置.釋放(); 裝置.釋放();
變數 型態 = 型別(裝置);
印出("型別", 型態);
成功;
