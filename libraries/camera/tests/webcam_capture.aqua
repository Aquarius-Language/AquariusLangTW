# Needs a camera (opens the default device; run explicitly): two frames, their contract, double release.
變數 攝影機 = 0;
如果 (是Android()) { 攝影機 = 匯入("相機"); } 否則 { 攝影機 = 匯入("攝影機"); }
變數 工作階段 = 攝影機.開啟("", 320, 240, 30);
變數 第一張 = 工作階段.擷取影格();
變數 第二張 = 工作階段.擷取影格();
變數 像素 = 第一張.取得像素();
變數 通過 = 第一張.寬度 * 第一張.高度 == 320 * 240 && 長度(像素) == 320 * 240 * 4 && 工作階段.是否開啟();
通過 = 通過 && 第二張.序號 > 第一張.序號 && 第二張.時間戳記 >= 第一張.時間戳記;
通過 = 通過 && 第一張.影像.寬度 == 第一張.寬度 && 長度(第一張.影像.像素()) == 長度(像素);
變數 不透明 = 真;
迴圈 (變數 索引 = 3; 索引 < 長度(像素); 索引 += 4) { 如果 (像素[索引] != 255) { 不透明 = 假; } }
工作階段.釋放();
工作階段.釋放();
印出("frames", 通過, "opaque", 不透明, "closed", !工作階段.是否開啟());
工作階段.擷取影格();
