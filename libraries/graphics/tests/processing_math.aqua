# Processing math, random/noise sequences, colors and PVector without a window.
var p = import("Processing");
print(p.backend, p.P2D, p.P3D, p.CENTER, p.TRIANGLE_STRIP, p.ESC, p.PI, p.TWO_PI);
print(p.width, p.height, p.frameCount, p.mouseX, p.key, p.isMousePressed);
print(p.abs(-3), p.sq(4), p.sqrt(2), p.pow(2, 10), p.exp(1), p.log(10));
print(p.map(5, 0, 10, 100, 200), p.norm(5, 0, 20), p.lerp(1, 3, 0.25d), p.constrain(15, 0, 10));
print(p.dist(0, 0, 3, 4), p.dist(0, 0, 0, 1, 2, 2), p.mag(3, 4), p.mag(1, 2, 2));
print(p.min(3, 1, 2), p.max(3, 1, 2), p.min([5, 4, 9]), p.round(2.5d), p.round(3.5d), p.floor(-1.5d), p.ceil(1.2d));
print(p.degrees(p.PI), p.radians(90), p.sin(1), p.cos(1), p.tan(1), p.atan2(1, 2), p.asin(0.5d), p.acos(0.5d), p.atan(1));
p.randomSeed(42);
print(p.random(10), p.random(5, 6), p.random(["a", "b", "c"]), p.randomGaussian());
p.noiseSeed(7);
print(p.noise(0.5d), p.noise(1.25d, 2.5d), p.noise(0.1d, 0.2d, 0.3d));
p.noiseDetail(2, 0.75d);
print(p.noise(3.7d));
print(p.bezierPoint(0, 10, 20, 30, 0.5d), p.bezierTangent(0, 10, 20, 30, 0.5d), p.curvePoint(0, 10, 20, 30, 0.5d), p.curveTangent(0, 10, 20, 30, 0.5d));
var c = p.color(255, 128, 0);
print(c, p.red(c), p.green(c), p.blue(c), p.alpha(c), p.hue(c), p.saturation(c), p.brightness(c));
print(p.color(128), p.color(128, 64), p.color(10, 20, 30, 40), p.lerpColor(p.color(0), p.color(255), 0.5d));
p.colorMode(p.HSB, 360, 100, 100);
print(p.color(120, 100, 100), p.hue(p.color(120, 100, 100)));
p.colorMode(p.RGB, 255);
var v = p.createVector(3, 4);
print(v.x, v.y, v.z, v.mag(), v.heading());
var w = p.PVector(1, 2, 3);
print(w.copy().add(v).x, w.dot([1, 1, 1]), w.cross(v).z, w.copy().normalize().mag(), w.dist(v));
print(v.copy().mult(2).x, v.copy().div(2).y, v.copy().limit(1).mag(), v.copy().setMag(10).x, v.copy().rotate(p.HALF_PI).x);
print(v.array(), w.angleBetween(v), v.copy().lerp([0, 0, 0], 0.5d).x);
var 繪 = 匯入("繪圖");
print(繪.平方(3), 繪.寬度);
