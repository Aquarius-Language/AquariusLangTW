# (needs a window) Blend modes, axis rotation, applyMatrix, pixel set/get, filters, blend(), copy(), shapes and OBJ models.
var p = import("Processing");
var setup = function() { p.size(200, 120, p.P2D, "drawing extras"); };
var draw = function() {
    p.background(100);
    p.noStroke();
    # Blend modes over the gray background.
    p.blendMode(p.SUBTRACT); p.fill(50, 0, 100); p.rect(0, 0, 20, 20);
    p.blendMode(p.LIGHTEST); p.fill(200, 50, 50); p.rect(20, 0, 20, 20);
    p.blendMode(p.DARKEST); p.fill(200, 50, 50); p.rect(40, 0, 20, 20);
    p.blendMode(p.EXCLUSION); p.fill(255, 255, 255); p.rect(60, 0, 20, 20);
    p.blendMode(p.BLEND);
    # applyMatrix(6 numbers) as a translation, rotate(angle, axis) about z.
    p.pushMatrix(); p.applyMatrix(1, 0, 90, 0, 1, 5); p.fill(0, 200, 0); p.rect(0, 0, 10, 10); p.popMatrix();
    p.pushMatrix(); p.translate(115, 10); p.rotate(p.HALF_PI, 0, 0, 1); p.fill(0, 0, 200); p.rect(0, 0, 10, 5); p.popMatrix();
    # Primitive and group shapes; shape(s, x, y, w, h) scales to the box.
    p.fill(250, 200, 0);
    var square = p.createShape(p.RECT, 0, 0, 10, 10);
    var group = p.createShape(p.GROUP);
    p.fill(200, 0, 200);
    group.addChild(square);
    group.addChild(p.createShape(p.ELLIPSE, 15, 5, 10, 10));
    p.shape(group, 130, 0);
    p.shape(square, 160, 0, 20, 20);
    var hidden = p.createShape(p.RECT, 0, 30, 10, 10);
    hidden.setVisible(false);
    p.shape(hidden);
    # Pixels written one at a time batch into one draw.
    for (var i = 0; i < 20; i++) { p.set(i, 40, p.color(255, 0, 0)); }
    print("children", group.getChildCount(), group.getChild(0).getWidth(), square.getHeight(), hidden.isVisible());
    p.loadPixels();
    print(p.get(5, 5), p.get(25, 5), p.get(45, 5), p.get(65, 5), p.get(95, 10), p.get(112, 15));
    print(p.get(135, 5), p.get(145, 5), p.get(175, 15), p.get(5, 35), p.get(10, 40), p.get(25, 40));
    # copy() within the canvas and blend() from an image.
    p.copy(0, 0, 20, 20, 0, 60, 20, 20);
    var tile = p.createImage(10, 10, p.RGB);
    tile.loadPixels();
    var px = tile.pixels;
    for (var k = 0; k < 100; k++) { px[k] = p.color(0, 0, 255); }
    tile.updatePixels();
    p.blend(tile, 0, 0, 10, 10, 30, 60, 10, 10, p.ADD);
    var img = p.createImage(5, 5, p.RGB);
    img.set(2, 2, p.color(255));
    img.filter(p.DILATE);
    print(p.get(5, 65), p.get(35, 65), img.get(2, 1), img.get(0, 0), img.get(2, 2));
    p.exit();
};
p.run(setup, draw);
