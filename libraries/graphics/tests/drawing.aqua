# (needs a window) Drawing primitives, transforms, curves, 3D lighting and offscreen canvases, sampled as pixels.
var p = import("Processing");
var setup = function() { p.size(320, 240, p.P2D, "drawing test"); };
var draw = function() {
    p.background(255);
    p.stroke(0); p.strokeWeight(4); p.fill(200, 30, 30);
    p.rect(10, 10, 60, 40, 8);
    p.ellipseMode(p.CENTER); p.fill(30, 200, 30, 128); p.ellipse(120, 30, 60, 40);
    p.noFill(); p.stroke(30, 30, 200); p.strokeWeight(6); p.strokeCap(p.ROUND);
    p.bezier(170, 10, 220, 60, 260, -20, 310, 50);
    p.pushMatrix(); p.translate(60, 140); p.rotate(p.QUARTER_PI); p.scale(1.5d);
    p.noStroke(); p.fill(250, 160, 0); p.triangle(-20, 20, 20, 20, 0, -20); p.popMatrix();
    p.fill(0, 120, 255); p.beginShape(); p.vertex(140, 100); p.vertex(200, 110); p.vertex(190, 170); p.beginContour();
    p.vertex(165, 125); p.vertex(175, 150); p.vertex(185, 125); p.endContour(); p.endShape(p.CLOSE);
    p.stroke(0); p.strokeWeight(1); p.line(0, 230, 320, 200);
    p.blendMode(p.ADD); p.fill(100, 0, 0); p.rect(220, 100, 60, 60); p.blendMode(p.BLEND);
    p.loadPixels();
    print(p.get(20, 20), p.get(10, 10), p.get(120, 30), p.get(170, 10), p.get(60, 140), p.get(150, 110), p.get(175, 135), p.get(250, 130), p.get(160, 230), p.get(300, 210));
    p.exit();
};
p.run(setup, draw);
var p3 = function() {
    p.size(160, 120, p.P3D, "3D test");
};
p.run(p3, function() {
    p.background(20);
    p.lights(); p.noStroke(); p.fill(200, 100, 50);
    p.pushMatrix(); p.translate(50, 60, 0); p.rotateY(0.6d); p.rotateX(0.4d); p.box(40); p.popMatrix();
    p.pushMatrix(); p.translate(115, 60, 0); p.sphereDetail(16); p.sphere(25); p.popMatrix();
    p.loadPixels();
    print(p.get(50, 60), p.get(115, 60), p.get(115, 40), p.get(5, 5), p.get(80, 100));
    p.exit();
});
true;
