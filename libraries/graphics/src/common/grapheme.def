/* Grapheme_Cluster_Break and Extended_Pictographic ranges (Unicode 15.1, GraphemeBreakProperty.txt / emoji-data.txt),
   as X(first, last, PROPERTY). Hangul syllables (LV/LVT) are computed, CR/LF are handled in code. */

/* Control: Cc (except CR, LF), line/paragraph separators and most format characters. */
X(0x0000, 0x0009, CONTROL) X(0x000B, 0x000C, CONTROL) X(0x000E, 0x001F, CONTROL) X(0x007F, 0x009F, CONTROL)
X(0x00AD, 0x00AD, CONTROL) X(0x061C, 0x061C, CONTROL) X(0x180E, 0x180E, CONTROL) X(0x200B, 0x200B, CONTROL)
X(0x200E, 0x200F, CONTROL) X(0x2028, 0x202E, CONTROL) X(0x2060, 0x206F, CONTROL) X(0xFEFF, 0xFEFF, CONTROL)
X(0xFFF0, 0xFFFB, CONTROL) X(0x13430, 0x1343F, CONTROL) X(0x1BCA0, 0x1BCA3, CONTROL) X(0x1D173, 0x1D17A, CONTROL)
X(0xE0000, 0xE001F, CONTROL) X(0xE0080, 0xE00FF, CONTROL) X(0xE01F0, 0xE0FFF, CONTROL)

/* Prepend */
