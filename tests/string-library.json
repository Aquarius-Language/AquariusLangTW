{
  "valid": [
    [
      "Module aliases share identity",
      "String==字串;",
      "真"
    ],
    [
      "From formats like print",
      "[String.From(12),String.From(-7),String.From(2.5d),String.From(0.1d),String.From(1.1f),String.From(真),String.From([1,\"a\",{\"k\":假}])];",
      "[12, -7, 2.5, 0.1, 1.1, 真, [1, a, {k: 假}]]"
    ],
    [
      "From uses shortest round-trip digits",
      "[String.From(1.0d/3),String.From(0.1d+0.2d),String.From(100000000000000000000.0d),String.From(1000000000000000000000.0d),String.From(0.000001d),String.From(0.0000001d)];",
      "[0.3333333333333333, 0.30000000000000004, 100000000000000000000, 1e+21, 0.000001, 1e-7]"
    ],
    [
      "From concatenates with text",
      "\"分數：\"+String.From(98);",
      "分數：98"
    ],
    [
      "Slice uses UTF-16 indexes",
      "[String.Slice(\"星泉語言\",1,3),String.Slice(\"abc\",0,0),String.Slice(\"abc\",3,3)];",
      "[泉語, , ]"
    ],
    [
      "Find, Contains, StartsWith and EndsWith",
      "變數 s=\"ws://host:8081/x\";[String.Find(s,\"://\"),String.Find(s,\"?\"),String.Contains(s,\"8081\"),String.StartsWith(s,\"ws\"),String.EndsWith(s,\"/x\"),String.EndsWith(\"a\",\"abc\")];",
      "[2, -1, 真, 真, 真, 假]"
    ],
    [
      "Split keeps empty fields",
      "String.Split(\"a,b,,c\",\",\");",
      "[a, b, , c]"
    ],
    [
      "Split by empty separator yields code points",
      "String.Split(\"你好🎉\",\"\");",
      "[你, 好, 🎉]"
    ],
    [
      "Join formats each element",
      "String.Join([1,\"二\",3.5d,真],\"-\");",
      "1-二-3.5-真"
    ],
    [
      "Replace substitutes every match",
      "[String.Replace(\"aXbXc\",\"X\",\"##\"),String.Replace(\"aaa\",\"aa\",\"b\")];",
      "[a##b##c, ba]"
    ],
    [
      "Trim removes ASCII and ideographic spaces",
      "String.Trim(\"　 \t星泉\n \");",
      "星泉"
    ],
    [
      "Case conversion covers ASCII and full-width letters",
      "[String.Upper(\"abcＡｂｃ1\"),String.Lower(\"HeLLo Ｗ\")];",
      "[ABCＡＢＣ1, hello ｗ]"
    ],
    [
      "Repeat",
      "[String.Repeat(\"ab\",3),String.Repeat(\"x\",0)];",
      "[ababab, ]"
    ],
    [
      "Code and FromCode handle supplementary characters",
      "[String.Code(\"🎉\",0),String.Code(\"a\",5),String.FromCode(26143),String.FromCode(127881)];",
      "[127881, null, 星, 🎉]"
    ],
    [
      "ParseInt accepts only 32-bit decimal integers",
      "[String.ParseInt(\" -42 \"),String.ParseInt(\"+7\"),String.ParseInt(\"x1\"),String.ParseInt(\"\"),String.ParseInt(\"2147483648\"),String.ParseInt(\"-2147483648\")];",
      "[-42, 7, null, null, null, -2147483648]"
    ]
  ],
  "invalid": [
    "String.Slice(\"abc\",2,1);",
    "String.Slice(\"abc\",0,4);",
