<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AquariusCore/AquariusCore.csproj" />
    <ProjectReference Include="../AquariusPackaging/AquariusPackaging.csproj" />
    <EmbeddedResource Include="browser/**/*" Exclude="browser/node_modules/**/*;browser/application-core.mjs;browser/physics-core.mjs;browser/vendor-jolt*;browser/audio-core.mjs;browser/values.mjs;browser/wasm-host.mjs;browser/wasm-manifest.mjs;browser/package-paths.mjs;browser/processing.mjs;browser/capability-host.mjs;browser/wgpu-uniforms.mjs;browser/surface-size.mjs;browser/vendor-gl-matrix.mjs;browser/vendor-earcut.mjs;browser/onnx-registration.mjs;browser/audio-registration.mjs;browser/mediapipe.mjs;browser/application-runtime.mjs;browser/application-serialization.mjs;browser/shader-layout.mjs;browser/wgpu-textures.mjs;browser/vendor-fflate.mjs;browser/codec-engine.mjs;browser/vendor-magick.mjs" />
    <EmbeddedResource Include="../AquariusCore/hosting/*.mjs" Exclude="../AquariusCore/hosting/surface.mjs;../AquariusCore/hosting/physics-core.mjs;../AquariusCore/hosting/application-core.mjs;../AquariusCore/hosting/audio-core.mjs" LogicalName="AquariusWebCompiler.browser.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../AquariusCore/application/portable.mjs" LogicalName="AquariusWebCompiler.browser.application-core.mjs" />
  </ItemGroup>
</Project>
