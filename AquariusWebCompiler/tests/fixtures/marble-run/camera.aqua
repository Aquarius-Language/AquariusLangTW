變數 繪圖模組 = 匯入("Processing");
變數 視點 = [0, 20, 34];
變數 注視目標 = [0, 12, 18];
變數 俯瞰模式 = 假;
變數 跟隨距離 = 11.0d;
變數 下次立即定位 = 真;
變數 切換模式 = 函式() { 俯瞰模式 = !俯瞰模式; 下次立即定位 = 真; };
變數 立即定位 = 函式() { 下次立即定位 = 真; };
變數 調整距離 = 函式(調整量) { 跟隨距離 = 繪圖模組.限制範圍(跟隨距離-調整量, 7, 20); };
變數 更新鏡頭狀態 = 函式(時間差, 狀態資料) {
    變數 位置 = 狀態資料["position"];
    變數 預期視點 = [位置[0], 位置[1]+跟隨距離*0.65d, 位置[2]+跟隨距離];
    變數 預期目標 = [位置[0], 位置[1]-0.2d, 位置[2]-3.0d];
    如果 (俯瞰模式) { 預期視點 = [32, 37, 40]; 預期目標 = [0, 6, -8]; }
    變數 混合比例 = 1-繪圖模組.指數(-時間差*7);
    如果 (下次立即定位) { 混合比例 = 1.0d; 下次立即定位 = 假; }
    迴圈 (變數 索引 = 0; 索引 < 3; 索引++) {
        視點[索引] = 繪圖模組.線性插值(視點[索引], 預期視點[索引], 混合比例);
        注視目標[索引] = 繪圖模組.線性插值(注視目標[索引], 預期目標[索引], 混合比例);
    }
    回傳 {"eye": 視點, "target": 注視目標, "overview": 俯瞰模式};
};
