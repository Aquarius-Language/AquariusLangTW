變數 物理引擎 = 匯入("Jolt");
變數 繪圖模組 = 匯入("Processing");
變數 設定模組 = 匯入(目前工作目錄 + "/config.aqua");
變數 數學模組 = 匯入(目前工作目錄 + "/math3d.aqua");
變數 向量相減 = 數學模組.向量相減; 變數 反向旋轉向量 = 數學模組.反向旋轉向量;
變數 物理世界 = 0;
變數 彈珠 = 0;
變數 賽道資料 = 0;
變數 檢查點索引 = 0;
變數 經過時間 = 0.0d;
變數 累計罰時 = 0.0d;
變數 墜落次數 = 0;
變數 已完成 = 假;
變數 已暫停 = 假;
變數 已開始 = 假;
變數 最佳時間 = 0.0d;
變數 已著地 = 假;
變數 累積時間 = 0.0d;
變數 跳躍待執行 = 假;
變數 跳躍冷卻時間 = 0.0d;
變數 前次位置 = [0, 0, 0];
變數 目前位置 = [0, 0, 0];

變數 放置於檢查點 = 函式() {
    變數 節點 = 賽道資料["nodes"][檢查點索引];
    目前位置 = [節點[0], 節點[1]+設定模組.彈珠半徑+0.22d, 節點[2]];
    前次位置 = 目前位置;
    物理世界.設定位置(彈珠, 目前位置);
    物理世界.設定旋轉(彈珠, [0, 0, 0, 1]);
    物理世界.設定線速度(彈珠, [0, 0, 0]);
    物理世界.設定角速度(彈珠, [0, 0, 0]);
    累積時間 = 0.0d; 跳躍待執行 = 假; 跳躍冷卻時間 = 0.3d;
};
變數 重新開始 = 函式() {
    檢查點索引 = 0; 經過時間 = 0.0d; 累計罰時 = 0.0d; 墜落次數 = 0;
    已完成 = 假; 已暫停 = 假; 已開始 = 假; 已著地 = 假;
    放置於檢查點();
};
變數 初始化 = 函式(新賽道資料) {
    賽道資料 = 新賽道資料;
    物理世界 = 物理引擎.建立世界([0, -9.81d, 0]);
    變數 構件資料列表 = 賽道資料["pieces"];
    迴圈 (變數 索引 = 0; 索引 < 長度(構件資料列表); 索引++) {
        變數 構件 = 構件資料列表[索引]; 變數 尺寸 = 構件["size"];
        變數 剛體 = 物理世界.建立方塊([尺寸[0]/2, 尺寸[1]/2, 尺寸[2]/2], 構件["position"], 0);
        物理世界.設定旋轉(剛體, 構件["rotation"]);
        物理世界.設定摩擦力(剛體, 0.45d);
    }
    彈珠 = 物理世界.建立球體(設定模組.彈珠半徑, [0, 14, 22], 設定模組.彈珠質量);
    物理世界.設定摩擦力(彈珠, 0.55d); 物理世界.設定恢復係數(彈珠, 0.08d);
    物理世界.最佳化廣域碰撞();
    重新開始();
};
變數 重生 = 函式() {
    如果 (已完成) { 回傳 假; }
    墜落次數++; 累計罰時 += 設定模組.重生罰時;
    放置於檢查點();
    回傳 真;
};
變數 切換暫停 = 函式() { 如果 (!已完成) { 已暫停 = !已暫停; 累積時間 = 0.0d; } };
變數 排入跳躍 = 函式() { 如果 (!已暫停 && !已完成) { 跳躍待執行 = 真; } };
# Approximate sphere support against the same oriented floors used by Jolt.
# Contacts remain entirely Jolt's job; this only decides whether jumping is allowed.
變數 位於地板上 = 函式(位置) {
    變數 斜坡資料列表 = 賽道資料["ramps"];
    迴圈 (變數 索引 = 0; 索引 < 長度(斜坡資料列表); 索引++) {
        變數 斜坡 = 斜坡資料列表[索引]; 變數 尺寸 = 斜坡["size"];
        變數 區域座標 = 反向旋轉向量(斜坡["rotation"], 向量相減(位置, 斜坡["position"]));
        變數 離地高度 = 區域座標[1]-尺寸[1]/2;
        如果 (繪圖模組.絕對值(區域座標[0]) < 尺寸[0]/2 && 繪圖模組.絕對值(區域座標[2]) < 尺寸[2]/2 &&
            離地高度 > 設定模組.彈珠半徑-0.09d && 離地高度 < 設定模組.彈珠半徑+0.12d) { 回傳 真; }
    }
    回傳 假;
};
變數 推進模擬 = 函式(畫格時間, 輸入資料) {
    如果 (已暫停 || 已完成) { 回傳 真; }
    如果 (輸入資料[0] != 0 || 輸入資料[1] != 0 || 跳躍待執行) { 已開始 = 真; }
    累積時間 += 繪圖模組.最小值(畫格時間, 設定模組.最大畫格時間);
    迴圈 (變數 更新次數 = 0; 累積時間 >= 設定模組.固定時間步長 && 更新次數 < 12; 更新次數++) {
        累積時間 -= 設定模組.固定時間步長;
        前次位置 = 目前位置;
        已著地 = 位於地板上(目前位置);
        跳躍冷卻時間 = 繪圖模組.最大值(0, 跳躍冷卻時間-設定模組.固定時間步長);
        變數 速度向量 = 物理世界.取得線速度(彈珠);
        變數 阻力 = 設定模組.滾動阻力;
        如果 (輸入資料[2]) { 阻力 = 設定模組.煞車阻力; }
        物理世界.加入力(彈珠, [輸入資料[0]*設定模組.轉向力-速度向量[0]*阻力,
            0, 輸入資料[1]*設定模組.轉向力-速度向量[2]*阻力]);
        如果 (跳躍待執行 && 已著地 && 跳躍冷卻時間 <= 0) {
            物理世界.加入衝量(彈珠, [0, 設定模組.跳躍衝量, 0]); 跳躍冷卻時間 = 0.45d;
        }
        # A key press is consumed once, even if it was made in mid-air.
        跳躍待執行 = 假;
        物理世界.步進(設定模組.固定時間步長, 1);
        目前位置 = 物理世界.取得位置(彈珠);
        如果 (已開始) { 經過時間 += 設定模組.固定時間步長; }
        變數 檢查門資料列表 = 賽道資料["gates"];
        如果 (檢查點索引 < 長度(檢查門資料列表)) {
            變數 檢查門 = 檢查門資料列表[檢查點索引];
            變數 橫向距離 = 目前位置[0]-檢查門[0]; 變數 縱向距離 = 目前位置[2]-檢查門[2];
            如果 (橫向距離*橫向距離+縱向距離*縱向距離 < 2.0d*2.0d &&
                目前位置[1] > 檢查門[1]-0.3d && 目前位置[1] < 檢查門[1]+2.2d) {
                檢查點索引++; 已開始 = 真;
                如果 (檢查點索引 == 長度(檢查門資料列表)) {
                    已完成 = 真;
                    變數 完成時間 = 經過時間+累計罰時;
                    如果 (最佳時間 == 0 || 完成時間 < 最佳時間) { 最佳時間 = 完成時間; }
                    累積時間 = 0.0d;
                    中斷;
                }
            }
        }
        變數 安全高度 = 賽道資料["nodes"][檢查點索引][1];
        如果 (目前位置[1] < 安全高度-5 || 繪圖模組.絕對值(目前位置[0]) > 25 || 目前位置[2] < -48 || 目前位置[2] > 32) {
            重生(); 中斷;
        }
    }
    回傳 真;
};
變數 取得狀態快照 = 函式() {
    變數 插值比例 = 繪圖模組.限制範圍(累積時間/設定模組.固定時間步長, 0, 1);
    如果 (已暫停 || 已完成) { 插值比例 = 1.0d; }
    變數 顯示位置 = [繪圖模組.線性插值(前次位置[0], 目前位置[0], 插值比例),
        繪圖模組.線性插值(前次位置[1], 目前位置[1], 插值比例), 繪圖模組.線性插值(前次位置[2], 目前位置[2], 插值比例)];
    變數 速度向量 = 物理世界.取得線速度(彈珠);
    回傳 {"position": 顯示位置, "rotation": 物理世界.取得旋轉(彈珠),
        "speed": 繪圖模組.平方根(速度向量[0]*速度向量[0]+速度向量[2]*速度向量[2]),
        "checkpoint": 檢查點索引, "elapsed": 經過時間+累計罰時, "falls": 墜落次數,
        "finished": 已完成, "paused": 已暫停, "started": 已開始, "best": 最佳時間};
};
變數 釋放資源 = 函式() { 物理世界.釋放(); };
