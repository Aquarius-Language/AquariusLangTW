# Composition root: modules own the course, simulation, input, camera and drawing.
變數 繪圖模組 = 匯入("Processing");
變數 設定模組 = 匯入(目前工作目錄 + "/config.aqua");
變數 賽道模組 = 匯入(目前工作目錄 + "/track.aqua");
變數 物理模組 = 匯入(目前工作目錄 + "/physics.aqua");
變數 輸入模組 = 匯入(目前工作目錄 + "/input.aqua");
變數 鏡頭模組 = 匯入(目前工作目錄 + "/camera.aqua");
變數 渲染模組 = 匯入(目前工作目錄 + "/renderer.aqua");
變數 介面模組 = 匯入(目前工作目錄 + "/hud.aqua");
# Bind exported functions locally so arguments always use the caller's scope.
變數 建立賽道 = 賽道模組.建立;
變數 初始化物理 = 物理模組.初始化; 變數 推進模擬 = 物理模組.推進模擬;
變數 取得狀態快照 = 物理模組.取得狀態快照; 變數 重生 = 物理模組.重生;
變數 重新開始 = 物理模組.重新開始; 變數 排入跳躍 = 物理模組.排入跳躍;
變數 切換暫停 = 物理模組.切換暫停; 變數 釋放物理資源 = 物理模組.釋放資源;
變數 讀取輸入 = 輸入模組.讀取按鍵;
變數 更新鏡頭 = 鏡頭模組.更新鏡頭狀態; 變數 立即定位鏡頭 = 鏡頭模組.立即定位;
變數 切換鏡頭 = 鏡頭模組.切換模式; 變數 縮放鏡頭 = 鏡頭模組.調整距離;
變數 初始化渲染 = 渲染模組.初始化; 變數 繪製場景 = 渲染模組.繪製畫面;
變數 初始化介面 = 介面模組.初始化; 變數 繪製介面 = 介面模組.繪製畫面;
變數 前次時間 = 0.0d;
變數 賽道資料 = 建立賽道();
變數 設定場景 = 函式() {
    繪圖模組.尺寸(設定模組.視窗寬度, 設定模組.視窗高度, 繪圖模組.P2D, "Aquarius｜彈珠競速－高空速降");
    繪圖模組.影格率(60);
    初始化物理(賽道資料); 初始化渲染(賽道資料); 初始化介面(賽道資料);
    繪圖模組.註冊事件("keyPressed", 函式() {
        如果 (繪圖模組.keyCode == 80) { 切換暫停(); }
        如果 (繪圖模組.keyCode == 67) { 切換鏡頭(); }
        如果 (繪圖模組.keyCode == 74) { 排入跳躍(); }
        如果 (繪圖模組.keyCode == 82) { 重生(); 立即定位鏡頭(); }
        如果 (繪圖模組.keyCode == 257) { 重新開始(); 立即定位鏡頭(); }
    });
    繪圖模組.註冊事件("mouseWheel", 函式() { 縮放鏡頭(繪圖模組.wheelCount); });
    前次時間 = 繪圖模組.毫秒()/1000.0d;
    印出("轉向：WASD／方向鍵｜煞車：空白鍵｜跳躍：J｜重生：R｜重新開始：Enter");
};
變數 繪製畫面 = 函式() {
    變數 目前時間 = 繪圖模組.毫秒()/1000.0d;
    變數 時間差 = 繪圖模組.限制範圍(目前時間-前次時間, 0, 設定模組.最大畫格時間);
    前次時間 = 目前時間;
    變數 輸入資料 = 讀取輸入();
    推進模擬(時間差, 輸入資料);
    變數 狀態資料 = 取得狀態快照();
    變數 鏡頭資料 = 更新鏡頭(時間差, 狀態資料);
    繪製場景(狀態資料, 鏡頭資料); 繪製介面(狀態資料, 鏡頭資料);
};
繪圖模組.執行(設定場景, 繪製畫面);
釋放物理資源();
真;
