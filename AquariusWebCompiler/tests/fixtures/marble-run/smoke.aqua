# 使用真正的 wgpu 與 Jolt，逐一繪製並檢查遊戲狀態。
變數 繪圖模組 = 匯入("Processing");
變數 設定模組 = 匯入(目前工作目錄 + "/config.aqua");
變數 賽道模組 = 匯入(目前工作目錄 + "/track.aqua");
變數 物理模組 = 匯入(目前工作目錄 + "/physics.aqua");
變數 輸入模組 = 匯入(目前工作目錄 + "/input.aqua");
變數 鏡頭模組 = 匯入(目前工作目錄 + "/camera.aqua");
變數 渲染模組 = 匯入(目前工作目錄 + "/renderer.aqua");
變數 介面模組 = 匯入(目前工作目錄 + "/hud.aqua");
變數 建立賽道 = 賽道模組.建立;
變數 初始化物理 = 物理模組.初始化; 變數 推進模擬 = 物理模組.推進模擬;
變數 取得狀態 = 物理模組.取得狀態快照; 變數 重生 = 物理模組.重生;
變數 重新開始 = 物理模組.重新開始; 變數 排入跳躍 = 物理模組.排入跳躍;
變數 切換暫停 = 物理模組.切換暫停; 變數 釋放物理 = 物理模組.釋放資源;
變數 讀取按鍵 = 輸入模組.讀取按鍵;
變數 更新鏡頭 = 鏡頭模組.更新鏡頭狀態; 變數 切換鏡頭 = 鏡頭模組.切換模式;
變數 定位鏡頭 = 鏡頭模組.立即定位; 變數 縮放鏡頭 = 鏡頭模組.調整距離;
變數 初始化渲染 = 渲染模組.初始化; 變數 繪製場景 = 渲染模組.繪製畫面;
變數 初始化介面 = 介面模組.初始化; 變數 繪製介面 = 介面模組.繪製畫面;
變數 賽道資料 = 建立賽道();
變數 階段 = 0;
變數 完賽時間 = 0.0d;
變數 驗證 = 函式(條件, 說明) {
    如果 (!條件) {
        印出("驗證失敗：", 說明);
        # 故意省略必要參數，讓 VM 回報錯誤並以非零代碼結束。
        回傳 長度();
    }
};
變數 設定場景 = 函式() {
    繪圖模組.尺寸(設定模組.視窗寬度, 設定模組.視窗高度, 繪圖模組.P2D, "彈珠競速｜整合驗證");
    繪圖模組.影格率(60);
    初始化物理(賽道資料); 初始化渲染(賽道資料); 初始化介面(賽道資料);
    驗證(長度(賽道資料["gates"]) == 6, "六道檢查門");
};
變數 繪製畫面 = 函式() {
    變數 物理世界 = 物理模組.物理世界; 變數 彈珠 = 物理模組.彈珠;
    變數 狀態 = 取得狀態();
    如果 (階段 == 0) {
        驗證(!狀態["started"] && 狀態["elapsed"] == 0, "初始狀態");
        驗證(長度(讀取按鍵()) == 3, "原生按鍵讀取");
    }
    如果 (階段 == 1) {
        迴圈 (變數 次數 = 0; 次數 < 60; 次數++) { 推進模擬(1.0d/60, [0, -1, 假]); }
        狀態 = 取得狀態();
        驗證(狀態["started"] && 狀態["elapsed"] > 0 && 狀態["speed"] > 0, "轉向與計時");
        變數 原速度 = 狀態["speed"];
        推進模擬(1.0d/60, [0, 0, 真]);
        狀態 = 取得狀態(); 驗證(狀態["speed"] < 原速度, "煞車減速");
    }
    如果 (階段 == 2) {
        切換暫停(); 狀態 = 取得狀態();
        變數 暫停時間 = 狀態["elapsed"];
        推進模擬(0.1d, [1, -1, 假]); 狀態 = 取得狀態();
        驗證(狀態["paused"] && 狀態["elapsed"] == 暫停時間, "暫停凍結計時");
    }
    如果 (階段 == 3) { 切換暫停(); 切換鏡頭(); 縮放鏡頭(100); 狀態 = 取得狀態(); }
    如果 (階段 == 4) {
        變數 原時間 = 狀態["elapsed"];
        重生(); 定位鏡頭(); 狀態 = 取得狀態();
        驗證(狀態["falls"] == 1 && 狀態["elapsed"] == 原時間+設定模組.重生罰時, "重生罰時");
    }
    如果 (階段 == 5) {
        重新開始(); 切換鏡頭(); 縮放鏡頭(-100);
        迴圈 (變數 次數 = 0; 次數 < 60; 次數++) { 推進模擬(1.0d/60, [0, 0, 假]); }
        排入跳躍(); 推進模擬(1.0d/60, [0, 0, 假]);
        變數 速度 = 物理世界.取得線速度(彈珠);
        驗證(速度[1] > 1, "著地後跳躍衝量"); 狀態 = 取得狀態();
    }
    如果 (階段 == 6) {
        變數 檢查門 = 賽道資料["gates"][0];
        物理世界.設定位置(彈珠, [檢查門[0], 檢查門[1]+設定模組.彈珠半徑, 檢查門[2]]);
        物理世界.設定線速度(彈珠, [0, 0, 0]); 推進模擬(1.0d/60, [0, 0, 假]);
        狀態 = 取得狀態(); 驗證(狀態["checkpoint"] == 1, "通過第一道檢查門");
        物理世界.設定位置(彈珠, [30, 0, 0]); 推進模擬(1.0d/60, [0, 0, 假]);
        狀態 = 取得狀態(); 驗證(狀態["falls"] == 1 && 狀態["checkpoint"] == 1, "墜落後在檢查點重生");
    }
    如果 (階段 == 7) {
        迴圈 (變數 索引 = 1; 索引 < 6; 索引++) {
            變數 檢查門 = 賽道資料["gates"][索引];
            物理世界.設定位置(彈珠, [檢查門[0], 檢查門[1]+設定模組.彈珠半徑, 檢查門[2]]);
            物理世界.設定線速度(彈珠, [0, 0, 0]); 推進模擬(1.0d/60, [0, 0, 假]);
            狀態 = 取得狀態(); 驗證(狀態["checkpoint"] == 索引+1, "依序通過檢查門");
        }
        完賽時間 = 狀態["elapsed"];
        驗證(狀態["finished"] && 狀態["best"] == 完賽時間, "完賽與最佳紀錄");
        推進模擬(0.1d, [1, -1, 假]);
        驗證(!重生() && 取得狀態()["elapsed"] == 完賽時間, "完賽後停止模擬與重生");
    }
    如果 (階段 == 8) {
        重新開始(); 狀態 = 取得狀態();
        驗證(!狀態["finished"] && !狀態["started"] && 狀態["elapsed"] == 0 && 狀態["falls"] == 0 && 狀態["best"] == 完賽時間, "重新開始保留最佳紀錄");
        繪圖模組.調整尺寸(960, 600);
    }
    變數 鏡頭 = 更新鏡頭(1.0d/60, 狀態);
    如果 (階段 == 3) { 驗證(鏡頭["overview"], "俯瞰鏡頭"); }
    如果 (階段 == 5) { 驗證(!鏡頭["overview"], "跟隨鏡頭"); }
    繪製場景(狀態, 鏡頭); 繪製介面(狀態, 鏡頭);
    如果 (階段 == 10) {
        驗證(繪圖模組.width == 960 && 繪圖模組.height == 600, "視窗縮放");
        印出("整合驗證通過"); 繪圖模組.結束();
    }
    階段++;
};
繪圖模組.執行(設定場景, 繪製畫面);
釋放物理();
驗證(階段 == 11, "所有驗證階段皆完成");
真;
