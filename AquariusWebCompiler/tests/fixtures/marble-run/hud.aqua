變數 繪圖模組 = 匯入("Processing");
變數 設定模組 = 匯入(目前工作目錄 + "/config.aqua");
變數 賽道資料 = 0;
變數 初始化 = 函式(新賽道資料) {
    賽道資料 = 新賽道資料;
    繪圖模組.文字字型(繪圖模組.建立字型("Microsoft JhengHei", 16));
};
變數 繪製面板 = 函式(橫向座標, 垂直座標, 面板寬度, 面板高度) {
    繪圖模組.停用描邊(); 繪圖模組.填色(12, 22, 36, 225); 繪圖模組.矩形(橫向座標, 垂直座標, 面板寬度, 面板高度, 12);
};
變數 繪製文字 = 函式(數值, 橫向座標, 垂直座標, 字級, 色彩) {
    繪圖模組.填色(色彩[0], 色彩[1], 色彩[2]); 繪圖模組.文字大小(字級); 繪圖模組.文字(數值, 橫向座標, 垂直座標);
};
變數 白色 = [235, 242, 247];
變數 柔和色 = [143, 164, 183];
變數 藍綠色 = [76, 213, 189];
變數 金色 = [255, 190, 80];
變數 取秒數 = 函式(數值) { 回傳 繪圖模組.向下取整(數值*100)/100.0d; };
變數 繪製畫面 = 函式(狀態資料, 鏡頭資料) {
    變數 介面縮放比例 = 繪圖模組.最小值(繪圖模組.width*1.0d/設定模組.視窗寬度, 繪圖模組.height*1.0d/設定模組.視窗高度);
    繪圖模組.推入矩陣();
    繪圖模組.平移((繪圖模組.width-設定模組.視窗寬度*介面縮放比例)/2, (繪圖模組.height-設定模組.視窗高度*介面縮放比例)/2); 繪圖模組.縮放(介面縮放比例);
    繪製面板(24, 24, 346, 96);
    繪製文字("彈珠競速", 44, 61, 28, 白色);
    繪製文字("高空速降", 45, 88, 12, 藍綠色);
    繪製文字("wgpu 繪圖 + Jolt 物理引擎", 45, 107, 11, 柔和色);
    繪製面板(842, 24, 414, 96);
    繪製文字("時間／秒", 865, 49, 11, 柔和色);
    繪製文字(取秒數(狀態資料["elapsed"]), 863, 88, 30, 白色);
    繪製文字("速度／公尺每秒", 1004, 49, 11, 柔和色);
    繪製文字(繪圖模組.向下取整(狀態資料["speed"]*10)/10.0d, 1003, 88, 30, 藍綠色);
    繪製文字("墜落次數", 1155, 49, 11, 柔和色);
    繪製文字(狀態資料["falls"], 1155, 88, 30, 金色);
    繪製面板(1104, 140, 152, 232);
    繪製文字("賽道地圖", 1120, 164, 12, 柔和色);
    變數 節點資料列表 = 賽道資料["nodes"];
    迴圈 (變數 索引 = 0; 索引 < 長度(節點資料列表)-1; 索引++) {
        變數 向量甲 = 節點資料列表[索引]; 變數 向量乙 = 節點資料列表[索引+1];
        繪圖模組.描邊(51, 82, 101); 繪圖模組.描邊粗細(4);
        繪圖模組.線段(1180+向量甲[0]*7, 185+(22-向量甲[2])*2.4d, 1180+向量乙[0]*7, 185+(22-向量乙[2])*2.4d);
    }
    繪圖模組.停用描邊();
    迴圈 (變數 索引 = 0; 索引 < 長度(節點資料列表); 索引++) {
        變數 節點資料 = 節點資料列表[索引]; 繪圖模組.填色(62, 100, 122);
        如果 (索引 <= 狀態資料["checkpoint"]) { 繪圖模組.填色(76, 213, 189); }
        繪圖模組.圓形(1180+節點資料[0]*7, 185+(22-節點資料[2])*2.4d, 8);
    }
    變數 位置 = 狀態資料["position"];
    繪圖模組.填色(255, 126, 86);
    繪圖模組.圓形(1180+繪圖模組.限制範圍(位置[0], -8, 8)*7, 185+(22-繪圖模組.限制範圍(位置[2], -40, 24))*2.4d, 10);
    如果 (鏡頭資料["overview"]) { 繪製文字("俯瞰鏡頭", 1120, 353, 11, 金色); }
    否則 { 繪製文字("跟隨鏡頭", 1120, 353, 11, 柔和色); }
    繪製面板(24, 692, 1232, 84);
    繪製文字("WASD／方向鍵  轉向     空白鍵  煞車     J  跳躍", 44, 722, 15, 白色);
    繪製文字("R  重生（加罰 3 秒）     Enter  重新開始     P  暫停     C  切換鏡頭     滾輪  縮放     Esc  離開", 44, 751, 13, 柔和色);
    變數 檢查門數量 = 長度(賽道資料["gates"]);
    繪製文字("檢查點", 28, 660, 11, 柔和色);
    迴圈 (變數 索引 = 0; 索引 < 檢查門數量; 索引++) {
        繪圖模組.填色(34, 54, 73); 如果 (索引 < 狀態資料["checkpoint"]) { 繪圖模組.填色(76, 213, 189); }
        繪圖模組.矩形(134+索引*42, 645, 32, 17, 4);
    }
    如果 (狀態資料["best"] > 0) {
        繪製文字("本次最佳／秒", 1055, 659, 11, 柔和色);
        繪製文字(取秒數(狀態資料["best"]), 1190, 659, 16, 藍綠色);
    }
    如果 (!狀態資料["started"] && !狀態資料["finished"]) {
        繪製面板(400, 142, 480, 96);
        繪製文字("依序通過金色檢查門", 424, 175, 20, 白色);
        繪製文字("按 W／上方向鍵出發，轉彎時調整方向。", 424, 202, 14, 柔和色);
        繪製文字("利用重力滑行，入彎前記得煞車。", 424, 222, 13, 藍綠色);
    }
    如果 (狀態資料["paused"]) {
        繪製面板(450, 306, 380, 116);
        繪製文字("已暫停", 488, 351, 32, 金色);
        繪製文字("按 P 繼續遊戲", 488, 390, 16, 白色);
    }
    如果 (狀態資料["finished"]) {
        繪製面板(412, 262, 456, 242);
        變數 獎牌名稱 = "完賽"; 變數 色彩 = 藍綠色;
        如果 (狀態資料["elapsed"] <= 設定模組.金牌時間) { 獎牌名稱 = "金牌"; 色彩 = 金色; }
        否則如果 (狀態資料["elapsed"] <= 設定模組.銀牌時間) { 獎牌名稱 = "銀牌"; 色彩 = 白色; }
        繪製文字("完成賽道", 442, 305, 26, 白色);
        繪製文字(獎牌名稱, 443, 343, 20, 色彩);
        繪製文字("總時間（含墜落罰時）／秒", 443, 373, 11, 柔和色);
        繪製文字(取秒數(狀態資料["elapsed"]), 443, 418, 38, 色彩);
        繪製文字("按 Enter 再挑戰一次", 443, 458, 17, 白色);
        繪製文字("金牌：24 秒內／銀牌：38 秒內", 443, 484, 12, 柔和色);
    }
    繪圖模組.彈出矩陣();
};
