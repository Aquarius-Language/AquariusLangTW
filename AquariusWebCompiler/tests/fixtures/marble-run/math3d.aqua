變數 繪圖模組 = 匯入("Processing");
變數 向量相加 = 函式(向量甲, 向量乙) { 回傳 [向量甲[0] + 向量乙[0], 向量甲[1] + 向量乙[1], 向量甲[2] + 向量乙[2]]; };
變數 向量相減 = 函式(向量甲, 向量乙) { 回傳 [向量甲[0] - 向量乙[0], 向量甲[1] - 向量乙[1], 向量甲[2] - 向量乙[2]]; };
變數 向量縮放 = 函式(向量甲, 縮放係數) { 回傳 [向量甲[0] * 縮放係數, 向量甲[1] * 縮放係數, 向量甲[2] * 縮放係數]; };
變數 向量長度 = 函式(向量甲) { 回傳 繪圖模組.平方根(向量甲[0]*向量甲[0] + 向量甲[1]*向量甲[1] + 向量甲[2]*向量甲[2]); };
# Rotate a vector with a unit quaternion, matching Jolt's [x,y,z,w].
變數 旋轉向量 = 函式(四元數, 向量) {
    變數 叉積橫向分量 = 2 * (四元數[1]*向量[2] - 四元數[2]*向量[1]);
    變數 叉積垂直分量 = 2 * (四元數[2]*向量[0] - 四元數[0]*向量[2]);
    變數 叉積縱向分量 = 2 * (四元數[0]*向量[1] - 四元數[1]*向量[0]);
    回傳 [向量[0]+四元數[3]*叉積橫向分量+四元數[1]*叉積縱向分量-四元數[2]*叉積垂直分量,
          向量[1]+四元數[3]*叉積垂直分量+四元數[2]*叉積橫向分量-四元數[0]*叉積縱向分量,
          向量[2]+四元數[3]*叉積縱向分量+四元數[0]*叉積垂直分量-四元數[1]*叉積橫向分量];
};
變數 反向旋轉向量 = 函式(四元數, 向量) { 回傳 旋轉向量([-四元數[0], -四元數[1], -四元數[2], 四元數[3]], 向量); };
變數 沿向量旋轉 = 函式(差向量) {
    變數 偏航角 = 繪圖模組.雙參數反正切(差向量[0], 差向量[2]);
    變數 俯仰角 = -繪圖模組.雙參數反正切(差向量[1], 繪圖模組.平方根(差向量[0]*差向量[0] + 差向量[2]*差向量[2]));
    變數 俯仰正弦 = 繪圖模組.正弦(俯仰角 / 2); 變數 俯仰餘弦 = 繪圖模組.餘弦(俯仰角 / 2);
    變數 偏航正弦 = 繪圖模組.正弦(偏航角 / 2); 變數 偏航餘弦 = 繪圖模組.餘弦(偏航角 / 2);
    回傳 [偏航餘弦*俯仰正弦, 偏航正弦*俯仰餘弦, -偏航正弦*俯仰正弦, 偏航餘弦*俯仰餘弦];
};
# Processing.套用矩陣使用欄優先矩陣；平移另行處理。
變數 旋轉矩陣 = 函式(四元數) {
    變數 橫向分量 = 四元數[0]; 變數 垂直分量 = 四元數[1]; 變數 縱向分量 = 四元數[2]; 變數 純量分量 = 四元數[3];
    回傳 [1-2*(垂直分量*垂直分量+縱向分量*縱向分量), 2*(橫向分量*垂直分量+縱向分量*純量分量), 2*(橫向分量*縱向分量-垂直分量*純量分量), 0,
          2*(橫向分量*垂直分量-縱向分量*純量分量), 1-2*(橫向分量*橫向分量+縱向分量*縱向分量), 2*(垂直分量*縱向分量+橫向分量*純量分量), 0,
          2*(橫向分量*縱向分量+垂直分量*純量分量), 2*(垂直分量*縱向分量-橫向分量*純量分量), 1-2*(橫向分量*橫向分量+垂直分量*垂直分量), 0,
          0, 0, 0, 1];
};
