變數 outerFunc = 函式(a, b) {
    變數 innerFunc = 函式(_a, _b) {
        迴圈 (變數 i = 0; i < 5; i+=2) {
            _a += i;
            _b += i;
        }
        回傳 _a + _b;
    }
    變數 result = innerFunc(a, b);
    印出("Result 1:", result);
    
    result += 10;
    
    回傳 result;
}

變數 result = outerFunc(12, 25);
印出("Result 2:", result);

result;
