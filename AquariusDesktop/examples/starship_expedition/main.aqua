##
星艦遠征：以質數作為航點，用費氏數列規劃航線。
展示目前語言的全部關鍵字、運算子、常值及結構語法。
執行方式請見同資料夾的 README.md。
##
變數 航行工具 = 匯入(目前工作目錄 + "/航行工具.aqua");
變數 任務名稱 = "水瓶號" + "星艦遠征";
任務名稱 += "：尋找質數星球";
印出(任務名稱);

# 巢狀迴圈及中斷：整數除法的商乘回除數，判斷是否整除。
變數 質數航點 = [];
變數 航點總和 = 0;
迴圈 (變數 候選 = 2; 候選 <= 30; 候選++) {
    變數 是質數 = 真;
    迴圈 (變數 除數 = 2; 除數 * 除數 <= 候選; ++除數) {
        如果 ((候選 / 除數) * 除數 == 候選) {
            是質數 = 假;
            中斷;
        }
    }
    如果 (是質數) {
        質數航點 = 加入(質數航點, 候選);
        航點總和 += 候選;
    }
}
印出("質數航點", 質數航點);
印出("航點總和", 航點總和);

# 模組函式呼叫、遞迴及匿名函式；航線可當成一般陣列處理。
變數 費氏航線 = 航行工具.建立航線(8);
變數 轉換航線 = 航行工具.取得航線轉換();
變數 平方航線 = 轉換航線(費氏航線, 函式(距離) { 距離 * 距離; });
印出("費氏航線", 費氏航線);
印出("平方航線", 平方航線);
印出("最後航點", 最後一個(費氏航線), "其餘航線", 其餘(費氏航線));

# 閉包保存能量，另一個閉包則保存訪問次數。
變數 消耗能量 = 航行工具.建立能量槽(20);
變數 評估能量 = 航行工具.取得能量評級();
變數 建立計數器 = 函式() {
    變數 次數 = 0;
    函式() { 回傳 ++次數; };
};
變數 訪問計數 = 建立計數器();
變數 能量紀錄 = [];
變數 剩餘能量 = 20;
迴圈 (變數 索引 = 0; 索引 < 長度(質數航點); 索引++) {
    剩餘能量 = 消耗能量(質數航點[索引]);
    能量紀錄 = 加入(能量紀錄, 剩餘能量);
    變數 評級 = 評估能量(剩餘能量);
    印出("探訪", 訪問計數(), "號星球", 質數航點[索引], "剩餘能量", 剩餘能量, 評級);
    如果 (剩餘能量 < 5) { 中斷; }
}

# 前置與後置遞增；識別字也能包含底線及數字。
變數 船艙_編號1 = 1;
變數 原編號 = 船艙_編號1++;
變數 新編號 = ++船艙_編號1;
印出("船艙編號", 原編號, 新編號, 船艙_編號1);

# 三種數值常值、括號優先順序、四則運算及所有複合指派。
變數 整數讀數 = (3 + 5) * 4 / 2 - 1;
整數讀數 = 整數讀數 + 1;
整數讀數 += 0.75d;
整數讀數 /= 2;
變數 單精度讀數 = 1.5f;
單精度讀數 += 0.5d;
單精度讀數 *= 2;
單精度讀數 /= 2;
變數 倍精度讀數 = 2.5d;
倍精度讀數 += 0.5f;
倍精度讀數 *= 2;
倍精度讀數 /= 4;
變數 溫度偏移 = -3;
印出("儀表讀數", 整數讀數, 單精度讀數, 倍精度讀數, "溫度偏移", 溫度偏移);

# 雜湊表支援字串、整數、單精度、倍精度及布林鍵，也能巢狀存放陣列。
變數 航行報告 = {"航點": 質數航點, "能量": 能量紀錄, "總和": 航點總和};
變數 讀數對照 = {1: "船艙", 1.5f: "單精度", 2.5d: "倍精度", 真: "安全", 假: "警戒"};
印出("首顆星球", 航行報告["航點"][0], "紀錄筆數", 長度(航行報告["能量"]));
印出("讀數對照", 讀數對照[1], 讀數對照[1.5f], 讀數對照[2.5d], 讀數對照[真], 讀數對照[假]);

# 如果也是運算式；邏輯否定、且、或及不等於。
變數 任務完成 = (!假 && (長度(質數航點) != 0)) || 假;
變數 結語 = 如果 (任務完成) { "帶著星圖平安返航"; } 否則 { "重新規劃航線"; };
印出(結語, "字數", 長度(結語));

# 回傳固定資料，方便單元測試同時檢查值及型別。
回傳 [質數航點, 費氏航線, 平方航線, 能量紀錄, 剩餘能量,
    整數讀數, 單精度讀數, 倍精度讀數, 原編號, 新編號, 任務完成];
