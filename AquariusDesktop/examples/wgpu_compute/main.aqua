# Headless GPU compute. Each invocation doubles one float in a storage buffer.
變數 GPU = 匯入("WGPU");
變數 裝置 = GPU.CreateDevice();
變數 資料 = 裝置.CreateBuffer([1, 2, 3, 4]);
變數 核心 = "@group(0) @binding(0) var<storage, read_write> data: array<f32>;
@compute @workgroup_size(1) fn cs_main(@builtin(global_invocation_id) id: vec3<u32>) {
    if (id.x < arrayLength(&data)) { data[id.x] *= 2.0; }
}";
裝置.Dispatch(核心, 資料, 4);
變數 結果 = 資料.Read();
印出("wgpu compute:", 裝置.Backend, 結果);
裝置.Dispose();
如果 (結果[0] != 2 || 結果[1] != 4 || 結果[2] != 6 || 結果[3] != 8) { GPU計算失敗; }
真;
