# Empty 迴圈 loop.
迴圈 (變數 i = 0; i < 5; i+=1) {
}

變數 a = "";
a = 函式() {
    迴圈 (變數 j = 0; j <= 10; j += 2) {
        a += "XD!";
        如果 (j == 4){
            a += "Wow!";
            回傳 a;
        }
    }
}();
印出(a);


變數 b = 0;
迴圈 (變數 j = 0; j <= 10; j += 2) {
    b -= 2;
    如果 (j == 8){
        b -= 10;
        中斷;
    }
}
印出(b);

b;