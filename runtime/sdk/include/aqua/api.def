/* Every function of aqua.h that an external native library reaches through the runtime's function table, in table
   order. The runtime fills the table (runtime/host/api.c) and aqua_api_stub.c forwards each declaration to it, so this
   list, aqua.h and both expansions are checked against each other by the compiler. Append new functions at the end and
   raise AQUA_API_VERSION; never reorder. Variadic functions travel as their va_list forms (aqua_vfail, aqua_vreject).
     AQUA_API(return type, name, (parameters), (arguments))   AQUA_API_VOID(name, (parameters), (arguments)) */
AQUA_API(const char *, aqua_type_name, (aqua_value v), (v))
