# Web: the pinned Clang targeting wasm32-wasip1 with the WASI sysroot. Every library and the host core build as
# position-independent side modules (dylink.0) that share the application's memory and import each other's symbols;
# web-glue/core/loader.mjs links them in the browser. C++ uses the sysroot's no-exceptions libc++.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
include("${CMAKE_CURRENT_LIST_DIR}/AquariusToolchain.cmake")
set(AQUA_TARGET web)
string(JSON AQUA_WASI_DIRECTORY GET "${AQUA_PINS}" sysroot directory)
set(AQUA_WASI_SYSROOT "${AQUA_TOOLCHAINS}/${AQUA_WASI_DIRECTORY}")

set(CMAKE_C_COMPILER "${AQUA_LLVM}/bin/clang${AQUA_EXE}")
set(CMAKE_CXX_COMPILER "${AQUA_LLVM}/bin/clang++${AQUA_EXE}")
set(CMAKE_AR "${AQUA_LLVM}/bin/llvm-ar${AQUA_EXE}" CACHE FILEPATH "")
set(CMAKE_RANLIB "${AQUA_LLVM}/bin/llvm-ranlib${AQUA_EXE}" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_SYSROOT "${AQUA_WASI_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "-fPIC -mcpu=lime1 -mbulk-memory -fvisibility=default")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -mcpu=lime1 -mbulk-memory -fno-exceptions -fvisibility=default")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-Wl,--experimental-pic -Wl,--no-entry -Wl,--allow-undefined -L${AQUA_WASI_SYSROOT}/lib/wasm32-wasip1/noeh")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
set(CMAKE_SHARED_LIBRARY_CREATE_C_FLAGS "-shared")
set(CMAKE_SHARED_LIBRARY_CREATE_CXX_FLAGS "-shared")
set(CMAKE_SHARED_LIBRARY_PREFIX "")
set(CMAKE_SHARED_LIBRARY_SUFFIX ".wasm")
set(CMAKE_EXECUTABLE_SUFFIX ".wasm")
set(CMAKE_FIND_ROOT_PATH "${AQUA_WASI_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
