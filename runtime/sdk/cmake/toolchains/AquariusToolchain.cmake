# Shared by every target toolchain file: reads the pins in scripts/toolchain.json and locates the installed toolchain
# (scripts/install-toolchain.ps1|.sh). Set AQUARIUS_NATIVE_BUILD to move .native-build, AQUARIUS_LLVM to use another
# installation of the pinned LLVM release, and AQUARIUS_SDK_ROOT when this SDK is used outside the repository.
cmake_minimum_required(VERSION 3.20)
get_filename_component(AQUA_SDK "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(DEFINED ENV{AQUARIUS_SDK_ROOT})
    file(TO_CMAKE_PATH "$ENV{AQUARIUS_SDK_ROOT}" AQUA_REPOSITORY)
else()
    get_filename_component(AQUA_REPOSITORY "${AQUA_SDK}/../.." ABSOLUTE)
endif()
file(READ "${AQUA_REPOSITORY}/scripts/toolchain.json" AQUA_PINS)
if(DEFINED ENV{AQUARIUS_NATIVE_BUILD})
    file(TO_CMAKE_PATH "$ENV{AQUARIUS_NATIVE_BUILD}" AQUA_NATIVE_BUILD)
else()
    set(AQUA_NATIVE_BUILD "${AQUA_REPOSITORY}/.native-build")
endif()
set(AQUA_TOOLCHAINS "${AQUA_NATIVE_BUILD}/toolchains")

if(CMAKE_HOST_WIN32)
    set(AQUA_HOST windows-x64)
    set(AQUA_EXE .exe)
    set(AQUA_SCRIPT .bat)   # SDK tools shipped as scripts (d8, apksigner)
elseif(CMAKE_HOST_APPLE)
    set(AQUA_HOST macos-arm64)
    set(AQUA_EXE "")
    set(AQUA_SCRIPT "")
else()
    set(AQUA_HOST linux-x64)
    set(AQUA_EXE "")
    set(AQUA_SCRIPT "")
endif()
string(JSON AQUA_LLVM_VERSION GET "${AQUA_PINS}" llvm version)
string(JSON AQUA_LLVM_DIRECTORY GET "${AQUA_PINS}" llvm directory)
string(REPLACE "{platform}" "${AQUA_HOST}" AQUA_LLVM_DIRECTORY "${AQUA_LLVM_DIRECTORY}")
if(DEFINED ENV{AQUARIUS_LLVM})
    file(TO_CMAKE_PATH "$ENV{AQUARIUS_LLVM}" AQUA_LLVM)
else()
    set(AQUA_LLVM "${AQUA_TOOLCHAINS}/${AQUA_LLVM_DIRECTORY}")
endif()
if(NOT EXISTS "${AQUA_LLVM}/bin/clang${AQUA_EXE}")
    message(FATAL_ERROR "Pinned Clang ${AQUA_LLVM_VERSION} not found at ${AQUA_LLVM}. Run scripts/install-toolchain.ps1 (or .sh).")
endif()

# The unpacked directory of a pinned SDK (wasmtime) for this target.
function(aqua_sdk_directory name target out)
    string(JSON version GET "${AQUA_PINS}" sdks ${name} version)
    set(${out} "${AQUA_NATIVE_BUILD}/sdk/${name}-${version}-${target}" PARENT_SCOPE)
endfunction()

set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AQUA_TARGET)
list(APPEND CMAKE_MODULE_PATH "${AQUA_SDK}/cmake")
