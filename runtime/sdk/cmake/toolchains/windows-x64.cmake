# Windows x64: the pinned Clang targeting x86_64-w64-mingw32 against the llvm-mingw sysroot (UCRT, libc++,
# libunwind, compiler-rt), linked by lld with the C++ runtime static. No MSVC tools or runtime are involved.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
include("${CMAKE_CURRENT_LIST_DIR}/AquariusToolchain.cmake")
set(AQUA_TARGET windows-x64)
string(JSON AQUA_MINGW_DIRECTORY GET "${AQUA_PINS}" mingw directory)
set(AQUA_MINGW "${AQUA_TOOLCHAINS}/${AQUA_MINGW_DIRECTORY}")
if(NOT EXISTS "${AQUA_MINGW}/x86_64-w64-mingw32")
    message(FATAL_ERROR "MinGW sysroot not found at ${AQUA_MINGW}. Run scripts/install-toolchain.ps1 -Targets windows-x64.")
endif()
file(GLOB AQUA_MINGW_RESOURCE "${AQUA_MINGW}/lib/clang/*")
list(GET AQUA_MINGW_RESOURCE 0 AQUA_MINGW_RESOURCE)

set(CMAKE_C_COMPILER "${AQUA_LLVM}/bin/clang${AQUA_EXE}")
set(CMAKE_CXX_COMPILER "${AQUA_LLVM}/bin/clang++${AQUA_EXE}")
set(CMAKE_RC_COMPILER "${AQUA_LLVM}/bin/llvm-rc${AQUA_EXE}")
set(CMAKE_AR "${AQUA_LLVM}/bin/llvm-ar${AQUA_EXE}" CACHE FILEPATH "")
set(CMAKE_RANLIB "${AQUA_LLVM}/bin/llvm-ranlib${AQUA_EXE}" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET x86_64-w64-mingw32)
set(CMAKE_CXX_COMPILER_TARGET x86_64-w64-mingw32)
set(CMAKE_SYSROOT "${AQUA_MINGW}")
set(AQUA_MINGW_FLAGS "-resource-dir \"${AQUA_MINGW_RESOURCE}\"")
set(CMAKE_C_FLAGS_INIT "${AQUA_MINGW_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${AQUA_MINGW_FLAGS} -stdlib=libc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -rtlib=compiler-rt -unwindlib=libunwind -static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -rtlib=compiler-rt -unwindlib=libunwind -static-libgcc -Wl,-Bstatic -lc++ -lunwind -Wl,-Bdynamic")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${CMAKE_SHARED_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${AQUA_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
