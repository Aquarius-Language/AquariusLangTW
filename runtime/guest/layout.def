/* The guest memory layout: the one table shared by runtime.c (checked by layout.h), the native host (runtime/host) and
   the C# Wasm emitters (compiler/AquariusCompiler/wasm/RuntimeLayout.cs parses these lines). Change a struct in runtime.c
   and this table together; the runtime build fails if they disagree. One entry per line:
     AQUA_FIELD(struct, c_field, Name, offset)   AQUA_SIZE(struct, bytes)   AQUA_TAG(C_ENUM, Name, value)   AQUA_STATUS(Name, value) */
AQUA_FIELD(Value, tag, Tag, 0)
AQUA_FIELD(Value, ref, Ref, 4)
AQUA_FIELD(Value, number, Number, 8)
AQUA_SIZE(Value, 16)
AQUA_FIELD(Text, length, Length, 0)
AQUA_FIELD(Text, data, Data, 4)
AQUA_FIELD(Binding, name, Name, 0)
