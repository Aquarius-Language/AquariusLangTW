# The iOS runtime (runtime/CMakeLists.txt includes it for AQUA_OS ios): iOS applications carry no loose shared libraries
# and generate no machine code, so the pack is one static library, libaquarius.a (the host core with the ahead-of-time
# engine, this layer and every default library, with their third-party archives), the frameworks it needs
# (frameworks.txt) and the project aqua build --target ios links each application with (app/: the application's
# wasm2c translation, aot_app.c and the wasm2c runtime, linked into the application's executable).
enable_language(OBJC)
add_library(aquarius_core STATIC ${host_sources} host/engine_aot.c host/overlay.c host/sha256.c host/threads.c
    platform/ios/platform.c platform/ios/window.m platform/posix/posix.c)
target_include_directories(aquarius_core PRIVATE sdk/include "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_compile_definitions(aquarius_core PRIVATE AQUA_HAS_DEFAULT_LIBRARIES)
set_source_files_properties(platform/ios/window.m PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
set(ios_frameworks UIKit Foundation QuartzCore Metal CoreFoundation CoreGraphics CoreText IOSurface Security)
foreach(name IN LISTS default_libraries)
    target_link_libraries(aquarius_core PRIVATE aqua_${name})
endforeach()

# Every static archive the runtime and its libraries link (targets and pinned prebuilt archives), and the frameworks they
# name, gathered from the link interfaces.
set(ios_archives "$<TARGET_FILE:aquarius_core>")
set(ios_visited "")
function(ios_collect item)
    if(TARGET "${item}")
        get_target_property(aliased "${item}" ALIASED_TARGET)
        if(aliased)
            set(item "${aliased}")
        endif()
        if(item IN_LIST ios_visited)
            return()
        endif()
        list(APPEND ios_visited "${item}")
        set(ios_visited "${ios_visited}" PARENT_SCOPE)
        get_target_property(type "${item}" TYPE)
        if(type STREQUAL "STATIC_LIBRARY")
            list(APPEND ios_archives "$<TARGET_FILE:${item}>")
        endif()
        set(links "")
        foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(value "${item}" ${property})
            if(value)
                list(APPEND links ${value})
            endif()
        endforeach()
        foreach(link IN LISTS links)
            string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" link "${link}")
            ios_collect("${link}")
        endforeach()
    elseif(item MATCHES "\\.a$")
        list(APPEND ios_archives "${item}")
    elseif(item MATCHES "^-framework (.+)$")
        list(APPEND ios_frameworks "${CMAKE_MATCH_1}")
    endif()
    set(ios_archives "${ios_archives}" PARENT_SCOPE)
    set(ios_frameworks "${ios_frameworks}" PARENT_SCOPE)
endfunction()
foreach(name IN LISTS default_libraries)
    ios_collect(aqua_${name})
endforeach()
list(REMOVE_DUPLICATES ios_archives)
list(REMOVE_DUPLICATES ios_frameworks)
add_custom_command(OUTPUT libaquarius.a
    COMMAND xcrun libtool -static -no_warning_for_no_symbols -o libaquarius.a ${ios_archives}
    DEPENDS aquarius_core ${ios_archives} COMMAND_EXPAND_LISTS VERBATIM)
add_custom_target(aquarius_bundle ALL DEPENDS libaquarius.a)
string(REPLACE ";" "\n" ios_framework_lines "${ios_frameworks}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/frameworks.txt" "${ios_framework_lines}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/libaquarius.a" "${CMAKE_CURRENT_BINARY_DIR}/frameworks.txt" DESTINATION .)
install(FILES platform/ios/app/CMakeLists.txt aot/aot_app.c aot/aot_app.h host/guest_exports.h DESTINATION app)
