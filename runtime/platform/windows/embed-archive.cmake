# The static archive of a Windows native library output (embed.cmake runs it with cmake -P):
#   OBJECTS   a file listing the library's own objects       ARCHIVES  the archives it links, separated by |
#   SYMBOLS   the exported names (one per line), kept         PREFIX    the library's symbol prefix
#   OUTPUT    the archive to write    LLVM, EXE  the pinned LLVM's bin folder and program suffix    WORK  a scratch folder
# Every object of the archives is extracted; every symbol an object defines, except the exported ones, is renamed to
# <PREFIX>aqua_<name> in every object (references included), so the archive's internals cannot clash with another
# library's or the program's.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(STRINGS "${OBJECTS}" objects)
file(STRINGS "${SYMBOLS}" exported)
string(REPLACE "|" ";" archives "${ARCHIVES}")
set(index 0)
foreach(archive IN LISTS archives)
    math(EXPR index "${index} + 1")
    set(folder "${WORK}/archive${index}")
    file(MAKE_DIRECTORY "${folder}")
    # An archive may hold several members of one name (embed.c of two folders): each instance is extracted on its own
    # (llvm-ar's N modifier) and every object gets a unique file name.
    execute_process(COMMAND "${LLVM}/llvm-ar${EXE}" t "${archive}" OUTPUT_VARIABLE listing COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" members "${listing}")
    list(FILTER members EXCLUDE REGEX "^$")
    set(seen "")
    set(member_index 0)
    foreach(member IN LISTS members)
        math(EXPR member_index "${member_index} + 1")
        set(instance 1)
        foreach(previous IN LISTS seen)
            if(previous STREQUAL member)
                math(EXPR instance "${instance} + 1")
            endif()
        endforeach()
        list(APPEND seen "${member}")
        execute_process(COMMAND "${LLVM}/llvm-ar${EXE}" xN ${instance} "${archive}" "${member}" WORKING_DIRECTORY "${folder}" COMMAND_ERROR_IS_FATAL ANY)
        get_filename_component(name "${member}" NAME)
        file(RENAME "${folder}/${name}" "${WORK}/a${index}_${member_index}_${name}")
        list(APPEND objects "${WORK}/a${index}_${member_index}_${name}")
    endforeach()
endforeach()
# Response files keep the command lines short.
string(REPLACE ";" "\n" lines "${objects}")
file(WRITE "${WORK}/objects.rsp" "${lines}\n")
execute_process(COMMAND "${LLVM}/llvm-nm${EXE}" --defined-only --extern-only --format=just-symbols "@${WORK}/objects.rsp"
    OUTPUT_VARIABLE defined COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" defined "${defined}")
list(FILTER defined EXCLUDE REGEX "^$|:$")
list(REMOVE_DUPLICATES defined)
list(REMOVE_ITEM defined ${exported})
set(map "")
foreach(symbol IN LISTS defined)
    string(APPEND map "${symbol} ${PREFIX}aqua_${symbol}\n")
endforeach()
file(WRITE "${WORK}/rename.txt" "${map}")
set(renamed "")
set(index 0)
foreach(object IN LISTS objects)
    math(EXPR index "${index} + 1")
    get_filename_component(name "${object}" NAME_WE)
    set(output "${WORK}/o${index}_${name}.o")
    execute_process(COMMAND "${LLVM}/llvm-objcopy${EXE}" "--redefine-syms=${WORK}/rename.txt" "${object}" "${output}" COMMAND_ERROR_IS_FATAL ANY)
    list(APPEND renamed "${output}")
endforeach()
file(REMOVE "${OUTPUT}")
string(REPLACE ";" "\n" lines "${renamed}")
file(WRITE "${WORK}/renamed.rsp" "${lines}\n")
execute_process(COMMAND "${LLVM}/llvm-ar${EXE}" rcs "${OUTPUT}" "@${WORK}/renamed.rsp" COMMAND_ERROR_IS_FATAL ANY)
