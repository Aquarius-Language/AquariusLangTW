# The embed runtime of native library outputs (docs/native-libraries.md), included by runtime/CMakeLists.txt for a
# platform whose layer has an embed.cmake. It builds the host core with the ahead-of-time engine linked in (AQUA_EMBED),
# the layer's sources (embed_platform_sources: its platform.cmake or the shared desktop one sets them) and no window
# system into embed/libaquarius_embed.a, position independent with hidden symbols, and installs beside it what aqua
# build compiles each library with: CMakeLists.txt (the library project), exports.c, aqua/embed.h, the ahead-of-time
# glue and the layer's link rules as platform.cmake. Every default library that needs no window system (its aqua.toml
# has no `window = true` under [native]) installs its link interface as embed/libraries/<name>/: its archives,
# link.cmake (which embed/CMakeLists.txt includes), its runtime files (AQUA_RUNTIME_FILES) and its licenses
# (AQUA_LICENSE_FILES: "folder|file" entries), the target properties a library sets for them.
add_library(aquarius_embed STATIC ${host_sources} host/engine_aot.c host/sha256.c host/threads.c ${embed_platform_sources}
    embed/embed.c embed/no_window.c)
target_include_directories(aquarius_embed PRIVATE sdk/include)
target_compile_definitions(aquarius_embed PRIVATE AQUA_EMBED)
set_target_properties(aquarius_embed PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
install(TARGETS aquarius_embed ARCHIVE DESTINATION embed)
install(FILES embed/CMakeLists.txt embed/exports.c aot/aot_app.c aot/aot_app.h host/guest_exports.h DESTINATION embed)
install(FILES embed/aqua/embed.h DESTINATION embed/aqua)
install(FILES "platform/${AQUA_OS}/embed.cmake" DESTINATION embed RENAME platform.cmake)
file(GLOB embed_platform_scripts "${CMAKE_CURRENT_SOURCE_DIR}/platform/${AQUA_OS}/embed-*.cmake")
install(FILES ${embed_platform_scripts} DESTINATION embed)

# Walks a target's link interface: the static targets it builds (embed_targets), prebuilt archives and import
# libraries (embed_files), system libraries by name (embed_system), and whether any of its code is C++ (embed_cxx).
function(embed_collect item)
    if(TARGET "${item}")
        get_target_property(aliased "${item}" ALIASED_TARGET)
        if(aliased)
            set(item "${aliased}")
        endif()
        if(item IN_LIST embed_seen)
            return()
        endif()
        list(APPEND embed_seen "${item}")
        get_target_property(type "${item}" TYPE)
        get_target_property(imported "${item}" IMPORTED)
        if(type STREQUAL "STATIC_LIBRARY" AND NOT imported)
            list(APPEND embed_targets "${item}")
            get_target_property(sources "${item}" SOURCES)
            if(sources MATCHES "\\.(cc|cpp|cxx)(;|$)")
                set(embed_cxx ON)
            endif()
        elseif(imported AND type MATCHES "STATIC_LIBRARY|SHARED_LIBRARY|UNKNOWN_LIBRARY")
            foreach(property IN ITEMS IMPORTED_IMPLIB IMPORTED_LOCATION IMPORTED_IMPLIB_RELEASE IMPORTED_LOCATION_RELEASE)
                get_target_property(file "${item}" ${property})
                if(file)
                    list(APPEND embed_files "${file}")
                    break()
                endif()
            endforeach()
        endif()
        set(links "")
        foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            if(property STREQUAL "LINK_LIBRARIES" AND (imported OR type STREQUAL "INTERFACE_LIBRARY"))
                continue()
            endif()
            get_target_property(value "${item}" ${property})
            if(value)
                list(APPEND links ${value})
            endif()
        endforeach()
        foreach(link IN LISTS links)
            string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" link "${link}")
            if(link MATCHES "^\\$<")
                continue()
            endif()
            embed_collect("${link}")
        endforeach()
    elseif(item MATCHES "^-")
        list(APPEND embed_system "${item}")   # a linker flag such as -l:libwinpthread.a
    elseif(IS_ABSOLUTE "${item}" AND item MATCHES "\\.(a|lib)$")
        list(APPEND embed_files "${item}")
    elseif(item MATCHES "^[A-Za-z0-9_+.-]+$" AND NOT item MATCHES "::")
        list(APPEND embed_system "${item}")
    endif()
    foreach(variable IN ITEMS embed_seen embed_targets embed_files embed_system embed_cxx)
        set(${variable} "${${variable}}" PARENT_SCOPE)
    endforeach()
endfunction()

foreach(name IN LISTS default_libraries)
    file(READ "${AQUA_LIBRARY_ROOT}/${name}/aqua.toml" embed_manifest)
    if(embed_manifest MATCHES "\n[ \t]*window[ \t]*=[ \t]*true")
        continue()
    endif()
    set(embed_seen "")
    set(embed_targets "")
    set(embed_files "")
    set(embed_system "")
    set(embed_cxx OFF)
    embed_collect(aqua_${name})
    list(REMOVE_DUPLICATES embed_files)
    list(REMOVE_DUPLICATES embed_system)
    set(destination embed/libraries/${name})
    set(archives "")
    foreach(target IN LISTS embed_targets)
        install(FILES "$<TARGET_FILE:${target}>" DESTINATION ${destination})
        string(APPEND archives " \"\${CMAKE_CURRENT_LIST_DIR}/$<TARGET_FILE_NAME:${target}>\"")
    endforeach()
    foreach(file IN LISTS embed_files)
        install(FILES "${file}" DESTINATION ${destination})
        get_filename_component(file_name "${file}" NAME)
        string(APPEND archives " \"\${CMAKE_CURRENT_LIST_DIR}/${file_name}\"")
    endforeach()
    set(runtime "")
    get_target_property(runtime_files aqua_${name} AQUA_RUNTIME_FILES)
    if(runtime_files)
        install(FILES ${runtime_files} DESTINATION ${destination}/runtime)
        foreach(file IN LISTS runtime_files)
            get_filename_component(file_name "${file}" NAME)
            string(APPEND runtime " \"\${CMAKE_CURRENT_LIST_DIR}/runtime/${file_name}\"")
        endforeach()
    endif()
    get_target_property(license_files aqua_${name} AQUA_LICENSE_FILES)
    if(license_files)
        foreach(entry IN LISTS license_files)
            string(REPLACE "|" ";" entry "${entry}")
            list(GET entry 0 folder)
            list(GET entry 1 file)
            install(FILES "${file}" DESTINATION ${destination}/licenses/${folder})
        endforeach()
    endif()
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/embed/${name}/link.cmake" CONTENT
"# The link interface of the ${name} library for native library outputs (runtime/embed/runtime.cmake).
set(embed_library_archives${archives})
set(embed_library_system \"${embed_system}\")
set(embed_library_cxx ${embed_cxx})
set(embed_library_runtime${runtime})
set(embed_library_licenses \"\${CMAKE_CURRENT_LIST_DIR}/licenses\")
")
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/embed/${name}/link.cmake" DESTINATION ${destination})
endforeach()
